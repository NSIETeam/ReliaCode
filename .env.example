# Copy to .env only for local development. Production values belong in a secret manager.
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:4173
DATABASE_URL=postgres://reliacode:change-me@localhost:5432/reliacode
# In containers, prefer DATABASE_URL_FILE=/run/secrets/database_url.
DATABASE_SSL=false
AUTH_MODE=development
ALLOW_PUBLIC_REGISTRATION=true
ENABLE_LEGACY_SYNC_CODE_GENERATION=true
REQUIRE_DEVICE_AUTHORIZATION=false
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_AUDIENCE=reliacode-api
CORS_ORIGINS=http://localhost:4173
OPEN_EPCIS_BASE_URL=http://localhost:8080
GS1_DIGITAL_LINK_BASE_URL=http://localhost:4173
WEBAUTHN_RP_NAME=ReliaCode
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4173
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
SESSION_ROTATION_MINUTES=15
PASSKEY_STEP_UP_MINUTES=10
SESSION_FINGERPRINT_KEY=replace-with-a-base64url-encoded-32-byte-key
SMTP_URL=smtps://user:password@smtp.example.cn:465
EMAIL_FROM=ReliaCode <no-reply@example.cn>
ACCOUNT_RECOVERY_BASE_URL=http://localhost:4173/
OBJECT_STORAGE_ENDPOINT=https://s3.example.cn
OBJECT_STORAGE_REGION=cn-north-1
OBJECT_STORAGE_BUCKET=reliacode-production-exports
OBJECT_STORAGE_ACCESS_KEY_ID=replace-for-local-development
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-for-local-development
OBJECT_STORAGE_FORCE_PATH_STYLE=false
