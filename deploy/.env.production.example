# Copy to deploy/.env only on the target host. Never commit the real file.
RELIACODE_API_IMAGE=ghcr.io/nsieteam/reliacode-api:latest
RELIACODE_WEB_IMAGE=ghcr.io/nsieteam/reliacode-web:latest
WEB_PORT=4173
REQUIRE_DEVICE_AUTHORIZATION=true
PUBLIC_ORIGIN=https://reliacode.example
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_AUDIENCE=reliacode-api
OPEN_EPCIS_BASE_URL=https://epcis.example.com/
GS1_DIGITAL_LINK_BASE_URL=https://id.reliacode.example
WEBAUTHN_RP_ID=reliacode.example
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters
WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
SESSION_ROTATION_MINUTES=15
PASSKEY_STEP_UP_MINUTES=10
SESSION_FINGERPRINT_KEY=replace-with-a-base64url-encoded-32-byte-key
EMAIL_FROM=ReliaCode <no-reply@reliacode.example>
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_REGION=cn-north-1
OBJECT_STORAGE_BUCKET=reliacode-production-exports
OBJECT_STORAGE_FORCE_PATH_STYLE=false
