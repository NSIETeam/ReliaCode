<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>我的 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'me' }) %>

  <div class="container">
    <div class="page-header">
      <h1>我的</h1>
      <p>账号管理与系统设置</p>
    </div>

    <% const roleText2 = { admin: '平台管理员', brand: '品牌管理员', brand_staff: '品牌工作账号', factory: '工厂', warehouse: '品牌方', distributor: '代理商' }; %>

    <!-- 用户卡片 -->
    <div class="me-card">
      <span class="me-avatar"><%= (user.display_name || user.username).slice(0,1).toUpperCase() %></span>
      <div>
        <div class="me-name"><%= user.display_name %></div>
        <div class="me-meta">@<%= user.username %> · <%= roleText2[user.role] || user.role %></div>
      </div>
    </div>

    <!-- 主功能 -->
    <div class="menu-list">
      <a href="/profile" class="menu-item">
        <span class="mi-icon"><%- icon('lock') %></span>
        <span class="mi-body"><span class="mi-title">修改密码</span></span>
        <span class="mi-chevron">›</span>
      </a>
      <% if (user.role === 'admin' || user.role === 'brand') { %><a href="/users" class="menu-item">
        <span class="mi-icon"><%- icon('user') %></span>
        <span class="mi-body"><span class="mi-title">账号管理</span></span>
        <span class="mi-chevron">›</span>
      </a><% } %>
      <a href="/logs" class="menu-item">
        <span class="mi-icon"><%- icon('clipboard') %></span>
        <span class="mi-body"><span class="mi-title">扫码日志</span></span>
        <span class="mi-chevron">›</span>
      </a>
      <a href="/alerts" class="menu-item">
        <span class="mi-icon"><%- icon('bell') %></span>
        <span class="mi-body"><span class="mi-title">预警中心</span></span>
        <% if (alertsUnread > 0) { %><span class="tag tag-red" style="margin-right:6px;"><%= alertsUnread %></span><% } %>
        <span class="mi-chevron">›</span>
      </a>
      <% if (user.role === 'admin') { %>
      <a href="/settings" class="menu-item">
        <span class="mi-icon"><%- icon('settings') %></span>
        <span class="mi-body"><span class="mi-title">品牌营销</span></span>
        <span class="mi-chevron">›</span>
      </a>
      <% } %>
    </div>

    <div class="menu-list" style="margin-top:16px;">
      <a href="/logout" class="menu-item" style="justify-content:center;">
        <span class="mi-title" style="text-align:center;color:#ff3b30;">退出登录</span>
      </a>
    </div>
  </div>
</body>
</html>
