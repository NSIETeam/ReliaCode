<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>码生成 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'generate' }) %>

  <div class="container">
    <!-- 产品管理 -->
    <div class="card">
      <div class="card-title">产品管理</div>
      <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;">
        <input type="text" id="pName" class="form-control" placeholder="产品名称" style="flex:1;min-width:150px;">
        <input type="text" id="pSpec" class="form-control" placeholder="规格（选填）" style="flex:1;min-width:120px;">
        <input type="text" id="pBatch" class="form-control" placeholder="批次号（选填）" style="flex:1;min-width:120px;">
        <input type="number" id="pBoxSize" class="form-control" placeholder="箱规（选填）" style="flex:1;min-width:110px;" min="1">
        <select id="pFactory" class="form-control" style="flex:1;min-width:130px;">
          <option value="">归属工厂（总部）</option>
          <% factories.forEach(f => { %>
            <option value="<%= f.id %>"><%= f.name %></option>
          <% }); %>
        </select>
        <% if (user && user.role === 'admin') { %>
        <select id="pBrand" class="form-control" style="flex:1;min-width:130px;">
          <option value="">归属品牌（总部自有）</option>
          <% brands.forEach(b => { %>
            <option value="<%= b.id %>"><%= b.name %></option>
          <% }); %>
        </select>
        <% } %>
        <button class="btn btn-primary" onclick="addProduct()">添加产品</button>
      </div>
      <p style="color:#999;font-size:12px;margin-bottom:10px;">箱规 = 每箱装几个（如8），工厂装箱时自动带出，装箱页可临时修改；归属工厂仅作管理参考（不影响码归属）<% if (user && user.role === 'admin') { %>；多品牌模式下请为产品选择归属品牌（选了工厂时以工厂所属品牌为准）<% } %></p>
      <div class="table-wrap">
      <table class="table" id="productTable">
        <thead>
          <tr><th>产品名称</th><th class="col-sm-hide">规格</th><th class="col-sm-hide">批次</th><th>箱规</th><th class="col-sm-hide">归属工厂</th><% if (user && user.role === 'admin') { %><th class="col-sm-hide">归属品牌</th><% } %><th class="col-sm-hide">创建时间</th><th style="width:90px;">操作</th></tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
          <tr>
            <td><%= p.name %></td>
            <td class="col-sm-hide"><%= p.spec || '-' %></td>
            <td class="col-sm-hide"><%= p.batch_no || '-' %></td>
            <td><%= p.box_size ? p.box_size + ' 个/箱' : '-' %></td>
            <td class="col-sm-hide"><%= p.factory_name || '总部' %></td>
            <% if (user && user.role === 'admin') { %><td class="col-sm-hide"><%= p.brand_name || '-' %></td><% } %>
            <td class="col-sm-hide" style="font-size:12px;color:#666;"><%= p.created_at %></td>
            <td><button class="btn btn-outline btn-sm" style="color:#ea4335;border-color:#ea4335;" onclick="deleteProduct('<%= p.id %>','<%= p.name %>')">删除</button></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>

    <!-- 生成箱码 -->
    <div class="card">
      <div class="card-title">① 生成箱码（父码）</div>
      <p style="color:#666;font-size:13px;margin-bottom:12px;">生成后打印箱码标签，随子码标签一起发往生产工厂。<strong>产品可不选</strong>：不选=空白箱码，工厂装箱扫箱码时再选产品+箱规，更灵活</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;">
        <div class="form-group">
          <label>选择产品（选填）</label>
          <select id="boxProduct" class="form-control">
            <option value="">不选（装箱时再定）</option>
            <% products.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %> <% if(p.spec) { %>(<%= p.spec %>)<% } %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label>批次号（选填）</label>
          <input type="text" id="boxBatch" class="form-control" placeholder="如：20260814">
        </div>
        <div class="form-group">
          <label>箱数</label>
          <input type="number" id="boxCount" class="form-control" value="1" min="1">
        </div>
      </div>
      <button class="btn btn-primary" onclick="genBoxes()">生成箱码</button>
      <span id="boxGenStatus" style="margin-left:12px;color:#666;"></span>
    </div>

    <!-- 生成子码 -->
    <div class="card">
      <div class="card-title">② 生成子码</div>
      <p style="color:#666;font-size:13px;margin-bottom:12px;">生成后打印子码标签发给工厂。<strong>产品可不选</strong>：不选=空白子码，装箱扫码时自动跟随箱码产品</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;">
        <div class="form-group">
          <label>选择产品（选填）</label>
          <select id="itemProduct" class="form-control">
            <option value="">不选（装箱时再定）</option>
            <% products.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %> <% if(p.spec) { %>(<%= p.spec %>)<% } %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label>批次号（选填）</label>
          <input type="text" id="itemBatch" class="form-control" placeholder="如：20260814">
        </div>
        <div class="form-group">
          <label>数量</label>
          <input type="number" id="itemCount" class="form-control" value="8" min="1">
        </div>
      </div>
      <button class="btn btn-primary" onclick="genItems()">生成子码</button>
      <span id="itemGenStatus" style="margin-left:12px;color:#666;"></span>
    </div>

    <!-- 生成结果 -->
    <div id="resultArea" style="display:none;">
      <div class="card">
        <div class="card-title">生成结果 <span id="resultCount"></span></div>
        <div style="margin-bottom:12px;">
          <button class="btn btn-primary btn-sm" onclick="printLabels()"><%- icon('tag') %> 打印标签</button>
          <button class="btn btn-outline btn-sm" onclick="window.print()">打印本页</button>
          <button class="btn btn-outline btn-sm" onclick="downloadAll()">下载全部二维码</button>
        </div>
        <div id="codeList"></div>
      </div>
    </div>
  </div>

  <script src="/js/scanner.js"></script>
  <script>
    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }

    // 产品
    async function addProduct() {
      const name = document.getElementById('pName').value.trim();
      const spec = document.getElementById('pSpec').value.trim();
      const batch = document.getElementById('pBatch').value.trim();
      const boxSize = parseInt(document.getElementById('pBoxSize').value) || 0;
      const factory_id = parseInt(document.getElementById('pFactory').value) || null;
      const brandSel = document.getElementById('pBrand');
      const brand_id = brandSel ? (parseInt(brandSel.value) || null) : null;
      if (!name) return toast('请输入产品名称', 'error');
      const res = await fetch('/api/products', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({name, spec, batch_no: batch, box_size: boxSize, factory_id, brand_id})
      });
      const data = await res.json();
      if (data.success) { toast('产品添加成功'); setTimeout(()=>location.reload(), 800); }
      else { toast(data.msg || '添加失败', 'error'); }
    }

    async function deleteProduct(id, name) {
      if (!confirm('确定要删除产品「' + name + '」吗？\n\n仅在该产品下没有任何箱码/子码时才可删除，否则请先到「码查询」删除/作废相关码。')) return;
      const res = await fetch('/api/products/' + id, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) { toast(data.msg); setTimeout(() => location.reload(), 600); }
      else toast(data.msg, 'error');
    }

    // 生成箱码（产品可选：不选=空白箱码）
    async function genBoxes() {
      const product_id = document.getElementById('boxProduct').value;
      const batch_no = document.getElementById('boxBatch').value.trim();
      const box_count = document.getElementById('boxCount').value;
      document.getElementById('boxGenStatus').textContent = '正在生成...';
      const res = await fetch('/api/codes/generate/boxes', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({product_id: product_id || null, batch_no, box_count})
      });
      const data = await res.json();
      document.getElementById('boxGenStatus').textContent = '';
      if (!data.success) return toast(data.msg || '生成失败', 'error');
      toast(`成功生成 ${data.count} 个箱码${product_id ? '' : '（空白码，装箱时再选产品）'}`);
      showResult(data.generated);
    }

    // 生成子码（产品可选：不选=空白子码）
    async function genItems() {
      const product_id = document.getElementById('itemProduct').value;
      const batch_no = document.getElementById('itemBatch').value.trim();
      const item_count = document.getElementById('itemCount').value;
      document.getElementById('itemGenStatus').textContent = '正在生成...';
      const res = await fetch('/api/codes/generate/items', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({product_id: product_id || null, batch_no, item_count})
      });
      const data = await res.json();
      document.getElementById('itemGenStatus').textContent = '';
      if (!data.success) return toast(data.msg || '生成失败', 'error');
      toast(`成功生成 ${data.count} 个子码${product_id ? '' : '（空白码，装箱时跟随箱码产品）'}`);
      showResult(data.generated);
    }

    // 显示生成结果
    let lastCodes = [];
    function showResult(codes) {
      lastCodes = codes;
      const area = document.getElementById('resultArea');
      const list = document.getElementById('codeList');
      area.style.display = 'block';
      document.getElementById('resultCount').textContent = `（${codes.length}个）`;
      list.innerHTML = `
        <div class="code-list">
          ${codes.map(c => `
            <div class="code-item">
              <img src="${c.qr_url}" alt="码">
              <div class="code-text">${c.box_code || c.item_code}</div>
              <div style="font-size:11px;color:#1a73e8;margin-top:2px;">${c.box_code ? '箱码' : '子码'}</div>
            </div>
          `).join('')}
        </div>
      `;
      area.scrollIntoView({behavior:'smooth'});
    }

    // 跳转标签打印页（A4网格，可适配贴纸）
    function printLabels() {
      if (!lastCodes.length) return toast('没有可打印的码', 'error');
      const type = lastCodes[0].box_code ? 'box' : 'item';
      const codes = lastCodes.map(c => c.box_code || c.item_code).join(',');
      const boxSel = document.getElementById('boxProduct');
      const itemSel = document.getElementById('itemProduct');
      const product = (boxSel && boxSel.selectedOptions[0] ? boxSel.selectedOptions[0].text : '') ||
                      (itemSel && itemSel.selectedOptions[0] ? itemSel.selectedOptions[0].text : '');
      window.open(`/print?codes=${codes}&type=${type}&product=${encodeURIComponent(product)}`, '_blank');
    }
  </script>
</body>
</html>
