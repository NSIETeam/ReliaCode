<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>码查询 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'codes' }) %>

  <div class="container">
    <div class="card">
      <div class="card-title">码查询</div>
      <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;align-items:center;">
        <div class="form-group" style="flex:1;min-width:200px;margin-bottom:0;">
          <input type="text" id="searchKeyword" class="form-control" placeholder="输入箱码或子码搜索">
        </div>
        <div>
          <label style="font-size:14px;margin-right:8px;">
            <input type="radio" name="codeType" value="box" checked> 箱码
            <input type="radio" name="codeType" value="item" style="margin-left:8px;"> 子码
          </label>
        </div>
        <select id="statusFilter" class="form-control" style="width:auto;min-width:120px;">
          <option value="">全部状态</option>
          <option value="in_stock">在库</option>
          <option value="shipped">已发货</option>
          <option value="scanned">已扫码</option>
          <option value="invalid">已作废</option>
        </select>
        <button class="btn btn-primary" onclick="search(1)">搜索</button>
        <button class="btn btn-outline" onclick="downloadPackage()"><%- icon('box') %> 下载码包</button>
        <button class="btn btn-outline" onclick="openPrintDialog()"><%- icon('print') %> 批量打印</button>
        <button class="btn btn-outline" onclick="exportExcel()"><%- icon('download') %> 导出 Excel</button>
      </div>
    </div>

    <!-- 批量打印配置弹窗 -->
    <div id="printModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:999;align-items:center;justify-content:center;">
      <div style="background:#fff;border-radius:10px;padding:24px;width:420px;max-width:92vw;box-shadow:0 8px 30px rgba(0,0,0,.25);">
        <div style="font-size:17px;font-weight:bold;margin-bottom:16px;"><%- icon('print') %> 批量打印标签</div>
        <div class="form-group">
          <label>打印范围</label>
          <select id="printScope" class="form-control">
            <option value="checked">勾选的码（本页）</option>
            <option value="filtered">当前筛选的全部结果</option>
          </select>
        </div>
        <div class="form-group">
          <label>每行标签数（列数）</label>
          <select id="printCols" class="form-control">
            <option value="2">2 列（大标签）</option>
            <option value="3" selected>3 列</option>
            <option value="4">4 列</option>
            <option value="5">5 列（小标签）</option>
          </select>
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:6px;font-weight:normal;">
            <input type="checkbox" id="printMeta" checked> 标签上显示产品名和批次号
          </label>
        </div>
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:6px;font-weight:normal;">
            <input type="checkbox" id="printBrand" checked> 标签上显示品牌名
          </label>
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px;">
          <button class="btn btn-outline" onclick="closePrintDialog()">取消</button>
          <button class="btn btn-primary" onclick="doPrint()">生成打印页</button>
        </div>
      </div>
    </div>

    <div class="card" id="resultCard">
      <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
        <span id="resultTitle"></span>
        <button id="batchBtn" class="btn btn-outline btn-sm" style="display:none;color:#ea4335;border-color:#ea4335;" onclick="batchDelete()"><%- icon('trash') %> 批量删除选中（<span id="selCount">0</span>）</button>
      </div>
      <div id="resultBody"></div>
      <div id="pagination" class="pagination"></div>
    </div>
  </div>

  <script>
    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }

    function statusTag(s) {
      if (s === 'shipped') return '<span class="tag tag-blue">已发货</span>';
      if (s === 'scanned') return '<span class="tag tag-green">已扫码</span>';
      if (s === 'invalid') return '<span class="tag tag-red">已作废</span>';
      return '<span class="tag tag-gray">在库</span>';
    }

    function actionBtns(type, row) {
      const isInvalid = row.status === 'invalid';
      let html = '<div style="display:flex;gap:4px;flex-wrap:wrap;">';
      if (isInvalid) {
        html += `<span class="tag tag-red">已作废</span>`;
        html += `<button class="btn btn-outline btn-sm" style="color:#ea4335;border-color:#ea4335;" onclick="deleteCode('${type}','${row.id}','${row.box_code || row.item_code}')">删除</button>`;
      } else {
        if (row.status === 'shipped' || row.status === 'scanned') {
          html += `<button class="btn btn-outline btn-sm" style="color:#ff9500;border-color:#ff9500;" onclick="invalidateCode('${type}','${row.id}','${row.box_code || row.item_code}')">标记作废</button>`;
        }
        if (row.status === 'in_stock') {
          html += `<button class="btn btn-outline btn-sm" style="color:#ea4335;border-color:#ea4335;" onclick="deleteCode('${type}','${row.id}','${row.box_code || row.item_code}')">删除</button>`;
        }
      }
      html += '</div>';
      return html;
    }

    async function deleteCode(type, id, code) {
      if (!confirm('确定要删除「' + code + '」吗？\n\n此操作不可恢复，删除后该码的记录将彻底消失。')) return;
      const res = await fetch('/api/codes/' + type + '/' + id, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) { toast(data.msg); search(currentPage || 1); }
      else toast(data.msg, 'error');
    }

    // ===== 批量删除 =====
    function checkCell(type, row) {
      const can = row.status === 'in_stock' || row.status === 'invalid';
      return `<td style="text-align:center;">${can ? `<input type="checkbox" class="row-check" data-id="${row.id}">` : ''}</td>`;
    }
    function checkHead() {
      return '<th style="width:32px;text-align:center;"><input type="checkbox" id="checkAll" onchange="toggleAll(this)" title="全选本页可删除的码"></th>';
    }
    function bindChecks() {
      document.querySelectorAll('.row-check').forEach(cb => cb.addEventListener('change', updateSelCount));
      updateSelCount();
    }
    function toggleAll(master) {
      document.querySelectorAll('.row-check').forEach(cb => { cb.checked = master.checked; });
      updateSelCount();
    }
    function updateSelCount() {
      const n = document.querySelectorAll('.row-check:checked').length;
      document.getElementById('selCount').textContent = n;
      document.getElementById('batchBtn').style.display = n > 0 ? '' : 'none';
    }
    async function batchDelete() {
      const type = document.querySelector('input[name="codeType"]:checked').value;
      const ids = Array.from(document.querySelectorAll('.row-check:checked')).map(cb => parseInt(cb.dataset.id));
      if (!ids.length) return toast('请先勾选要删除的码', 'error');
      let msg = '确定要批量删除选中的 ' + ids.length + ' 个' + (type === 'box' ? '箱码' : '子码') + '吗？';
      msg += '\n\n此操作不可恢复；已发货/已扫码/箱下有子码的会被自动跳过。';
      if (!confirm(msg)) return;
      const res = await fetch('/api/codes/batch-delete', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, ids })
      });
      const data = await res.json();
      if (data.success) {
        if (data.skipped && data.skipped.length) {
          const detail = data.skipped.slice(0, 5).map(s => s.code + '（' + s.msg + '）').join('、');
          toast(data.msg + '：' + detail + (data.skipped.length > 5 ? ' 等' : ''), 'error');
        } else {
          toast(data.msg);
        }
        search(currentPage || 1);
      } else toast(data.msg || '批量删除失败', 'error');
    }

    async function invalidateCode(type, id, code) {
      const reason = prompt('将「' + code + '」标记为作废？\n\n请输入作废原因（可选）：', '');
      if (reason === null) return;
      const res = await fetch('/api/codes/' + type + '/' + id + '/invalidate', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      });
      const data = await res.json();
      if (data.success) { toast(data.msg); search(currentPage || 1); }
      else toast(data.msg, 'error');
    }

    let currentPage = 1;
    let currentRows = [];   // 当前页码数据（打印勾选用）
    let currentTotal = 0;   // 当前筛选总数
    // 暴露到 window 方便 PC 浏览器在控制台排查「码查询」页卡住问题
    window.addEventListener('error', e => {
      console.error('[codes] 页面脚本错误:', e.message, e.filename, e.lineno);
      const body = document.getElementById('resultBody');
      if (body && !body.innerHTML.trim()) {
        body.innerHTML = '<div style="padding:24px;text-align:center;color:#c5221f;background:#fef7f7;border:1px solid #fbcaca;border-radius:6px;">页面加载异常：' + esc(e.message || '未知错误') + '</div>';
      }
    });
    async function search(page) {
      currentPage = page;
      const body = document.getElementById('resultBody');
      try {
        const keyword = document.getElementById('searchKeyword').value.trim();
        const type = document.querySelector('input[name="codeType"]:checked').value;
        const status = document.getElementById('statusFilter').value;
        const params = new URLSearchParams({ type: type, page: page, keyword: keyword });
        if (status) params.set('status', status);
        const res = await fetch('/api/codes?' + params.toString());
        const data = await res.json();
        if (!data.success) {
          body.innerHTML = '<p style="color:#c5221f;padding:16px;">查询失败：' + esc(data.msg || '未知错误') + '</p>';
          return;
        }

      const title = document.getElementById('resultTitle');
      const card = document.getElementById('resultCard');
      card.style.display = 'block';
      currentTotal = data.total || 0;

      if (type === 'box') {
        currentRows = data.boxes;
        title.textContent = '箱码列表（共 ' + data.total + ' 条）';
        if (data.boxes.length === 0) {
          document.getElementById('batchBtn').style.display = 'none';
          body.innerHTML = '<p style="color:#999;text-align:center;padding:20px;">无结果</p>';
        } else {
          body.innerHTML = '<div class="table-wrap"><table class="table"><thead><tr>' + checkHead() + '<th>箱码</th><th>产品</th><th class="col-sm-hide">批次</th><th>数量</th><th>已扫码</th><th>状态</th><th class="col-sm-hide">创建时间</th><th>操作</th></tr></thead><tbody>' +
            data.boxes.map(b => `<tr>
              ${checkCell('box', b)}
              <td style="font-family:monospace;font-size:12px;"><a href="/v/${encodeURIComponent(b.box_code)}" target="_blank" rel="noopener">${esc(b.box_code)}</a></td>
              <td>${b.product_name ? esc(b.product_name) : '<span class="tag tag-gray">未绑定</span>'}</td>
              <td class="col-sm-hide">${esc(b.batch_no || '-')}</td>
              <td>${b.item_count}</td>
              <td>${b.scanned_count || 0}</td>
              <td>${statusTag(b.status)}</td>
              <td class="col-sm-hide" style="font-size:12px;color:#666;">${esc(b.created_at)}</td>
              <td>${actionBtns('box', b)}</td>
            </tr>`).join('') + '</tbody></table></div>';
          bindChecks();
        }
      } else {
        currentRows = data.items;
        title.textContent = '子码列表（共 ' + data.total + ' 条）';
        if (data.items.length === 0) {
          document.getElementById('batchBtn').style.display = 'none';
          body.innerHTML = '<p style="color:#999;text-align:center;padding:20px;">无结果</p>';
        } else {
          body.innerHTML = '<div class="table-wrap"><table class="table"><thead><tr>' + checkHead() + '<th>子码</th><th class="col-sm-hide">箱码</th><th>产品</th><th>状态</th><th class="col-sm-hide">代理商</th><th class="col-sm-hide">创建时间</th><th>操作</th></tr></thead><tbody>' +
            data.items.map(i => `<tr>
              ${checkCell('item', i)}
              <td style="font-family:monospace;font-size:12px;"><a href="/v/${encodeURIComponent(i.item_code)}" target="_blank" rel="noopener">${esc(i.item_code)}</a></td>
              <td class="col-sm-hide" style="font-family:monospace;font-size:12px;">${i.box_code ? `<a href="/v/${encodeURIComponent(i.box_code)}" target="_blank" rel="noopener">${esc(i.box_code)}</a>` : '<span class="tag tag-gray">未绑定</span>'}</td>
              <td>${i.product_name ? esc(i.product_name) : '<span class="tag tag-gray">未绑定</span>'}</td>
              <td>${statusTag(i.status)}</td>
              <td class="col-sm-hide">${esc(i.distributor_name || '-')}</td>
              <td class="col-sm-hide" style="font-size:12px;color:#666;">${esc(i.created_at)}</td>
              <td>${actionBtns('item', i)}</td>
            </tr>`).join('') + '</tbody></table></div>';
          bindChecks();
        }
      }

      const pgEl = document.getElementById('pagination');
      pgEl.innerHTML = '';
      for (let i = 1; i <= data.pages; i++) {
        const a = document.createElement('a');
        a.textContent = i;
        if (i === page) a.className = 'active';
        a.onclick = () => search(i);
        pgEl.appendChild(a);
      }
      } catch (e) {
        console.error('[codes] search 异常:', e);
        body.innerHTML = '<div style="padding:24px;text-align:center;color:#c5221f;background:#fef7f7;border:1px solid #fbcaca;border-radius:6px;">加载失败：' + esc(e.message || '网络异常') + '</div>';
      }
    }

    function exportExcel() {
      const keyword = document.getElementById('searchKeyword').value.trim();
      const type = document.querySelector('input[name="codeType"]:checked').value;
      const status = document.getElementById('statusFilter').value;
      const params = new URLSearchParams({ type: type, keyword: keyword });
      if (status) params.set('status', status);
      window.location.href = '/api/export/codes?' + params.toString();
    }

    // ===== 码包下载（给包材印刷厂）=====
    function downloadPackage() {
      const keyword = document.getElementById('searchKeyword').value.trim();
      const type = document.querySelector('input[name="codeType"]:checked').value;
      const status = document.getElementById('statusFilter').value;
      const params = new URLSearchParams({ type: type, keyword: keyword });
      if (status) params.set('status', status);
      toast('正在打包，码多时需要一点时间…');
      window.location.href = '/api/codes/package?' + params.toString();
    }

    // ===== 批量打印标签（手工贴）=====
    function openPrintDialog() {
      const checkedN = document.querySelectorAll('.row-check:checked').length;
      document.getElementById('printScope').options[0].textContent = '勾选的码（本页 ' + checkedN + ' 个）';
      document.getElementById('printScope').options[1].textContent = '当前筛选的全部结果（' + currentTotal + ' 个）';
      document.getElementById('printScope').value = checkedN > 0 ? 'checked' : 'filtered';
      document.getElementById('printCols').value = document.querySelector('input[name="codeType"]:checked').value === 'box' ? '3' : '4';
      document.getElementById('printModal').style.display = 'flex';
    }
    function closePrintDialog() { document.getElementById('printModal').style.display = 'none'; }

    async function doPrint() {
      const type = document.querySelector('input[name="codeType"]:checked').value;
      const scope = document.getElementById('printScope').value;
      const cols = parseInt(document.getElementById('printCols').value) || 3;
      const showMeta = document.getElementById('printMeta').checked;
      const showBrand = document.getElementById('printBrand').checked;
      const isBox = type === 'box';
      const codeKey = isBox ? 'box_code' : 'item_code';

      let rows = [];
      if (scope === 'checked') {
        const ids = Array.from(document.querySelectorAll('.row-check:checked')).map(cb => parseInt(cb.dataset.id));
        rows = currentRows.filter(r => ids.includes(r.id));
        if (!rows.length) { closePrintDialog(); return toast('请先勾选要打印的码', 'error'); }
      } else {
        const keyword = document.getElementById('searchKeyword').value.trim();
        const status = document.getElementById('statusFilter').value;
        const params = new URLSearchParams({ type: type, keyword: keyword, all: '1' });
        if (status) params.set('status', status);
        const res = await fetch('/api/codes?' + params.toString());
        const data = await res.json();
        if (!data.success) { closePrintDialog(); return toast('取数失败', 'error'); }
        rows = data.boxes || data.items || [];
        if (!rows.length) { closePrintDialog(); return toast('当前筛选没有码可打印', 'error'); }
        if (rows.length >= 5000) toast('数量超过5000，仅打印前5000个', 'error');
      }
      closePrintDialog();
      renderPrintPage(rows, cols, showMeta, showBrand, isBox, codeKey);
    }

    function renderPrintPage(rows, cols, showMeta, showBrand, isBox, codeKey) {
      const siteBrand = <%- JSON.stringify(brand || '') %>;
      const labels = rows.map(r => {
        const code = r[codeKey];
        const brandName = r.brand_name || siteBrand || '';
        const brandTxt = (showBrand && brandName) ? `<div class="brand-txt">${esc(brandName)}</div>` : '';
        const meta = showMeta ? `<div class="sub">${esc(r.product_name || '未绑定产品')}${r.batch_no ? ' · 批次 ' + esc(r.batch_no) : ''}</div>` : '';
        return `<div class="label">${brandTxt}<img src="/qr/${code}.png" alt=""><div class="code-txt">${esc(code)}</div>${meta}</div>`;
      }).join('');

      const html = `<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><title>打印${isBox ? '箱码' : '子码'}标签</title>
<style>
  @page { size: A4; margin: 8mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Microsoft YaHei", sans-serif; }
  .grid { display: grid; grid-template-columns: repeat(${cols}, 1fr); gap: 3mm; }
  .label { border: 1px dashed #bbb; padding: 2.5mm 1.5mm; text-align: center; page-break-inside: avoid; break-inside: avoid; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .label img { width: 100%; max-width: ${(isBox ? 34 : 26)}mm; }
  .code-txt { font-family: Consolas, monospace; font-weight: bold; font-size: ${isBox ? '10pt' : '8.5pt'}; letter-spacing: .5px; word-break: break-all; margin-top: 1mm; }
  .brand-txt { font-family: "Microsoft YaHei", sans-serif; font-weight: bold; font-size: ${isBox ? '11pt' : '9pt'}; color: #111; margin-bottom: 1mm; }
  .sub { font-size: 7pt; color: #333; margin-top: .5mm; }
  .tip { position: fixed; top: 6px; right: 10px; font-size: 14px; background: #333; color: #fff; padding: 8px 14px; border-radius: 6px; z-index: 9; }
  @media print { .tip { display: none; } }
</style></head><body>
<div class="tip" onclick="window.print()">点击打印（共 ${rows.length} 个标签，每行 ${cols} 个）</div>
<div class="grid">${labels}</div>
<script\x3e
  (function(){
    var imgs = document.querySelectorAll('.label img');
    var left = imgs.length;
    function done(){ if (--left <= 0) setTimeout(function(){ window.print(); }, 300); }
    imgs.forEach(function(im){ if (im.complete) done(); else { im.onload = done; im.onerror = done; } });
  })();
<\/script>
</body></html>`;

      const w = window.open('', '_blank');
      if (!w) return toast('浏览器拦截了弹窗，请允许弹窗后重试', 'error');
      w.document.write(html);
      w.document.close();
    }

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    // 从 URL 读取初始筛选（首页统计卡跳转过来）
    const urlParams = new URLSearchParams(window.location.search);
    const initType = urlParams.get('type');
    const initStatus = urlParams.get('status');
    if (initType === 'item') document.querySelector('input[name="codeType"][value="item"]').checked = true;
    if (initStatus) document.getElementById('statusFilter').value = initStatus;

    search(1);
  </script>
</body>
</html>
