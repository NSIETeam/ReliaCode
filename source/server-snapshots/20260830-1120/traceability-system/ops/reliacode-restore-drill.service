[Unit]
Description=ReliaCode non-destructive backup restore drill
After=reliacode-backup.service

[Service]
Type=oneshot
ExecStart=/root/traceability-system/ops/restore-drill.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/root/traceability-system /var/backups/reliacode-sqlite
ReadWritePaths=/var/lib/reliacode-ops
