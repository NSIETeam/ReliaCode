<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>个人设置 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'profile' }) %>

  <div class="container">
    <div class="card" style="max-width:460px;margin:0 auto;">
      <div class="card-title"><%- icon('user') %> 个人设置</div>
      <div class="form-group">
        <label>账号</label>
        <input type="text" class="form-control" value="<%= user.username %>" disabled>
      </div>
      <div class="form-group">
        <label>姓名</label>
        <input type="text" class="form-control" value="<%= user.display_name %>" disabled>
      </div>
      <div class="form-group">
        <label>角色</label>
        <input type="text" class="form-control" value="<%= roleNames[user.role] || user.role %>" disabled>
      </div>
      <hr style="border:none;border-top:1px solid #eee;margin:20px 0;">
      <div class="card-title" style="font-size:14px;">修改密码</div>
      <div class="form-group">
        <label>原密码</label>
        <input type="password" id="oldPwd" class="form-control" autocomplete="current-password">
      </div>
      <div class="form-group">
        <label>新密码（至少6位）</label>
        <input type="password" id="newPwd" class="form-control" autocomplete="new-password">
      </div>
      <div class="form-group">
        <label>确认新密码</label>
        <input type="password" id="newPwd2" class="form-control" autocomplete="new-password">
      </div>
      <button class="btn btn-primary" onclick="changePwd()" style="width:100%;">修改密码</button>
    </div>
  </div>

  <script>
    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }
    async function changePwd() {
      const old_password = document.getElementById('oldPwd').value;
      const p1 = document.getElementById('newPwd').value;
      const p2 = document.getElementById('newPwd2').value;
      if (!old_password || !p1) { toast('请填写完整', 'error'); return; }
      if (p1 !== p2) { toast('两次输入的新密码不一致', 'error'); return; }
      const res = await fetch('/api/profile/password', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ old_password, new_password: p1 })
      });
      const d = await res.json();
      if (d.success) {
        toast('密码已修改');
        document.getElementById('oldPwd').value = '';
        document.getElementById('newPwd').value = '';
        document.getElementById('newPwd2').value = '';
      } else toast(d.msg || '修改失败', 'error');
    }
  </script>
</body>
</html>
