<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>串货预警中心 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'alerts' }) %>

  <div class="container">
    <div class="card">
      <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;">
        <span><%- icon('alert') %> 串货预警中心<% if (alerts.filter(a => !a.handled).length > 0) { %><span class="tag tag-red" style="margin-left:8px;">未处理 <%= alerts.filter(a => !a.handled).length %></span><% } %></span>
        <button class="btn btn-outline btn-sm" onclick="handleAll()"><%- icon('check') %> 全部标记已处理</button>
      </div>
      <p style="color:#666;font-size:13px;">消费者扫码检测到区域不符时自动产生预警：轻度=同省跨市，重度=跨省流通。</p>
      <% if (alerts.length === 0) { %>
        <p style="color:#666;text-align:center;padding:30px;">暂无预警记录</p>
      <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>级别</th><th>溯源码</th><th>产品</th><th>代理商</th>
            <th>指定区域</th><th>实际扫码位置</th><th>时间</th><th>状态</th><th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% alerts.forEach(a => { %>
          <tr style="<%= a.handled ? 'opacity:.55;' : '' %>">
            <td><span class="tag <%= a.level >= 2 ? 'tag-red' : 'tag-yellow' %>"><%= a.level >= 2 ? '重度' : '轻度' %></span></td>
            <td style="font-family:monospace;font-size:12px;"><%= a.item_code %></td>
            <td><%= a.product_name || '-' %></td>
            <td><%= a.distributor_name || '-' %></td>
            <td><%= a.assigned_region || '-' %></td>
            <td><%= a.scan_location || '-' %></td>
            <td style="font-size:12px;color:#666;"><%= a.created_at %></td>
            <td><%= a.handled ? '已处理' : '<span class="tag tag-red">待处理</span>' %></td>
            <td><% if (!a.handled) { %><button class="btn btn-outline btn-sm" onclick="handleOne(<%= a.id %>)">处理</button><% } else { %>-<% } %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <script>
    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }
    async function handleOne(id) {
      const res = await fetch(`/api/alerts/${id}/handle`, { method: 'POST' });
      const d = await res.json();
      if (d.success) location.reload();
      else toast(d.msg || '操作失败', 'error');
    }
    async function handleAll() {
      if (!confirm('确定将全部预警标记为已处理？')) return;
      const res = await fetch('/api/alerts/handle-all', { method: 'POST' });
      const d = await res.json();
      if (d.success) location.reload();
      else toast(d.msg || '操作失败', 'error');
    }
  </script>
</body>
</html>
