<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>注册 - <%= brand %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background: linear-gradient(135deg, #1a73e8 0%, #6c5ce7 100%); padding: 20px 0; }
    .reg-box { background: #fff; border-radius: 16px; padding: 36px; width: 400px; max-width: 92vw;
      box-shadow: 0 20px 60px rgba(0,0,0,.25); }
    .reg-box .logo { text-align: center; font-size: 36px; margin-bottom: 6px; }
    .reg-box h1 { text-align: center; font-size: 19px; color: #222; margin-bottom: 4px; }
    .reg-box .sub { text-align: center; font-size: 12px; color: #999; margin-bottom: 22px; }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: 13px; color: #555; margin-bottom: 6px; }
    .form-group input { width: 100%; padding: 11px 12px; border: 1px solid #d9d9d9; border-radius: 8px;
      font-size: 15px; outline: none; transition: border .2s; }
    .form-group input:focus { border-color: #1a73e8; }
    .btn-reg { width: 100%; padding: 12px; background: #1a73e8; color: #fff; border: none;
      border-radius: 8px; font-size: 16px; cursor: pointer; margin-top: 4px; }
    .btn-reg:disabled { opacity: .6; cursor: not-allowed; }
    .btn-check { padding: 8px 16px; background: #f0f4ff; color: #1a73e8; border: 1px solid #1a73e8;
      border-radius: 8px; font-size: 13px; cursor: pointer; white-space: nowrap; }
    .msg { border-radius: 8px; padding: 10px 12px; font-size: 13px; margin-bottom: 14px; }
    .msg.error { background: #fdecea; color: #c62828; }
    .msg.ok { background: #e8f5e9; color: #2e7d32; }
    .role-banner { display: none; background: #eef4ff; border-radius: 8px; padding: 10px 12px;
      font-size: 13px; color: #1a73e8; margin-bottom: 14px; }
    .back { margin-top: 16px; text-align: center; font-size: 13px; }
    .back a { color: #666; text-decoration: none; }
    .tip { margin-top: 14px; font-size: 12px; color: #aaa; text-align: center; line-height: 1.8; }
  </style>
</head>
<body>
  <div class="reg-box">
    <div class="logo"><%- icon('tag', 'ui-icon-lg') %></div>
    <h1><%= brand %></h1>
    <div class="sub">合作方自助注册（需总部邀请码）</div>
    <div id="msg" class="msg error" style="display:none;"></div>
    <div id="roleBanner" class="role-banner"></div>

    <div class="form-group" style="display:flex;gap:8px;align-items:flex-end;">
      <div style="flex:1;">
        <label>邀请码</label>
        <input type="text" id="fCode" value="<%= code %>" placeholder="总部发放的邀请码" style="text-transform:uppercase;">
      </div>
      <button type="button" class="btn-check" onclick="checkCode()">验证</button>
    </div>

    <div id="regForm" style="display:none;">
      <div class="form-group">
        <label>账号（3-20位字母/数字/下划线）</label>
        <input type="text" id="fUsername" placeholder="登录用账号，如 gd_chaye">
      </div>
      <div class="form-group">
        <label>密码（至少6位）</label>
        <input type="password" id="fPassword" placeholder="请设置密码">
      </div>
      <div class="form-group">
        <label>密码确认</label>
        <input type="password" id="fPassword2" placeholder="再输入一次密码">
      </div>
      <div class="form-group">
        <label id="companyLabel">公司/工厂名称</label>
        <input type="text" id="fCompany" placeholder="如：云山茶业广州工厂">
      </div>
      <div class="form-group" id="regionGroup" style="display:none;">
        <label>负责区域（用于串货检测）</label>
        <input type="text" id="fRegion" placeholder="如：广东省广州市">
      </div>
      <div class="form-group">
        <label>联系人/电话（选填）</label>
        <input type="text" id="fContact" placeholder="选填">
      </div>
      <button type="button" class="btn-reg" id="btnReg" onclick="doRegister()">注 册</button>
    </div>

    <div class="back"><a href="/login">← 返回登录</a></div>
    <div class="tip">没有邀请码请联系总部获取<br>消费者扫码验证无需注册</div>
  </div>

  <script>
    let invRole = '';
    const msgEl = document.getElementById('msg');
    const roleEl = document.getElementById('roleBanner');
    function showMsg(text, ok) {
      msgEl.textContent = text;
      msgEl.className = 'msg ' + (ok ? 'ok' : 'error');
      msgEl.style.display = text ? '' : 'none';
    }
    async function checkCode() {
      const code = document.getElementById('fCode').value.trim().toUpperCase();
      if (!code) return showMsg('请输入邀请码', false);
      const res = await fetch('/api/register/check-code', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code })
      });
      const d = await res.json();
      if (!d.success) {
        invRole = '';
        roleEl.style.display = 'none';
        document.getElementById('regForm').style.display = 'none';
        return showMsg(d.msg, false);
      }
      invRole = d.role;
      showMsg('', true);
      roleEl.textContent = d.role === 'factory'
        ? '邀请码有效：工厂注册（注册后可登录装箱作业，仅管理本厂产品）'
        : '邀请码有效：代理商注册（注册后可登录自助端查看自己的库存与扫码）';
      roleEl.style.display = '';
      document.getElementById('regForm').style.display = '';
      document.getElementById('regionGroup').style.display = d.role === 'distributor' ? '' : 'none';
      document.getElementById('companyLabel').textContent = d.role === 'factory' ? '工厂名称' : '公司名称';
    }

    async function doRegister() {
      const body = {
        code: document.getElementById('fCode').value.trim().toUpperCase(),
        username: document.getElementById('fUsername').value.trim(),
        password: document.getElementById('fPassword').value,
        company: document.getElementById('fCompany').value.trim(),
        region: document.getElementById('fRegion').value.trim(),
        contact: document.getElementById('fContact').value.trim()
      };
      if (!body.username) return showMsg('请填写账号', false);
      if (body.password.length < 6) return showMsg('密码至少6位', false);
      if (body.password !== document.getElementById('fPassword2').value) return showMsg('两次密码不一致', false);
      if (!body.company) return showMsg('请填写公司/工厂名称', false);
      if (invRole === 'distributor' && !body.region) return showMsg('请填写负责区域', false);

      const btn = document.getElementById('btnReg');
      btn.disabled = true; btn.textContent = '注册中…';
      try {
        const res = await fetch('/api/register', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const d = await res.json();
        if (d.success) {
          showMsg('注册成功！即将跳转登录页，请用新账号「' + d.username + '」登录', true);
          setTimeout(() => location.href = '/login', 1800);
        } else {
          showMsg(d.msg || '注册失败', false);
          btn.disabled = false; btn.textContent = '注 册';
        }
      } catch (e) {
        showMsg('网络异常，请重试', false);
        btn.disabled = false; btn.textContent = '注 册';
      }
    }
    // 从链接带码进入时自动校验
    if (document.getElementById('fCode').value) checkCode();
  </script>
</body>
</html>
