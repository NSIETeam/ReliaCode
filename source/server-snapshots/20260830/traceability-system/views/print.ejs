<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>标签打印</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: 'Microsoft YaHei', sans-serif; background:#eee; }
    .toolbar {
      position: fixed; top:0; left:0; right:0; z-index:99;
      background:#fff; padding:12px 20px; display:flex; gap:12px; align-items:center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .toolbar button { padding:8px 24px; border:none; border-radius:6px; background:#1a73e8; color:#fff; font-size:14px; cursor:pointer; }
    .toolbar .tip { color:#666; font-size:13px; }
    .print-area { max-width: 820px; margin: 70px auto 20px; background:#fff; padding:16px; }
    .brand-line { text-align:center; font-size:12px; color:#666; padding:4px 0 12px; }
    /* A4 3列网格 */
    .grid { display:grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .label {
      border: 1px solid #ddd; border-radius:6px; padding:8px;
      text-align:center; page-break-inside: avoid;
    }
    .label .product { font-size:11px; color:#333; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .label .code { font-size:10px; font-family:monospace; color:#555; word-break:break-all; line-height:1.3; margin-top:2px; }
    .label img { width:96px; height:96px; }
    .label .badge { display:inline-block; font-size:9px; padding:1px 6px; border-radius:3px; background:#e8f0fe; color:#1967d2; margin-bottom:3px; }
    .empty { color:#999; text-align:center; padding:60px; font-size:14px; }
    @media print {
      .toolbar { display:none !important; }
      body { background:#fff; }
      .print-area { margin:0; max-width:100%; padding:0; }
      .label { border-color:#999; }
    }
  </style>
</head>
<body>
  <div class="toolbar">
    <button onclick="window.print()"><%- icon('print') %> 打印</button>
    <button onclick="window.close()">关闭</button>
    <span class="tip">共 <%= codes.length %> 个标签 ｜ 使用浏览器打印功能，可调纸张为 A4，标签可适配热敏贴纸</span>
  </div>

  <div class="print-area">
    <div class="brand-line"><%= brand %> ｜ 产品防伪溯源码标签</div>
    <% if (codes.length === 0) { %>
      <div class="empty">没有可打印的码，请返回码生成页选择要打印的码</div>
    <% } else { %>
    <div class="grid">
      <% codes.forEach(c => { %>
      <div class="label">
        <div class="badge"><%= type === 'box' ? '箱码' : '子码' %></div>
        <div class="product"><%= product %></div>
        <img src="/qr/<%= c %>.png" onerror="this.style.display='none'">
        <div class="code"><%= c %></div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</body>
</html>
