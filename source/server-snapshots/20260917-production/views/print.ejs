<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('partials/boot-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 穿山甲 · 标签打印</title>
  <style nonce="<%= cspNonce %>">
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; background:#fff; color:#000; }
    .toolbar {
      position: fixed; top:0; left:0; right:0; z-index:99;
      background:#fff; padding:12px 20px; display:flex; gap:12px; align-items:center;
      border-bottom: 1px solid #000;
    }
    .toolbar button { padding:8px 24px; border:1px solid #000; border-radius:6px; background:#fff; color:#000; font-size:14px; cursor:pointer; }
    .toolbar .tip { color:#000; font-size:13px; }
    .print-area { max-width: 820px; margin: 70px auto 20px; background:#fff; padding:16px; }
    .brand-line { text-align:center; font-size:12px; color:#000; padding:4px 0 12px; }
    /* A4 3列网格 */
    .grid { display:grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .label {
      border: 1px solid #000; border-radius:6px; padding:8px;
      text-align:center; page-break-inside: avoid;
    }
    .label .product { font-size:11px; color:#000; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .label .code { font-size:10px; font-family:monospace; color:#000; word-break:break-all; line-height:1.3; margin-top:2px; }
    .label img { width:96px; height:96px; }
    .label .badge { display:inline-block; font-size:9px; padding:1px 6px; border:1px solid #000; border-radius:3px; background:#fff; color:#000; margin-bottom:3px; }
    .empty { color:#000; text-align:center; padding:60px; font-size:14px; }
    @media print {
      .toolbar { display:none !important; }
      body { background:#fff; }
      .print-area { margin:0; max-width:100%; padding:0; }
      .label { border-color:#000; }
    }
      .is-hidden { display: none !important; }
      .ui-icon { width: 1.1em; height: 1.1em; display: inline-block; flex: 0 0 auto; vertical-align: -0.16em; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .ui-icon-lg { width: 2.25rem; height: 2.25rem; }
    svg:not(.qr-code):not(.label-qr) { fill: none; stroke: currentColor; }
  </style>
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260917-hardening-v2">
</head>
<body>
  <%- include('partials/boot-loader') %>
  <%- include('partials/back-button', { fixed: true }) %>
  <div class="toolbar">
    <button id="printBtn"><%- icon('print') %> 打印</button>
    <button id="closeBtn">关闭</button>
    <span class="tip">共 <%= codes.length %> 个标签 ｜ 使用浏览器打印功能，可调纸张为 A4，标签可适配热敏贴纸</span>
  </div>

  <div class="print-area">
    <div class="brand-line">ClawMaster / 穿山甲 ｜ <%= brand %> ｜ 产品防伪溯源码标签</div>
    <% if (codes.length === 0) { %>
      <div class="empty">没有可打印的码，请返回码生成页选择要打印的码</div>
    <% } else { %>
    <div class="grid">
      <% codes.forEach(c => { %>
      <% const info = (labelInfo || []).find(x => x.code === c); %>
      <div class="label">
        <div class="product"><%= (info && info.brand_name) || brand %></div>
        <img class="label-qr" src="/qr/<%= c %>.png" alt="溯源码 <%= c %> 的二维码">
        <div class="code"><%= c %></div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
  <script nonce="<%= cspNonce %>">
    document.getElementById('printBtn').addEventListener('click', () => window.print());
    document.getElementById('closeBtn').addEventListener('click', () => window.close());
    document.querySelectorAll('.label-qr').forEach(image => {
      image.addEventListener('error', () => { image.classList.add('is-hidden'); });
    });
  </script>
</body>
</html>
