<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 代理商管理 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260901c">
  <style nonce="<%= cspNonce %>">
    .region-row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
    .region-row select { flex: 1; }
    .region-row .r-remove { flex: none; }
    .region-add { margin-top: 4px; }
  </style>
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260917-hardening-v2">
</head>
<body>
  <%- include('partials/nav', { active: 'distributors' }) %>

  <div class="container">
    <h1 class="sr-only">代理商管理</h1>
    <div class="card">
      <div class="card-title">新增代理商</div>
      <div class="entity-form-grid">
        <div class="form-group">
          <label>代理商名称</label>
          <input type="text" id="distName" class="form-control" placeholder="如：深圳总代">
        </div>
        <div class="form-group">
          <label>联系电话</label>
          <input type="text" id="distPhone" class="form-control" placeholder="手机号">
        </div>
        <div class="form-group">
          <label>覆盖区域（可多选省市；选"全省"即覆盖整个省）</label>
          <div id="distRegions" class="region-list"></div>
          <button id="addDistRegionBtn" class="btn btn-outline btn-sm region-add" type="button">+ 添加区域</button>
        </div>
        <div class="form-group">
          <label>地址</label>
          <input type="text" id="distAddress" class="form-control" placeholder="详细地址">
        </div>
        <% if (brands && brands.length > 0) { %>
        <div class="form-group">
          <label>归属品牌</label>
          <select id="distBrand" class="form-control">
            <option value="">请选择品牌</option>
            <% brands.forEach(b => { %><option value="<%= b.id %>"><%= b.name %></option><% }); %>
          </select>
        </div>
        <% } %>
      </div>
      <button id="addDistBtn" class="btn btn-primary" type="button">添加代理商</button>
    </div>

    <div class="card">
      <div class="card-title">代理商列表</div>
      <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>名称</th><th class="col-sm-hide">电话</th><th>区域</th><th class="col-sm-hide">地址</th><% if (brands && brands.length > 0) { %><th class="col-sm-hide">归属品牌</th><% } %>
            <th class="col-sm-hide">创建时间</th><th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% distributors.forEach(d => { %>
          <tr>
            <td><%= d.name %></td>
            <td class="col-sm-hide"><%= d.phone || '-' %></td>
            <td><span class="tag tag-blue"><%= d.region || '未设置' %></span></td>
            <td class="col-sm-hide"><%= d.address || '-' %></td>
            <% if (brands && brands.length > 0) { %><td class="col-sm-hide"><%= d.brand_name || '-' %></td><% } %>
            <td class="col-sm-hide meta-cell"><%= d.created_at %></td>
            <td>
              <% if (user && ['admin', 'brand', 'AUDIT_VIEWER'].includes(user.role)) { %><a class="btn btn-outline btn-sm" href="/portal?distributor_id=<%= d.id %>">查看工作台</a><% } %>
              <button class="btn btn-outline btn-sm edit-dist-btn" type="button" data-dist-id="<%= d.id %>" data-dist-name="<%= d.name %>" data-dist-phone="<%= d.phone || '' %>" data-dist-region="<%= d.region || '' %>" data-dist-covered="<%= d.covered_regions || '' %>" data-dist-address="<%= d.address || '' %>">编辑</button>
              <button class="btn btn-danger btn-sm delete-dist-btn" type="button" data-dist-id="<%= d.id %>">删除</button>
            </td>
          </tr>
          <% }); %>
          <% if (distributors.length === 0) { %>
          <tr><td colspan="6" class="empty-cell">暂无代理商</td></tr>
          <% } %>
        </tbody>
      </table>
      </div>
    </div>
  </div>

  <!-- 编辑弹窗 -->
  <div id="editModal" class="entity-modal-mask is-hidden">
    <div class="card entity-modal">
      <div class="card-title">编辑代理商</div>
      <input type="hidden" id="editId">
      <div class="form-group"><label>名称</label><input type="text" id="editName" class="form-control"></div>
      <div class="form-group"><label>电话</label><input type="text" id="editPhone" class="form-control"></div>
      <div class="form-group">
        <label>覆盖区域（可多选省市；选"全省"即覆盖整个省）</label>
        <div id="editRegions" class="region-list"></div>
        <button id="addEditRegionBtn" class="btn btn-outline btn-sm region-add" type="button">+ 添加区域</button>
      </div>
      <div class="form-group"><label>地址</label><input type="text" id="editAddress" class="form-control"></div>
      <div class="modal-actions">
        <button id="saveDistBtn" class="btn btn-primary" type="button">保存</button>
        <button id="closeDistModalBtn" class="btn btn-outline" type="button">取消</button>
      </div>
    </div>
  </div>

  <script nonce="<%= cspNonce %>">
    let regionCatalog = {};

    // 创建一个区域行（省下拉 + 市下拉[含"全省"] + 删除按钮）
    function createRegionRow(province, city) {
      const row = document.createElement('div');
      row.className = 'region-row';

      const provSel = document.createElement('select');
      provSel.className = 'form-control r-province';
      provSel.appendChild(new Option('请选择省份', ''));
      Object.keys(regionCatalog).forEach(name => provSel.add(new Option(name, name)));
      provSel.value = province || '';

      const citySel = document.createElement('select');
      citySel.className = 'form-control r-city';
      function fillCity() {
        const p = provSel.value;
        citySel.replaceChildren(new Option('（全省）', ''));
        (regionCatalog[p] || []).forEach(name => citySel.add(new Option(name, name)));
        citySel.disabled = !p;
      }
      provSel.addEventListener('change', fillCity);
      fillCity();
      citySel.value = city || '';

      const delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'btn btn-outline btn-sm r-remove';
      delBtn.textContent = '删除';
      delBtn.addEventListener('click', () => row.remove());

      row.appendChild(provSel);
      row.appendChild(citySel);
      row.appendChild(delBtn);
      return row;
    }

    function addRegionRow(containerId, province, city) {
      const container = document.getElementById(containerId);
      container.appendChild(createRegionRow(province, city));
    }

    // 收集某个容器里的所有区域
    function collectRegions(containerId) {
      const container = document.getElementById(containerId);
      const regions = [];
      container.querySelectorAll('.region-row').forEach(row => {
        const p = row.querySelector('.r-province').value;
        const c = row.querySelector('.r-city').value;
        if (p) regions.push({ province: p, city: c });
      });
      return regions;
    }

    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }

    async function loadRegionCatalog() {
      const response = await fetch('/api/regions');
      const data = await response.json();
      if (!data.success || !data.countries?.[0]?.provinces) throw new Error('地区目录加载失败');
      regionCatalog = data.countries[0].provinces;
      addRegionRow('distRegions');
    }

    async function addDist() {
      const name = document.getElementById('distName').value.trim();
      const phone = document.getElementById('distPhone').value.trim();
      const address = document.getElementById('distAddress').value.trim();
      const regions = collectRegions('distRegions');
      const brandSel = document.getElementById('distBrand');
      const brand_id = brandSel ? brandSel.value : '';
      if (!name) return toast('请输入代理商名称', 'error');
      if (!regions.length) return toast('请至少选择一个覆盖区域', 'error');
      if (brandSel && !brand_id) return toast('请选择归属品牌', 'error');
      const res = await fetch('/api/distributors', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({name, phone, regions, address, brand_id, country: '中国'})
      });
      const data = await res.json();
      if (data.success) { toast('添加成功'); setTimeout(()=>location.reload(), 800); }
      else toast(data.msg || '添加失败', 'error');
    }

    function editDist(id, name, phone, legacyRegion, coveredJson, address) {
      document.getElementById('editModal').classList.remove('is-hidden');
      document.getElementById('editId').value = id;
      document.getElementById('editName').value = name;
      document.getElementById('editPhone').value = phone;
      document.getElementById('editAddress').value = address;

      // 清空并回填区域
      const container = document.getElementById('editRegions');
      container.replaceChildren();
      let regions = [];
      try { regions = JSON.parse(coveredJson || '[]'); } catch(e) { regions = []; }
      if (!Array.isArray(regions) || !regions.length) {
        // 兼容旧数据：从 legacyRegion 解析单省单市
        if (legacyRegion) {
          const prov = Object.keys(regionCatalog).find(name => legacyRegion.includes(name)) || '';
          const city = (regionCatalog[prov] || []).find(name => legacyRegion.includes(name)) || '';
          if (prov) regions = [{ p: prov, c: city }];
        }
      }
      if (regions.length) {
        regions.forEach(r => addRegionRow('editRegions', r.p, r.c));
      } else {
        addRegionRow('editRegions');
      }
    }
    function closeModal() { document.getElementById('editModal').classList.add('is-hidden'); }

    async function saveDist() {
      const id = document.getElementById('editId').value;
      const name = document.getElementById('editName').value.trim();
      const phone = document.getElementById('editPhone').value.trim();
      const address = document.getElementById('editAddress').value.trim();
      const regions = collectRegions('editRegions');
      if (!name) return toast('请输入代理商名称', 'error');
      if (!regions.length) return toast('请至少选择一个覆盖区域', 'error');
      const res = await fetch(`/api/distributors/${id}`, {
        method: 'PUT', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({name, phone, regions, address, country: '中国'})
      });
      const data = await res.json();
      if (data.success) { toast('保存成功'); setTimeout(()=>location.reload(), 800); }
      else toast(data.msg || '保存失败', 'error');
    }

    async function delDist(id) {
      if (!confirm('确定删除该代理商？')) return;
      const res = await fetch(`/api/distributors/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) { toast('已删除'); setTimeout(()=>location.reload(), 800); }
    }

    document.getElementById('addDistBtn').addEventListener('click', addDist);
    document.getElementById('addDistRegionBtn').addEventListener('click', () => addRegionRow('distRegions'));
    document.getElementById('addEditRegionBtn').addEventListener('click', () => addRegionRow('editRegions'));
    document.getElementById('saveDistBtn').addEventListener('click', saveDist);
    document.getElementById('closeDistModalBtn').addEventListener('click', closeModal);
    document.querySelectorAll('.edit-dist-btn').forEach(button => {
      button.addEventListener('click', () => editDist(
        Number(button.dataset.distId), button.dataset.distName, button.dataset.distPhone,
        button.dataset.distRegion, button.dataset.distCovered, button.dataset.distAddress
      ));
    });
    document.querySelectorAll('.delete-dist-btn').forEach(button => {
      button.addEventListener('click', () => delDist(Number(button.dataset.distId)));
    });
    loadRegionCatalog().catch(() => toast('地区目录加载失败，请刷新后重试', 'error'));
  </script>
</body>
</html>
