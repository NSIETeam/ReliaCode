<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('partials/boot-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 品牌方发货 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260924a">
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260903a">
</head>
<body>
  <%- include('partials/boot-loader') %>
  <%- include('partials/nav', { active: 'warehouse' }) %>

  <div class="container">
    <header class="page-heading">
      <h1>品牌发货</h1>
      <p>扫描箱码或子码，按订单发往指定代理商。</p>
    </header>

    <div class="card">
      <div class="card-title">扫码发货</div>
      <p class="section-help warehouse-help">
        连续扫描<b>箱码</b>（整箱）或<b>子码</b>（散件），累积到下方列表，选好代理商后一次性批量发货。
      </p>
      <p class="small-text muted-text" id="shipSetupHint" data-keep-visible="true" aria-live="polite"></p>
      <div class="scan-box">
        <div class="scan-hero-icon"><%- icon('box', 'ui-icon-lg') %></div>
        <div class="scan-input-row">
          <input type="text" id="boxCode" class="form-control scan-box-input scan-flex-input"
            placeholder="扫描 / 输入箱码或子码">
          <button type="button" class="btn btn-outline no-wrap" id="openScannerBtn"><%- icon('camera') %> 手机扫码</button>
        </div>
      </div>

      <!-- 取消发货入口 -->
      <div class="form-group">
        <button type="button" class="btn btn-outline btn-sm" id="cancelShipBtn"><%- icon('refresh') %> 取消发货</button>
        <span class="mode-status is-hidden" id="cancelShipHint" aria-live="polite"></span>
      </div>
      <!-- 待取消发货清单 + 确认按钮（取消发货模式下显示） -->
      <div class="form-group is-hidden" id="cancelShipPanel">
        <div class="split-title">
          <label>待取消发货清单（<span id="cancelShipCount">0</span> 项）</label>
          <button type="button" class="btn btn-outline btn-sm" id="clearCancelShipBtn">清空</button>
        </div>
        <div id="cancelShipList" class="pending-ship-list">
          <p class="empty-list-state">扫码后自动累积到清单（支持箱码/子码混扫）</p>
        </div>
        <button type="button" class="btn btn-primary btn-sm mt-12" id="confirmCancelShipBtn"><%- icon('check') %> 确认取消发货</button>
      </div>
      <!-- 待发货列表（累积扫码） -->
      <div class="form-group">
        <div class="split-title">
          <label>待发货清单（<span id="pendingCount">0</span> 件）</label>
          <button type="button" class="btn btn-outline btn-sm" id="clearPendingBtn">清空</button>
        </div>
        <div id="pendingList" class="pending-ship-list">
          <p class="empty-list-state">扫码后自动添加到清单（支持箱码/子码混扫）</p>
        </div>
      </div>

      <div class="form-group">
        <label>选择代理商 <span class="required-mark">*</span></label>
        <select id="distSelect" class="form-control">
          <option value="">请选择代理商</option>
          <% distributors.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.name %>（<%= d.region || '未设置区域' %>）</option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label>订单编号 <span class="required-mark">*</span></label>
        <div class="scan-input-row">
          <input type="text" id="orderNoInput" class="form-control scan-flex-input" placeholder="必填，可扫订单条码或手输，如 GD20260901-A">
          <button type="button" class="btn btn-outline no-wrap" id="orderScanBtn"><%- icon('camera') %> 扫订单号</button>
        </div>
        <p class="small-text muted-text" id="orderNoHint" data-keep-visible="true" aria-live="polite"></p>
      </div>
      <div class="form-group">
        <label>备注（选填）</label>
        <input type="text" id="remarkInput" class="form-control" placeholder="备注信息，如发往 XX 仓、紧急发货运单号等">
      </div>
      <div class="form-group">
        <label>操作人（自动记录登录账号）</label>
        <input type="text" class="form-control" value="<%= user ? user.display_name : '' %>" disabled>
      </div>
      <button class="btn btn-success full-width" id="shipBoxBtn">确认发货</button>
    </div>

    <section class="card operational-dashboard" aria-labelledby="shippingDashboardTitle">
      <div class="card-title" id="shippingDashboardTitle">发货看板</div>
      <div class="operations-metrics metrics-four">
        <div class="operations-metric"><strong id="shipDashboardOrders">-</strong><span>发货记录</span></div>
        <div class="operations-metric"><strong id="shipDashboardBoxes">-</strong><span>已发箱数</span></div>
        <div class="operations-metric"><strong id="shipDashboardItems">-</strong><span>产品件数</span></div>
        <div class="operations-metric"><strong id="shipDashboardDistributors">-</strong><span>代理商数</span></div>
      </div>
    </section>

    <!-- 发货记录 -->
    <section class="card data-display-module shipment-records-module">
      <div class="card-title split-title">
        <span>近期发货明细</span>
        <button class="btn btn-outline btn-sm" type="button" id="exportShipBtn"><%- icon('download') %> 导出Excel</button>
      </div>
      <div class="ship-query-grid">
        <div class="form-group">
          <label>订单编号</label>
          <input type="text" id="shipOrderNo" class="form-control" placeholder="如 GD20260901-A（可模糊）">
        </div>
        <div class="form-group">
          <label>代理商</label>
          <select id="shipDistSelect" class="form-control">
            <option value="">全部代理商</option>
            <% distributors.forEach(d => { %>
              <option value="<%= d.id %>"><%= d.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label>发货日期</label>
          <input type="date" id="shipDateInput" class="form-control">
        </div>
        <div class="form-group">
          <label for="shipBoxCodeInput">箱码</label>
          <input type="text" id="shipBoxCodeInput" class="form-control" placeholder="箱码，支持部分匹配">
        </div>
        <div class="form-group">
          <label for="shipItemCodeInput">子码（字码）</label>
          <input type="text" id="shipItemCodeInput" class="form-control" placeholder="子码/字码，支持部分匹配">
        </div>
        <div class="form-group">
          <label>备注</label>
          <input type="text" id="shipRemarkInput" class="form-control" placeholder="备注关键字">
        </div>
      </div>
      <div class="ship-query-actions">
        <button type="button" class="btn btn-primary btn-sm" id="shipQueryBtn">查询</button>
        <button type="button" class="btn btn-outline btn-sm" id="shipResetBtn">重置</button>
        <span class="small-text muted-text" id="shipQuerySummary" aria-live="polite"></span>
      </div>
      <p class="section-help warehouse-help">上面六个条件（订单编号 / 代理商 / 日期 / 箱码 / 子码 / 备注）任填一个或多个，点「查询」按条件检索全部发货记录（不限当天）；导出与当前查询条件一致。</p>
      <div class="table-wrap">
      <table class="table" id="shipTable" style="min-width:900px">
        <thead>
          <tr>
            <th>订单编号</th><th>数量</th><th>产品种类</th><th>代理商</th><th>区域</th><th>操作人</th><th>发货时间</th><th>备注</th><th>码值</th>
          </tr>
        </thead>
        <tbody id="shipBody">
          <tr><td colspan="9" class="empty-cell">加载中...</td></tr>
        </tbody>
      </table>
      </div>
    </section>


  </div>

  <script src="/js/html5-qrcode.min.js"></script>
  <script src="/js/scanner.js?v=20260924b"></script>
  <style nonce="<%= cspNonce %>">
    /* 同商品归组显示；码值明细按需展开，手机端也保持紧凑可操作。 */
    .pending-product-group { padding:12px 8px; border-bottom:1px solid var(--border); }
    .pending-product-group:last-child { border-bottom:0; }
    .pending-product-summary { display:grid; grid-template-columns:minmax(0,1fr) auto auto; gap:12px; align-items:center; }
    .pending-product-name { min-width:0; overflow-wrap:anywhere; font-weight:600; }
    .pending-product-qty { white-space:nowrap; font-variant-numeric:tabular-nums; }
    .pending-codes-details { margin-top:10px; padding:8px 10px; background:var(--surface-subtle,#f6f8f6); border-radius:8px; }
    .pending-code-detail { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; align-items:center; padding:7px 0; border-bottom:1px solid var(--border); }
    .pending-code-detail:last-child { border-bottom:0; }
    .pending-code-value { border:0; padding:4px 0; background:transparent; color:var(--text,#1f2937); text-align:left; text-decoration:underline; text-underline-offset:3px; overflow-wrap:anywhere; }
    .pending-child-codes { grid-column:1 / -1; padding:8px 10px; color:var(--text-2,#6b7280); background:#fff; border-radius:6px; line-height:1.7; overflow-wrap:anywhere; }
    @media (max-width: 600px) { .pending-product-summary { grid-template-columns:minmax(0,1fr) auto; gap:6px 10px; } .pending-product-name { grid-column:1 / -1; } }
  </style>

  <script nonce="<%= cspNonce %>">
    const escapeHtml = value => String(value == null ? '' : value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }

    // 差异化提示音（箱码/子码/重复扫描不同音）
    let _audioCtx = null;
    function vibrate(p) { try { if (navigator.vibrate) navigator.vibrate(p); } catch (e) {} }
    function playBeep(type) {
      let freqA = 880, freqB = 0, total = 0.2, vib = 20;
      if (type === 'box') { freqA = 660; total = 0.16; }
      else if (type === 'item') { freqA = 880; freqB = 1174.66; total = 0.22; }
      else if (type === 'dup') { freqA = 196; freqB = 156.82; total = 0.4; vib = [80,60,80]; }
      else { freqA = 220; total = 0.32; vib = [80,60,80]; }
      vibrate(vib);
      try {
        if (!_audioCtx) _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const ctx = _audioCtx;
        if (ctx.state === 'suspended') ctx.resume();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freqA, now);
        if (freqB) osc.frequency.setValueAtTime(freqB, now + 0.08);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + total);
        osc.start(now); osc.stop(now + total + 0.05);
      } catch (e) {}
    }

    // 待发货清单（累积扫码）
    let pendingCodes = [];
    let shipSubmitting = false;
    const pendingInfo = new Map();   // 码值 → {product_name, product_spec, box_code, quantity, type}
    const expandedPendingGroups = new Set();
    const expandedPendingCodes = new Set();

    // 前置条件：必须先选好代理商 + 填写订单编号，才能启用扫码发货
    function shipReady() {
      const did = document.getElementById('distSelect').value;
      const oid = (document.getElementById('orderNoInput').value || '').trim();
      return !!(did && oid);
    }
    function guideShippingSetup() {
      const distributor = document.getElementById('distSelect');
      const order = document.getElementById('orderNoInput');
      const message = distributor.value ? '请填写订单编号后再发货' : '请先选择代理商并填写订单编号后再发货';
      // 扫码遮罩打开时绝不抢焦点：抢焦点会弹起软键盘并打断摄像头连续扫码
      if (typeof scannerIsOpen === 'function' && scannerIsOpen()) {
        toast(message, 'error');
        return;
      }
      const target = distributor.value ? order : distributor;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => target.focus({ preventScroll: true }), 320);
      toast(message, 'error');
    }
    function updateShipReadyState() {
      const ready = shipReady();
      const input = document.getElementById('boxCode');
      const cam = document.getElementById('openScannerBtn');
      const shipBtn = document.getElementById('shipBoxBtn');
      const setupHint = document.getElementById('shipSetupHint');
      input.removeAttribute('disabled');
      cam.removeAttribute('disabled');
      shipBtn.disabled = shipSubmitting;
      input.setAttribute('aria-disabled', 'false');
      cam.setAttribute('aria-disabled', 'false');
      shipBtn.setAttribute('aria-disabled', 'false');
      cam.classList.toggle('needs-setup', false);
      shipBtn.classList.toggle('needs-setup', !ready);
      if (cancelShipMode) {
        input.placeholder = '扫描 / 输入要取消发货的箱码或子码';
        if (setupHint) setupHint.textContent = '取消发货模式：扫码把码加入待取消清单，扫完点「确认取消发货」。';
      } else {
        input.placeholder = '扫描 / 输入箱码或子码';
        if (setupHint) {
          setupHint.textContent = ready
            ? '收货方与订单号已就绪，可以连续扫码，扫完点「确认发货」。已累积 ' + pendingCodes.length + ' 个码。'
            : '可先连续扫码累积清单（扫码会立即入清单，不再被拦截）；发货前需选择代理商并填写订单编号。已累积 ' + pendingCodes.length + ' 个码。';
        }
      }
      return ready;
    }

    function renderPending() {
      const list = document.getElementById('pendingList');
      const groups = new Map();
      let totalQuantity = 0;
      pendingCodes.forEach((code, index) => {
        const info = pendingInfo.get(code) || {};
        const name = info.product_name || '商品信息待核验';
        const groupKey = info.product_name || `unverified:${code}`;
        const quantity = Number.isFinite(Number(info.quantity)) && Number(info.quantity) >= 0
          ? Number(info.quantity) : 1;
        totalQuantity += quantity;
        if (!groups.has(groupKey)) groups.set(groupKey, { name, specs: new Set(), quantity: 0, entries: [] });
        const group = groups.get(groupKey);
        if (info.product_spec) group.specs.add(info.product_spec);
        group.quantity += quantity;
        group.entries.push({ code, info, index });
      });
      document.getElementById('pendingCount').textContent = totalQuantity;
      if (pendingCodes.length === 0) {
        pendingInfo.clear();   // 清单清空时同步丢弃码信息缓存，避免复扫读到上一次的数据
        list.innerHTML = '<p class="empty-list-state">扫码后自动添加到清单（支持箱码/子码混扫）</p>';
      } else {
        list.innerHTML = [...groups.entries()].map(([key, group], groupIndex) => {
          const expanded = expandedPendingGroups.has(key);
          const specs = [...group.specs];
          const specLabel = specs.length ? `<span class="small-text muted-text">${specs.map(escapeHtml).join(' / ')}</span>` : '';
          const details = expanded ? `<div class="pending-codes-details">${group.entries.map(({ code, info, index }) => {
            const codeExpanded = expandedPendingCodes.has(code);
            const childCodes = Array.isArray(info.child_codes) ? info.child_codes : [];
            const childPanel = codeExpanded
              ? `<div class="pending-child-codes">${childCodes.length
                ? `箱内子码（${childCodes.length}）：${childCodes.map(escapeHtml).join('、')}`
                : (info.type === 'box' ? '该箱当前没有可显示的子码' : `子码：${escapeHtml(code)}`)}</div>`
              : '';
            return `<div class="pending-code-detail">
              <button type="button" class="pending-code-value mono-text" data-code="${escapeHtml(code)}" aria-expanded="${codeExpanded}">${escapeHtml(code)}</button>
              <button type="button" class="btn btn-outline btn-sm remove-pending-btn" data-index="${index}">移除</button>
              ${childPanel}
            </div>`;
          }).join('')}</div>` : '';
          return `<section class="pending-product-group">
            <div class="pending-product-summary">
              <div class="pending-product-name">${escapeHtml(group.name)} ${specLabel}</div>
              <button type="button" class="btn btn-outline btn-sm toggle-pending-group" data-group="${groupIndex}" aria-expanded="${expanded}">${expanded ? '收起码值' : `查看码值（${group.entries.length}）`}</button>
              <strong class="pending-product-qty">数量 ${group.quantity}</strong>
            </div>${details}
          </section>`;
        }).join('');
        list.dataset.groupKeys = JSON.stringify([...groups.keys()]);
      }
    }

    // 已入库的装箱子码可以按单件发货，但同一单不能同时提交母箱码和子码。
    async function addPending(rawCode) {
      const code = extractCode(rawCode);
      if (!code) return;
      // 去重
      if (pendingCodes.includes(code)) {
        playBeep('dup');
        toast('该码已在清单中', 'error');
        return;
      }
      // 校验：子码已绑定箱码时，提示扫描箱码而非子码
      try {
        const resp = await fetch('/api/warehouse/code-info?code=' + encodeURIComponent(code));
        const info = await resp.json();
        if (!info.success) {
          playBeep('error');
          toast(info.msg || '码不存在', 'error');
          return;
        }
        if (info.type === 'item' && info.bound_to_box && pendingCodes.includes(info.box_code)) {
          playBeep('error');
          toast('清单已有该子码所属箱码，请移除箱码后再按单件发货', 'error');
          return;
        }
        if (info.type === 'box' && pendingCodes.some(c => pendingInfo.get(c)?.box_code === code && c !== code)) {
          playBeep('error');
          toast('清单已有该箱的子码，请移除子码后再整箱发货', 'error');
          return;
        }
        // 清单要显示商品名称/箱码/数量，这里把校验拿到的信息一并缓存
        pendingInfo.set(code, info);
      } catch (e) {
        // 网络异常时降级：允许加入，由发货时二次校验
        console.warn('码校验请求失败，降级处理', e);
      }
      pendingCodes.push(code);
      renderPending();
      // 箱码/子码不同提示音
      playBeep(/^B/i.test(code) ? 'box' : 'item');
      const bound = pendingInfo.get(code)?.type === 'item' && pendingInfo.get(code)?.bound_to_box;
      toast(bound ? '已添加装箱子码：将按 1 件发货，原箱不能同时整箱发货' : '已添加：' + code, 'success');
      updateShipReadyState();   // 常驻提示实时反映清单数量
    }

    // 回车：普通模式累积到清单，取消发货模式则执行取消
    document.getElementById('boxCode').addEventListener('keypress', e => {
      if (e.key === 'Enter') {
        const v = document.getElementById('boxCode').value;
        if (!v) return;
        document.getElementById('boxCode').value = '';
        if (cancelShipMode) void cancelShip(v);
        else addPending(v);
      }
    });
    document.getElementById('openScannerBtn').addEventListener('click', () => {
      // 不再拦截：先扫后填代理商/订单号是允许的，缺条件时由常驻提示与发货校验兜底
      if (!cancelShipMode && !shipReady()) updateShipReadyState();
      openScanner({ title: '连续扫描箱码或子码', continuous: true, onScanned: scanBoxCode });
    });
    document.getElementById('shipBoxBtn').addEventListener('click', batchShip);
    // 前置条件：代理商 / 订单编号变化时刷新扫码按钮可用状态
    document.getElementById('distSelect').addEventListener('change', updateShipReadyState);
    document.getElementById('orderNoInput').addEventListener('input', updateShipReadyState);

    // 手机扫码回调：连续扫码，扫到直接进清单（取消模式下则退货）
    function scanBoxCode(code) {
      if (cancelShipMode) void cancelShip(code);
      else addPending(code);
    }

    // ---- 订单编号扫码 / 扫码枪输入 ----
    // 扫到订单号即填入并与历史发货记录比对收货方，供人工确认（不自动改写代理商）
    function applyOrderNo(value) {
      const v = String(value == null ? '' : value).trim();
      if (!v) return;
      document.getElementById('orderNoInput').value = v;
      const hint = document.getElementById('orderNoHint');
      const previous = (typeof allShipments !== 'undefined' ? allShipments : [])
        .filter(s => String(s.order_no || '') === v);
      if (previous.length && previous[0].distributor_name) {
        if (hint) hint.textContent = '历史订单「' + v + '」上次收货方：' + previous[0].distributor_name + '，请确认「选择代理商」是否一致。';
        toast('订单号已填入；历史收货方：' + previous[0].distributor_name, 'success');
      } else if (previous.length) {
        if (hint) hint.textContent = '订单号已填入（历史记录未标记收货方）。';
        toast('订单编号已填入：' + v, 'success');
      } else {
        if (hint) hint.textContent = '订单号已填入，历史记录中暂无该订单号。';
        toast('订单编号已填入：' + v, 'success');
      }
      updateShipReadyState();
    }
    const orderScanBtn = document.getElementById('orderScanBtn');
    if (orderScanBtn) {
      orderScanBtn.addEventListener('click', () => {
        openScanner({ title: '请扫描订单编号条码', raw: true, onScanned: applyOrderNo });
      });
    }
    // 扫码枪/PDA：订单号框内回车即确认填入
    document.getElementById('orderNoInput').addEventListener('keypress', e => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      applyOrderNo(document.getElementById('orderNoInput').value);
    });

    // 移除/清空
    document.getElementById('pendingList').addEventListener('click', e => {
      const groupToggle = e.target.closest('.toggle-pending-group');
      if (groupToggle) {
        const keys = JSON.parse(document.getElementById('pendingList').dataset.groupKeys || '[]');
        const key = keys[Number(groupToggle.dataset.group)];
        if (key != null) {
          if (expandedPendingGroups.has(key)) expandedPendingGroups.delete(key);
          else expandedPendingGroups.add(key);
          renderPending();
        }
        return;
      }
      const codeToggle = e.target.closest('.pending-code-value');
      if (codeToggle) {
        const code = codeToggle.dataset.code;
        if (expandedPendingCodes.has(code)) expandedPendingCodes.delete(code);
        else expandedPendingCodes.add(code);
        renderPending();
        return;
      }
      const btn = e.target.closest('.remove-pending-btn');
      if (!btn) return;
      const idx = parseInt(btn.dataset.index);
      pendingCodes.splice(idx, 1);
      renderPending();
      updateShipReadyState();
    });
    document.getElementById('clearPendingBtn').addEventListener('click', () => {
      pendingCodes = [];
      renderPending();
      updateShipReadyState();
    });

    // 批量发货
    async function batchShip() {
      if (shipSubmitting) return;
      const distributor_id = document.getElementById('distSelect').value;
      const order_no = document.getElementById('orderNoInput').value;
      const remark = document.getElementById('remarkInput').value;
      if (!pendingCodes.length) return toast('请先扫码添加要发货的码', 'error');
      if (!distributor_id) return toast('请选择代理商', 'error');
      if (!order_no.trim()) return toast('请填写订单编号', 'error');

      shipSubmitting = true;
      updateShipReadyState();
      try {
        const res = await fetch('/api/shipments/batch-ship', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({codes: pendingCodes, distributor_id, order_no, remark})
        });
        const data = await res.json();
        if (!Array.isArray(data.shipped) || !Array.isArray(data.failed)) {
          return toast(data.msg || '发货结果未确认，清单已保留，请核对记录后再试', 'error');
        }
        // 只移除服务器明确返回成功的码，失败码仍留在待发货清单中。
        const shippedSet = new Set(data.shipped.map(row => row.code));
        pendingCodes = pendingCodes.filter(code => !shippedSet.has(code));
        renderPending();
        if (data.shipped.length) loadShipments();
        if (data.failed.length) {
          toast(`成功 ${data.shipped.length} 个，失败 ${data.failed.length} 个；失败码已保留`, 'error');
          alert(`发货结果：\n成功 ${data.shipped.length} 个，失败 ${data.failed.length} 个\n\n${data.failed.map(f => f.code + '：' + f.msg).join('\n')}\n\n失败码已保留在待发货清单。`);
        } else if (res.ok && data.success) {
          toast(data.msg, 'success');
          document.getElementById('boxCode').value = '';
        } else {
          toast(data.msg || '发货失败，清单已保留', 'error');
        }
      } catch (_error) {
        toast('网络中断，待发货清单已保留。请先核对发货记录，避免重复提交', 'error');
      } finally {
        shipSubmitting = false;
        updateShipReadyState();
      }
    }

    // ---- 取消发货（发错代理/扫错码时退回在库） ----
    let cancelShipMode = false;
    const cancelShipStorageKey = 'reliacode:cancel-ship:<%= user.id %>';
    let cancelShipCodes = (() => {
      try { const saved = JSON.parse(sessionStorage.getItem(cancelShipStorageKey) || '[]'); return Array.isArray(saved) ? saved.filter(code => typeof code === 'string' && /^[BS][A-Z0-9]+$/.test(code)).slice(0, 200) : []; }
      catch (_error) { return []; }
    })(); // 刷新后保留未核实的取消清单
    function renderCancelShip() {
      try { sessionStorage.setItem(cancelShipStorageKey, JSON.stringify(cancelShipCodes)); } catch (_error) {}
      const list = document.getElementById('cancelShipList');
      document.getElementById('cancelShipCount').textContent = cancelShipCodes.length;
      if (cancelShipCodes.length === 0) {
        list.innerHTML = '<p class="empty-list-state">扫码后自动累积到清单（支持箱码/子码混扫）</p>';
      } else {
        list.innerHTML = cancelShipCodes.map((c, i) => `
          <div class="pending-ship-row">
            <span class="code-cell">${escapeHtml(c)}</span>
            <button type="button" class="btn btn-outline btn-sm remove-cancel-ship-btn" data-index="${i}">移除</button>
          </div>
        `).join('');
      }
    }
    renderCancelShip();
    // 取消发货模式下扫码：累积到待取消清单（不立即执行）
    const checkingCancelShip = new Set();
    async function cancelShip(code) {
      if (cancelShipCodes.includes(code)) {
        playBeep('dup');
        toast('该码已在待取消清单中', 'error');
        return;
      }
      if (checkingCancelShip.has(code)) return;
      checkingCancelShip.add(code);
      try {
        const response = await fetch(`/api/codes/reversal-state?kind=shipment&code=${encodeURIComponent(code)}`);
        const state = await response.json();
        if (!response.ok || !state.success) throw new Error(state.msg || '无法核对码状态');
        if (state.settled) {
          playBeep('dup');
          toast('该码当前没有待取消的发货记录', 'error');
          return;
        }
      } catch (error) {
        playBeep('error');
        toast((error && error.message) || '状态核对失败，请联网后重试', 'error');
        return;
      } finally {
        checkingCancelShip.delete(code);
      }
      cancelShipCodes.push(code);
      renderCancelShip();
      playBeep(/^B/i.test(code) ? 'box' : 'item');
      toast('已添加待取消：' + code, 'success');
    }
    // 单个码真正执行取消发货
    async function doCancelShipOne(code) {
      return cancelCodeWithReconciliation(code, '/api/shipments/cancel', 'shipment');
    }
    // 二次确认后批量取消发货
    async function confirmCancelShip() {
      if (!cancelShipCodes.length) return toast('请先扫码添加要取消发货的码', 'error');
      showCancelConfirm(
        '确认取消发货',
        `即将取消发货 <b>${cancelShipCodes.length}</b> 个码（已发货码退回在库）：`,
        cancelShipCodes.slice(),
        async () => {
          const codes = cancelShipCodes.slice();
          const results = [];
          for (const code of codes) {
            results.push(await doCancelShipOne(code));
          }
          const ok = results.filter(r => r.success).length;
          const fail = results.filter(r => !r.success).length;
          if (fail) {
            playBeep('err');
            toast(`取消完成：成功 ${ok} 个，失败 ${fail} 个：${results.filter(r=>!r.success).map(r=>r.code+'：'+r.msg).join('；')}`, 'error');
          } else {
            playBeep('dup');
            toast(`已取消发货 ${ok} 个`, 'success');
          }
          cancelShipCodes = results.filter(result => !result.success).map(result => result.code);
          renderCancelShip();
          loadShipments();
        }
      );
    }
    document.getElementById('cancelShipBtn').addEventListener('click', () => {
      cancelShipMode = !cancelShipMode;
      const btn = document.getElementById('cancelShipBtn');
      const hint = document.getElementById('cancelShipHint');
      const input = document.getElementById('boxCode');
      const panel = document.getElementById('cancelShipPanel');
      if (cancelShipMode) {
        btn.textContent = '退出取消发货';
        panel.classList.remove('is-hidden');
        input.placeholder = '扫箱码/子码 加入取消清单…';
        hint.textContent = '已开启取消发货：扫码把码加入待取消清单，扫完点「确认取消发货」二次确认后执行';
        hint.classList.remove('is-hidden');
        toast('已开启取消发货模式，扫码累积清单', 'success');
      } else {
        btn.textContent = '取消发货';
        panel.classList.add('is-hidden');
        input.placeholder = '扫描 / 输入箱码或子码';
        hint.textContent = '';
        hint.classList.add('is-hidden');
      }
      updateShipReadyState();
      input.focus();
    });
    document.getElementById('confirmCancelShipBtn').addEventListener('click', confirmCancelShip);
    document.getElementById('clearCancelShipBtn').addEventListener('click', () => { cancelShipCodes = []; renderCancelShip(); });
    document.getElementById('cancelShipList').addEventListener('click', e => {
      const b = e.target.closest('.remove-cancel-ship-btn');
      if (!b) return;
      cancelShipCodes.splice(parseInt(b.dataset.index), 1);
      renderCancelShip();
    });

    // 缓存的发货记录 + 订单号搜索
    let allShipments = [];

    function updateShipDashboard(list) {
      const rows = Array.isArray(list) ? list : [];
      const number = value => Number(value) || 0;
      // 适配新的订单聚合结构
      const boxes = rows.reduce((sum, row) => sum + number(row.total_box_qty || row.box_qty), 0);
      const items = rows.reduce((sum, row) => sum + number(row.total_product_qty || row.product_qty), 0);
      const distributors = new Set(rows.map(row => row.distributor_name).filter(Boolean));
      document.getElementById('shipDashboardOrders').textContent = rows.length;
      document.getElementById('shipDashboardBoxes').textContent = boxes;
      document.getElementById('shipDashboardItems').textContent = items;
      document.getElementById('shipDashboardDistributors').textContent = distributors.size;
    }

    // 逐级追溯树：订单/产品 → 箱（→箱内子码）+ 散件
    function renderCodeTree(g) {
      const boxes = g.boxes || [];
      const loose = g.loose_items || [];
      // 旧数据兼容：若后端没返回 boxes/loose_items，则回退用 codes 扁平展示
      const hasTree = boxes.length || loose.length;
      if (!hasTree) {
        if (g.codes && g.codes.length) {
          return g.codes.map(c => `<span class="tag ${c.type === 'box' ? 'tag-green' : 'tag-yellow'}">${c.type === 'box' ? '箱' : '散'}</span> <span class="code-cell">${escapeHtml(c.code)}</span>`).join('<br>');
        }
        return '<span class="muted-text">无码值</span>';
      }
      const parts = [];
      // 整箱明细：每箱可展开子码
      if (boxes.length) {
        parts.push('<div class="ship-tree-section"><div class="ship-tree-section-title">📦 整箱（' + boxes.length + ' 箱）</div>');
        const boxRows = boxes.map((b, bi) => {
          const codes = (b.item_codes || []).map(escapeHtml);
          const codesHtml = codes.length
            ? codes.map(c => `<span class="code-chip">${c}</span>`).join('')
            : '<span class="muted-text">（无子码）</span>';
          return `<div class="ship-box-row">
            <div class="ship-box-head" data-box="${bi}">
              <span class="chevron">▸</span>
              <span class="code-cell bold-text">${escapeHtml(b.box_code)}</span>
              <span class="small-text muted-text">${Number(b.item_count) || 0} 个子码</span>
            </div>
            <div class="ship-box-body is-hidden" id="shipBoxBody_${bi}"><div class="ship-box-codes">${codesHtml}</div></div>
          </div>`;
        }).join('');
        parts.push(boxRows);
        parts.push('</div>');
      }
      // 散件明细
      if (loose.length) {
        parts.push('<div class="ship-tree-section"><div class="ship-tree-section-title">📎 散件（' + loose.length + ' 件）</div>');
        parts.push(loose.map(l => `<span class="tag tag-yellow">散</span> <span class="code-cell">${escapeHtml(l.item_code)}</span>`).join('<br>'));
        parts.push('</div>');
      }
      return parts.join('');
    }

    // 需求 #6: 按订单编号聚合显示，点击订单号展开查看该订单下所有产品明细
    function renderShipments(list) {
      const body = document.getElementById('shipBody');
      if (!list || list.length === 0) {
        body.innerHTML = '<tr><td colspan="9" class="empty-cell">暂无发货记录</td></tr>';
        return;
      }
      body.innerHTML = list.map((g, idx) => {
        const productSummary = g.items && g.items.length
          ? g.items.map(p => escapeHtml(p.product_name) + (p.product_spec ? '（' + escapeHtml(p.product_spec) + '）' : '') + ' ×' + (p.product_qty || 0)).join('、')
          : '-';
        const totalQty = (g.total_product_qty || 0) + ' 件';
        const totalBoxes = (g.total_box_qty || 0) ? (g.total_box_qty + ' 箱') : '';
        return `
        <tr class="ship-group-row ship-order-row" data-order="${idx}" style="cursor:pointer">
          <td><b class="order-toggle-icon">▸</b> <b class="code-cell">${escapeHtml(g.order_no || '-')}</b></td>
          <td>${totalQty}${totalBoxes ? ' / ' + totalBoxes : ''}</td>
          <td>${g.product_count || 0} 种产品</td>
          <td>${escapeHtml(g.distributor_name || '-')}</td>
          <td>${escapeHtml(g.distributor_region || '-')}</td>
          <td>${escapeHtml(g.operator || '-')}</td>
          <td class="meta-cell">${escapeHtml(g.shipped_at || '-')}</td>
          <td>${escapeHtml(g.remark || '-')}</td>
          <td>
            <button type="button" class="btn btn-outline btn-sm toggle-codes-btn" data-order="${idx}">码值（${g.all_codes ? g.all_codes.length : 0}）</button>
          </td>
        </tr>
        <tr class="ship-order-detail is-hidden" id="orderDetail_${idx}">
          <td colspan="9" style="padding:0">
            <table class="table">
              <thead><tr><th>产品名称</th><th>规格</th><th>数量</th><th>箱数</th><th>批次</th><th>码值</th></tr></thead>
              <tbody>
                ${(g.items || []).map((p, pi) => `
                  <tr>
                    <td><b>${escapeHtml(p.product_name)}</b></td>
                    <td>${escapeHtml(p.product_spec || '-')}</td>
                    <td>${p.product_qty || 0} 件</td>
                    <td>${p.box_qty || 0} 箱</td>
                    <td>${escapeHtml(p.batch_no || '-')}</td>
                    <td>
                      <button type="button" class="btn btn-outline btn-sm toggle-product-codes" data-order="${idx}" data-product="${pi}">码值（${p.codes ? p.codes.length : 0}）</button>
                    </td>
                  </tr>
                  <tr class="ship-product-codes is-hidden" id="productCodes_${idx}_${pi}">
                    <td colspan="6" class="ship-codes-cell" style="padding:8px 16px"></td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </td>
        </tr>`;
      }).join('');

      // 订单行点击展开/收起
      body.querySelectorAll('.ship-order-row').forEach(row => {
        row.addEventListener('click', (e) => {
          if (e.target.closest('button')) return;
          const idx = row.dataset.order;
          const detail = document.getElementById('orderDetail_' + idx);
          const icon = row.querySelector('.order-toggle-icon');
          if (!detail) return;
          detail.classList.toggle('is-hidden');
          if (icon) icon.textContent = detail.classList.contains('is-hidden') ? '▸' : '▾';
        });
      });

      // 码值按钮：订单级别
      body.querySelectorAll('.toggle-codes-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = btn.dataset.order;
          const g = list[idx];
          const detail = document.getElementById('orderDetail_' + idx);
          if (detail && detail.classList.contains('is-hidden')) {
            detail.classList.remove('is-hidden');
            const row = body.querySelector('[data-order="' + idx + '"]');
            const icon = row ? row.querySelector('.order-toggle-icon') : null;
            if (icon) icon.textContent = '▾';
          }
          if (g && g.items) {
            g.items.forEach((p, pi) => {
              const codesRow = document.getElementById('productCodes_' + idx + '_' + pi);
              if (codesRow && codesRow.classList.contains('is-hidden')) {
                codesRow.classList.remove('is-hidden');
                const cell = codesRow.querySelector('.ship-codes-cell');
                if (cell) cell.innerHTML = renderProductCodeTree(p);
              }
            });
          }
          btn.textContent = btn.textContent.includes('收起') ? '码值（' + (g.all_codes ? g.all_codes.length : 0) + '）' : '收起码值';
        });
      });

      // 码值按钮：产品级别
      body.querySelectorAll('.toggle-product-codes').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const oi = btn.dataset.order;
          const pi = btn.dataset.product;
          const g = list[oi];
          const p = g && g.items && g.items[pi];
          const codesRow = document.getElementById('productCodes_' + oi + '_' + pi);
          if (!codesRow || !p) return;
          if (codesRow.classList.contains('is-hidden')) {
            codesRow.classList.remove('is-hidden');
            const cell = codesRow.querySelector('.ship-codes-cell');
            if (cell) cell.innerHTML = renderProductCodeTree(p);
            btn.textContent = '收起码值';
          } else {
            codesRow.classList.add('is-hidden');
            btn.textContent = '码值（' + (p.codes ? p.codes.length : 0) + '）';
          }
        });
      });
    }

    // 产品级别的码值树渲染
    function renderProductCodeTree(p) {
      const boxes = p.boxes || [];
      const loose = p.loose_items || [];
      const hasTree = boxes.length || loose.length;
      if (!hasTree) {
        if (p.codes && p.codes.length) {
          return p.codes.map(c => '<span class="tag ' + (c.type === 'box' ? 'tag-green' : 'tag-yellow') + '">' + (c.type === 'box' ? '箱' : '散') + '</span> <span class="code-cell">' + escapeHtml(c.code) + '</span>').join('<br>');
        }
        return '<span class="muted-text">无码值</span>';
      }
      const parts = [];
      if (boxes.length) {
        parts.push('<div class="ship-tree-section"><div class="ship-tree-section-title">📦 整箱（' + boxes.length + ' 箱）</div>');
        parts.push(boxes.map((b, bi) => {
          const codes = (b.item_codes || []).map(escapeHtml);
          const codesHtml = codes.length
            ? codes.map(c => '<span class="code-chip">' + c + '</span>').join('')
            : '<span class="muted-text">（无子码）</span>';
          return '<div class="ship-box-row"><div class="ship-box-head" data-box="p_' + bi + '"><span class="chevron">▸</span> <span class="code-cell bold-text">' + escapeHtml(b.box_code) + '</span> <span class="small-text muted-text">' + (Number(b.item_count) || 0) + ' 个子码</span></div><div class="ship-box-body is-hidden" id="shipBoxBody_p_' + bi + '"><div class="ship-box-codes">' + codesHtml + '</div></div></div>';
        }).join(''));
        parts.push('</div>');
      }
      if (loose.length) {
        parts.push('<div class="ship-tree-section"><div class="ship-tree-section-title">📎 散件（' + loose.length + ' 件）</div>');
        parts.push(loose.map(l => '<span class="tag tag-yellow">散</span> <span class="code-cell">' + escapeHtml(l.item_code) + '</span>').join('<br>'));
        parts.push('</div>');
      }
      return parts.join('');
    }

    // ---- 近期发货明细：服务端多条件查询（订单编号 / 代理商 / 日期 / 码值 / 备注，任选其一） ----
    function shipQueryParams() {
      const params = new URLSearchParams();
      const put = (key, value) => { const v = String(value == null ? '' : value).trim(); if (v) params.set(key, v); };
      put('order_no', document.getElementById('shipOrderNo').value);
      put('distributor_id', document.getElementById('shipDistSelect').value);
      put('date', document.getElementById('shipDateInput').value);
      put('box_code', document.getElementById('shipBoxCodeInput').value);
      put('item_code', document.getElementById('shipItemCodeInput').value);
      put('remark', document.getElementById('shipRemarkInput').value);
      return params;
    }

    function shipQuerySummaryText(count) {
      const labels = [];
      const params = shipQueryParams();
      if (params.get('order_no')) labels.push('订单编号「' + params.get('order_no') + '」');
      if (params.get('distributor_id')) {
        const sel = document.getElementById('shipDistSelect');
        const text = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].textContent : '';
        labels.push('代理商「' + text + '」');
      }
      if (params.get('date')) labels.push('日期' + params.get('date'));
      if (params.get('box_code')) labels.push('箱码「' + params.get('box_code') + '」');
      if (params.get('item_code')) labels.push('子码「' + params.get('item_code') + '」');
      if (params.get('remark')) labels.push('备注「' + params.get('remark') + '」');
      const scope = labels.length ? '（条件：' + labels.join('、') + '）' : '（未加条件，显示最近 500 条发货明细）';
      return '共 ' + count + ' 条发货明细' + scope;
    }

    async function loadShipments() {
      const qs = shipQueryParams().toString();
      let data;
      try {
        const res = await fetch('/api/shipments' + (qs ? '?' + qs : ''));
        data = await res.json();
      } catch (e) {
        data = { success: false };
      }
      const summary = document.getElementById('shipQuerySummary');
      if (!data.success) {
        updateShipDashboard([]);
        renderShipments([]);
        if (summary) summary.textContent = '查询失败，请稍后重试';
        return;
      }
      // 以「产品名称」为主要登记依据的聚合明细（groups），未返回时回退用原始明细聚合
      allShipments = data.groups || data.shipments || [];
      updateShipDashboard(allShipments);
      renderShipments(allShipments);
      if (summary) summary.textContent = shipQuerySummaryText(allShipments.length);
    }

    const shipQueryBtn = document.getElementById('shipQueryBtn');
    if (shipQueryBtn) shipQueryBtn.addEventListener('click', loadShipments);
    const shipResetBtn = document.getElementById('shipResetBtn');
    if (shipResetBtn) {
      shipResetBtn.addEventListener('click', () => {
        ['shipOrderNo', 'shipDateInput', 'shipBoxCodeInput', 'shipItemCodeInput', 'shipRemarkInput'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.value = '';
        });
        const dist = document.getElementById('shipDistSelect');
        if (dist) dist.value = '';
        loadShipments();
      });
    }
    // 日期选择后立即查询；其余文本条件回车即查询
    document.getElementById('shipDateInput').addEventListener('change', loadShipments);
    ['shipOrderNo', 'shipBoxCodeInput', 'shipItemCodeInput', 'shipRemarkInput'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('keypress', e => { if (e.key === 'Enter') { e.preventDefault(); loadShipments(); } });
    });
    const shipDistSelect = document.getElementById('shipDistSelect');
    if (shipDistSelect) shipDistSelect.addEventListener('change', loadShipments);

    // 导出 Excel：与当前列表筛选（日期 + 搜索词）同范围、同口径，实时取最新发货明细
    document.getElementById('exportShipBtn').addEventListener('click', () => {
      const btn = document.getElementById('exportShipBtn');
      if (btn.disabled) return;
      const params = shipQueryParams();
      const qs = params.toString();
      // 导出加载中：禁用按钮防重复点击，完成/出错后恢复
      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '⏳ 生成中…';
      const restore = () => { btn.disabled = false; btn.innerHTML = originalHtml; };
      const url = '/api/export/shipments' + (qs ? '?' + qs : '');
      // 用 fetch 流式下载，可监听完成事件；失败时回退为直接跳转
      fetch(url, { credentials: 'same-origin' })
        .then(resp => {
          if (!resp.ok) { throw new Error('HTTP ' + resp.status); }
          return resp.blob();
        })
        .then(blob => {
          if (blob.type && blob.type.includes('spreadsheet')) {
            const a = document.createElement('a');
            const objUrl = URL.createObjectURL(blob);
            a.href = objUrl;
            a.download = '发货记录.xlsx';
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(objUrl);
            toast('导出成功', 'success');
          } else {
            // 服务端可能返回错误 JSON 而非文件，回退直接跳转
            window.location.href = url;
          }
          restore();
        })
        .catch(() => {
          // 网络/流式失败：回退为直接导航下载，确保能导出
          restore();
          window.location.href = url;
        });
    });

    loadShipments();
    // 扫码始终可用（不再静默拒绝）；代理商/订单编号在发货时统一校验
    updateShipReadyState();
  </script>
</body>
</html>
