<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('partials/boot-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 工厂装箱 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260924a">
  <style nonce="<%= cspNonce %>">
    .state-idle, .state-packing, .state-full { color:#000; }
    .big-status {
      font-size:20px; font-weight:bold; text-align:center; padding:10px;
      border-radius:8px; margin-bottom:12px;
    }
    .big-idle, .big-packing, .big-full, .big-error, .big-select { background:#fff; color:#000; border:1px solid #000; }
    .pending-stock-row { display:grid; grid-template-columns:minmax(0,1fr) auto auto; gap:12px; align-items:center; padding:12px 8px; border-bottom:1px solid var(--border); }
    .pending-stock-row:last-child { border-bottom:0; }
    .pending-stock-main { display:grid; gap:5px; min-width:0; }
    .pending-stock-main strong { overflow-wrap:anywhere; }
    .pending-stock-main code { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; overflow-wrap:anywhere; }
    .pending-stock-quantity { white-space:nowrap; color:var(--text-light); }
    @media(max-width:520px) { .pending-stock-row { grid-template-columns:minmax(0,1fr) auto; gap:8px; } .pending-stock-quantity { grid-column:1; } .pending-stock-row > button { grid-column:2; grid-row:1 / span 2; } }
  </style>
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260922a">
</head>
<body>
  <%- include('partials/boot-loader') %>
  <%- include('partials/nav', { active: 'factory' }) %>

  <div class="container">
    <header class="page-heading">
      <h1>工厂装箱</h1>
      <p>扫码绑定箱码与子码，扫满的箱码进入待入库清单，核对后可批量确认入库。</p>
    </header>

    <div class="card">
      <div class="card-title">工厂装箱</div>
      <p class="section-help">
        一个框连续扫：<strong>扫箱码（B开头）</strong> → <strong>选产品+箱规</strong> → <strong>逐个扫子码（S开头）</strong> → <strong>扫满后自动加入待入库清单</strong> → 扫下一箱，最后核对清单并统一确认入库。确认前不计入库存。产品不符、重复扫、多扫都会拦截。<br>
        点<strong>「连续扫码」</strong>后摄像头保持常开：子码一个接一个扫，中途不用再点按钮；本箱扫满后直接把摄像头对准下一个箱码即可开新箱。
        扫错时可进入<strong>取消入库</strong>模式；无需箱码的货品可选择产品后进入<strong>无箱码入库</strong>模式。
      </p>

      <!-- 大状态条 -->
      <div id="bigStatus" class="big-status big-idle">请扫描箱码开始装箱</div>

      <!-- 唯一扫码输入框 -->
      <div class="scan-box">
        <div class="scan-hero-icon" id="scanIcon"><%- icon('box', 'ui-icon-lg') %></div>
        <div class="factory-scan-row">
          <label for="scanInput" class="sr-only">扫描箱码或子码</label>
          <input type="text" id="scanInput" class="form-control scan-box-input flex-1"
            placeholder="扫箱码(B开头) / 扫子码(S开头)" autocomplete="off">
          <button id="cameraScanBtn" type="button" class="btn btn-outline no-wrap"><%- icon('camera') %> 连续扫码</button>
        </div>
      </div>

      <!-- 取消入库入口 -->
      <div class="form-group">
        <button id="cancelStockBtn" type="button" class="btn btn-outline btn-sm"><%- icon('refresh') %> 取消入库</button>
        <span class="mode-status is-hidden" id="cancelStockHint" aria-live="polite"></span>
      </div>
      <!-- 待取消入库清单 + 确认按钮（取消入库模式下显示） -->
      <div class="form-group is-hidden" id="cancelStockPanel">
        <div class="split-title">
          <label>待取消入库清单（<span id="cancelStockCount">0</span> 项）</label>
          <button type="button" class="btn btn-outline btn-sm" id="clearCancelStockBtn">清空</button>
        </div>
        <div id="cancelStockList" class="pending-ship-list">
          <p class="empty-list-state">扫码后自动累积到清单（支持箱码/子码混扫）</p>
        </div>
        <button type="button" class="btn btn-primary btn-sm mt-12" id="confirmCancelStockBtn"><%- icon('check') %> 确认取消入库</button>
      </div>

      <!-- 无箱码入库入口：扫码只加入待确认清单，确认后才计入库存。 -->
      <div class="form-group">
        <button id="noBoxModeBtn" type="button" class="btn btn-outline btn-sm"><%- icon('check') %> 无箱码入库</button>
        <span class="mode-status is-hidden" id="noBoxModeHint" aria-live="polite"></span>
      </div>
      <!-- 无箱码入库会话统计 -->
      <div id="noBoxStats" class="form-group is-hidden">
        <span class="muted-supporting-text">本次已确认入库：<strong id="noBoxCount">0</strong> 个</span>
      </div>

      <section class="card is-hidden" id="pendingNoBoxPanel" aria-labelledby="pendingNoBoxTitle">
        <div class="card-title split-title">
          <span id="pendingNoBoxTitle">无箱码待入库清单（<span id="pendingNoBoxCount">0</span> 个）</span>
          <button id="refreshPendingNoBoxBtn" class="btn btn-outline btn-sm" type="button">刷新清单</button>
        </div>
        <div id="pendingNoBoxList" class="pending-ship-list" aria-live="polite">
          <p class="empty-list-state">请先选择产品和批次，再扫描子码。</p>
        </div>
        <p class="form-help">箱码显示“无箱码”；确认前仅保存在待入库清单，不计入库存，也不能发货。</p>
        <button id="confirmPendingNoBoxBtn" class="btn btn-success full-width mt-12" type="button" disabled>确认入库</button>
      </section>

      <!-- 选择产品面板（打开页面即可预先选择，扫码后自动沿用） -->
      <div id="productPanel" class="product-selection-panel">
        <div class="font-bold mb-10"><%- icon('cart') %> 选择产品和箱规<span id="productPanelBox" class="product-panel-code"></span></div>
        <div class="product-selection-grid">
          <div class="form-group mb-0 is-hidden" id="selFactoryGroup">
            <label class="text-13" for="selFactory">生产工厂 <span class="required-mark">*</span></label>
            <select id="selFactory" class="form-control"><option value="">加载中...</option></select>
          </div>
          <div class="form-group mb-0 is-hidden" id="selBrandGroup">
            <label class="text-13" for="selBrand">品牌</label>
            <select id="selBrand" class="form-control"><option value="">加载中...</option></select>
          </div>
          <div class="form-group mb-0">
            <label class="text-13" for="selProduct">产品</label>
            <select id="selProduct" class="form-control"><option value="">加载中...</option></select>
          </div>
          <div class="form-group mb-0">
            <label class="text-13" for="selBoxSize">箱规（每箱几个）</label>
            <input type="number" id="selBoxSize" class="form-control" min="1" placeholder="选产品后自动带出">
          </div>
          <div class="form-group mb-0">
            <label class="text-13" for="selBatch">批次号 <span class="required-mark">*</span></label>
            <input type="text" id="selBatch" class="form-control" placeholder="必填，如：20260829">
          </div>
        </div>
        <div class="flex-actions-wrap">
          <button id="confirmProductBtn" class="btn btn-primary" type="button"><%- icon('check') %> 确认产品/箱规/批次，启用扫码</button>
          <button id="cancelProductBtn" class="btn btn-outline" type="button">取消</button>
        </div>
      </div>

      <!-- 当前箱信息 -->
      <div id="boxPanel" class="box-panel is-hidden">
        <!-- 箱信息 -->
        <div class="box-summary">
          <div class="box-summary-grid">
            <div>
              <div class="small-text muted-text">箱码</div>
              <div id="curBoxCode" class="mono-text font-bold"></div>
            </div>
            <div>
              <div class="small-text muted-text">产品</div>
              <div id="curProduct"></div>
            </div>
            <div>
              <div class="small-text muted-text">批次</div>
              <div id="curBatch"></div>
            </div>
            <div>
              <div class="small-text muted-text">箱规（可改）</div>
              <div class="box-size-editor">
                <label for="boxSizeInput" class="sr-only">当前箱规</label>
                <input type="number" id="boxSizeInput" class="form-control compact-number-input" min="1">
                <button id="applyBoxSizeBtn" class="btn btn-outline btn-sm" type="button">改</button>
              </div>
            </div>
            <div>
              <div class="small-text muted-text">&nbsp;</div>
              <button id="changeProductBtn" class="btn btn-outline btn-sm" type="button"><%- icon('refresh') %> 换产品</button>
            </div>
          </div>
        </div>

        <!-- 进度 -->
        <div class="progress-heading">
          <span class="font-bold">装箱进度</span>
          <span id="progressText" class="progress-text">0 / 0</span>
        </div>
        <progress id="progressBar" class="packing-progress" value="0" max="1">0%</progress>

        <!-- 已绑子码列表 -->
        <div class="font-bold mb-8">已绑子码 (<span id="boundCount">0</span>)</div>
        <div id="itemList" class="packed-item-list">
          <p class="empty-list-state">暂无子码</p>
        </div>
      </div>
    </div>

    <section class="card is-hidden" id="pendingStockPanel" aria-labelledby="pendingStockTitle">
      <div class="card-title split-title">
        <span id="pendingStockTitle">待入库清单（<span id="pendingStockCount">0</span> 箱）</span>
        <button id="refreshPendingStockBtn" class="btn btn-outline btn-sm" type="button">刷新清单</button>
      </div>
      <div id="pendingStockList" class="pending-ship-list" aria-live="polite">
        <p class="empty-list-state">正在读取待入库箱码…</p>
      </div>
      <p class="form-help" id="pendingStockHelp">清单仅包含已扫满的箱码。移除只会从本次确认清单中排除，码仍保持待入库，可刷新后重新加入。</p>
      <button id="confirmPendingStockBtn" class="btn btn-success full-width mt-12" type="button" disabled>确认入库</button>
    </section>

    <section class="card operational-dashboard" aria-labelledby="packingDashboardTitle">
      <div class="card-title split-title" id="packingDashboardTitle">
        <span>装箱看板</span>
        <button id="packRecordsBtn" class="btn btn-outline btn-sm" type="button"><%- icon('refresh') %> 刷新</button>
      </div>
      <div class="operations-metrics">
        <div class="operations-metric"><strong id="statBoxes">0</strong><span>本次完成箱数</span></div>
        <div class="operations-metric"><strong id="statItems">0</strong><span>本次绑定子码</span></div>
        <div class="operations-metric"><strong id="statErrors">0</strong><span>本次扫错</span></div>
        <div class="operations-metric"><strong id="prScanCount">-</strong><span>累计扫码</span></div>
        <div class="operations-metric"><strong id="prBoxCount">-</strong><span>累计装箱</span></div>
        <div class="operations-metric"><strong id="prErrorCount">-</strong><span>累计扫错</span></div>
      </div>
    </section>

    <!-- 按产品汇总装箱（独立主导视图：日期维度筛选 + 产品名称汇总 + 逐级下钻） -->
    <section class="card data-display-module packing-summary-module">
      <div class="card-title split-title">
        <span>装箱汇总视图</span>
        <div class="inline-control-row">
          <label class="text-13 muted-text" for="packSummaryDate">日期</label>
          <select id="packSummaryDate" class="form-control compact-select"><option value="">全部日期</option></select>
          <button id="packSummaryBtn" class="btn btn-outline btn-sm" type="button"><%- icon('refresh') %> 查询</button>
        </div>
      </div>
      <div class="pack-summary-total" id="packSummaryTotal"></div>
      <div id="packSummaryList" class="empty-list-state">加载中...</div>
    </section>


  </div>

  <script src="/js/html5-qrcode.min.js"></script>
  <script src="/js/scanner.js?v=20260924b"></script>
  <script nonce="<%= cspNonce %>">
    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      setTimeout(() => t.remove(), 3000);
      document.body.appendChild(t);
    }

    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[ch]);
    }

    // 手机震动提示（浏览器/微信里比声音更可靠）
    function vibrate(pattern) {
      try {
        if (navigator.vibrate) navigator.vibrate(pattern);
      } catch (e) { /* 静默失败 */ }
    }

    // 扫码提示音（Web Audio API 生成，无需音频文件）+ 震动
    // 四档区分：box=箱码 / item=子码 / dup=重复扫码 / err=失败
    let _audioCtx = null;
    function _beep(freqA, freqB, durA, delayB, total, vib) {
      if (vib) vibrate(vib);
      try {
        if (!_audioCtx) _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const ctx = _audioCtx;
        if (ctx.state === 'suspended') ctx.resume();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freqA, now);
        if (freqB) osc.frequency.setValueAtTime(freqB, now + delayB);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + total);
        osc.start(now); osc.stop(now + total + 0.05);
      } catch (e) { /* 静默失败，不影响扫码 */ }
    }
    function playBeep(type) {
      if (type === 'box') {      // 箱码：短促中音“滴”
        _beep(660, 0, 0.12, 0, 0.16, 30);
      } else if (type === 'item') {  // 子码：清脆双音“滴-滴”（升调）
        _beep(880, 1174.66, 0.1, 0.08, 0.22, 20);
      } else if (type === 'dup') {   // 重复扫码：低沉拉长“嗡--”（明显区分）
        _beep(196, 156.82, 0.22, 0.15, 0.4, [80, 60, 80]);
      } else {                    // 失败/其他错误：低沉单音
        _beep(220, 0, 0.18, 0, 0.32, [80, 60, 80]);
      }
    }

    let pendingStockBoxes = [];
    function renderPendingStock() {
      const panel = document.getElementById('pendingStockPanel');
      const list = document.getElementById('pendingStockList');
      const button = document.getElementById('confirmPendingStockBtn');
      document.getElementById('pendingStockCount').textContent = pendingStockBoxes.length;
      panel.classList.toggle('is-hidden', pendingStockBoxes.length === 0);
      button.disabled = pendingStockBoxes.length === 0;
      if (!pendingStockBoxes.length) {
        list.innerHTML = '<p class="empty-list-state">当前确认清单为空。已扫满但暂未确认的箱码可点击“刷新清单”重新加入。</p>';
        return;
      }
      list.innerHTML = pendingStockBoxes.map((box, index) => `
        <div class="pending-stock-row">
          <div class="pending-stock-main">
            <strong>${escapeHtml(box.product_name || '未命名产品')}${box.product_spec ? ' · ' + escapeHtml(box.product_spec) : ''}</strong>
            <span>箱码 <code>${escapeHtml(box.box_code)}</code></span>
          </div>
          <div class="pending-stock-quantity">数量 <strong>${Number(box.quantity) || 0}</strong></div>
          <button type="button" class="btn btn-outline btn-sm" data-remove-pending-stock="${index}">移除</button>
        </div>`).join('');
      list.querySelectorAll('[data-remove-pending-stock]').forEach(button => button.addEventListener('click', () => {
        const index = Number(button.dataset.removePendingStock);
        const [removed] = pendingStockBoxes.splice(index, 1);
        renderPendingStock();
        if (removed) toast(`已从本次清单移除 ${removed.box_code}；该箱仍待入库`, 'success');
      }));
    }
    async function refreshPendingStock() {
      const list = document.getElementById('pendingStockList');
      try {
        const response = await fetch('/api/factory/pack/pending-stock');
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.msg || '读取待入库清单失败');
        pendingStockBoxes = Array.isArray(data.boxes) ? data.boxes : [];
        renderPendingStock();
      } catch (error) {
        document.getElementById('pendingStockPanel').classList.remove('is-hidden');
        list.innerHTML = `<p class="empty-list-state">${escapeHtml(error.message || '待入库清单读取失败，请重试')}</p>`;
        document.getElementById('confirmPendingStockBtn').disabled = true;
      }
    }
    async function confirmPendingStock() {
      if (!pendingStockBoxes.length) return toast('待入库清单为空', 'error');
      const button = document.getElementById('confirmPendingStockBtn');
      button.disabled = true;
      const codes = pendingStockBoxes.map(box => box.box_code);
      try {
        const response = await fetch('/api/factory/pack/confirm-stock', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ box_codes: codes })
        });
        const data = await response.json();
        if (!response.ok || !data.success) {
          toast(data.msg || '确认入库失败，清单未变更', 'error');
          await refreshPendingStock();
          return;
        }
        const completed = Number(data.confirmed_count) || 0;
        stat.boxes += completed;
        document.getElementById('statBoxes').textContent = stat.boxes;
        toast(data.msg || `已确认入库 ${completed} 箱`, 'success');
        await refreshPendingStock();
        refreshPackSummary();
      } catch (error) {
        toast('网络异常，正在核对服务器上的待入库清单', 'error');
        await refreshPendingStock();
      } finally {
        button.disabled = pendingStockBoxes.length === 0;
      }
    }
    // 满箱后先进入可恢复的待入库清单；扫描员可继续扫其他箱，最后统一确认。
    async function showBoxFullModal(boundCount, size) {
      const completedBox = currentBox;
      currentBox = null;
      boxSize = 0;
      document.getElementById('boxPanel').classList.add('is-hidden');
      document.getElementById('boxSizeInput').value = '';
      await refreshPendingStock();
      setBigStatus(`${completedBox?.product_name || '当前产品'} · ${completedBox?.box_code || ''} 已加入待入库清单（${boundCount}/${size}），可继续扫下一箱或统一确认入库`, 'big-full', 'check');
      playBeep('item');
      if (!scanning) document.getElementById('scanInput').focus();
    }
    function iconSvg(name) {
      const allowed = new Set(['alert', 'box', 'check', 'cart', 'refresh']);
      const safe = allowed.has(name) ? name : 'box';
      return `<svg class="ui-icon ui-icon-lg" aria-hidden="true"><use href="/icons/ui.svg#${safe}"></use></svg>`;
    }

    let currentBox = null;   // 当前装箱中的箱信息
    let boxSize = 0;         // 当前箱规
    let products = [];       // 可选产品列表
    let stat = { boxes: 0, items: 0, errors: 0 };
    let errorTimer = null;
    let packingReady = false;  // 前置条件满足（已选产品+箱规+批次号），未就绪时禁止扫码录入

    // 沿用上一箱的产品+箱规（刷新页面也不丢）
    function getLastPack() {
      try { return JSON.parse(sessionStorage.getItem('lastPack') || 'null'); } catch(e) { return null; }
    }
    function setLastPack(p) {
      try { sessionStorage.setItem('lastPack', JSON.stringify(p)); } catch(e) {}
    }

    const scanInput = document.getElementById('scanInput');
    let cancelStockMode = false;   // 取消入库模式开关
    let noBoxMode = false;         // 无箱码入库模式开关
    let noBoxInCount = 0;          // 本次会话已确认的无箱码入库数量
    let pendingNoBoxItems = [];
    let noBoxConfirmRequest = null;
    scanInput.addEventListener('keypress', e => { if (e.key === 'Enter') handleScan(); });
    // 前置条件就绪前禁用扫码录入
    updateReadyState();
    setBigStatus('请先选择产品、箱规、批次号并确认后开始装箱', 'big-select', 'cart');

    // 加载本厂可选产品
    // ---- 品牌选项：与账号归属品牌保持一致 ----
    // 服务端返回的 brands 已经是「工厂被授权品牌 ∩ 账号归属品牌」，
    // 前端不再自己推导，保证下拉里的品牌必然有可装的产品。
    let allProducts = [];   // 未按品牌过滤的全量产品
    let packBrands = [];    // 可选品牌
    let selBrandId = 0;     // 当前选中品牌
    let brandTotals = {};   // 品牌 → 该品牌产品总数（用于区分"没产品"与"产品没绑本厂"）
    let brandPackable = {}; // 品牌 → 本厂可装产品数
    let brandOptionScope = 'factory';
    let factories = [];
    let selectedFactoryId = null; // 品牌选项措辞口径：factory=本厂，owner=账号归属（含平台管理员）
    let factoryLocked = false;

    (async function loadProducts() {
      try {
        const res = await fetch('/api/products');
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.msg || '产品加载失败');
        allProducts = (data.products || []).map(p => ({
          id: p.id, name: p.name, spec: p.spec || '', box_size: p.box_size || 0,
          batch_no: p.batch_no || '', brand_id: Number(p.brand_id) || 0,
          factory_ids: (p.factory_ids || []).map(Number)
        }));
        packBrands = Array.isArray(data.brands) ? data.brands : [];
        brandTotals = data.brandTotal || {};
        brandPackable = data.brandPackable || {};
        brandOptionScope = data.brandOptionScope || 'factory';
        factories = Array.isArray(data.factories) ? data.factories : [];
        factoryLocked = !!data.factoryLocked;
      } catch (e) {
        allProducts = []; packBrands = [];
        document.getElementById('selProduct').innerHTML = '<option value="">产品加载失败，请刷新重试</option>';
        setBigStatus('产品加载失败，请检查网络后刷新重试', 'big-error', 'alert');
        return;
      }
      renderBrandOptions();
    })();

    // 工厂选择下拉：仅非工厂角色可见
    function renderFactoryOptions() {
      const group = document.getElementById('selFactoryGroup');
      const sel = document.getElementById('selFactory');
      if (!group || !sel) return;
      if (factoryLocked) {
        selectedFactoryId = null;
        group.classList.add('is-hidden');
        return;
      }
      const selectedProduct = allProducts.find(p => p.id === Number(document.getElementById('selProduct').value));
      const brandProducts = allProducts.filter(p => !selBrandId || p.brand_id === selBrandId);
      const candidateIds = new Set(selectedProduct
        ? selectedProduct.factory_ids
        : brandProducts.flatMap(p => p.factory_ids));
      const available = factories.filter(f =>
        (!selBrandId || (f.brand_ids || []).map(Number).includes(selBrandId))
        && candidateIds.has(Number(f.id)));
      const previous = selectedFactoryId;
      group.classList.remove('is-hidden');
      if (available.length === 0) {
        sel.innerHTML = '<option value="">暂无可用工厂</option>';
        selectedFactoryId = null;
      } else if (available.length === 1) {
        sel.innerHTML = '<option value="' + available[0].id + '">' + escapeHtml(available[0].name) + '</option>';
        selectedFactoryId = Number(available[0].id);
      } else {
        sel.innerHTML = '<option value="">请选择工厂</option>' +
          available.map(f => '<option value="' + f.id + '">' + escapeHtml(f.name) + '</option>').join('');
        selectedFactoryId = available.some(f => Number(f.id) === previous) ? previous : null;
        sel.value = selectedFactoryId ? String(selectedFactoryId) : '';
      }
    }
    const selFactoryEl = document.getElementById('selFactory');
    if (selFactoryEl) selFactoryEl.addEventListener('change', function() {
      selectedFactoryId = Number(this.value) || null;
    });
    document.getElementById('selProduct').addEventListener('change', renderFactoryOptions);

    // 只有一个品牌时不显示品牌下拉（选了也没得选，白多一步）；
    // 多个品牌时必须先选品牌，产品列表随之过滤。
    function renderBrandOptions() {
      const group = document.getElementById('selBrandGroup');
      const sel = document.getElementById('selBrand');
      if (!group || !sel) return;
      if (packBrands.length > 1) {
        // 品牌选项 = 账号归属品牌，其中可能包含「本厂一个可装产品都没有」的品牌
        // （工厂12 的优乐虎产品全绑在工厂19，关谷庄则一个产品都没有）。
        // 这类品牌就地标注，避免"选完品牌却是空的"被当成功能坏了。
        sel.innerHTML = '<option value="">请选择品牌</option>' + packBrands.map(b => {
          const n = Number((brandPackable || {})[b.id] || 0);
          const noneText = brandOptionScope === 'factory' ? '（本厂暂无可装产品）' : '（暂无产品）';
          const suffix = n > 0 ? '' : noneText;
          return `<option value="${Number(b.id)}">${escapeHtml(b.name)}${suffix}</option>`;
        }).join('');
        group.classList.remove('is-hidden');
        selBrandId = 0;
      } else {
        group.classList.add('is-hidden');
        selBrandId = packBrands.length === 1 ? Number(packBrands[0].id) : 0;
      }
      applyBrandFilter();
    }

    function applyBrandFilter() {
      let hint = '';
      if (packBrands.length > 1 && !selBrandId) {
        products = [];   // 必须先选品牌，不放行"跨品牌混选"
        hint = '请先选择品牌，再选择产品';
      } else if (selBrandId) {
        products = allProducts.filter(p => p.brand_id === selBrandId);
        // 品牌选项按"账号归属品牌"列出，所以完全可能出现该品牌下还没有产品的情况。
        // 不说清楚的话，用户只会看到一个空下拉，又会以为功能坏了。
        if (!products.length) {
          const bn = (packBrands.find(b => Number(b.id) === Number(selBrandId)) || {}).name || '该品牌';
          const total = Number(brandTotals[selBrandId]) || 0;
          hint = total > 0
            ? bn + ' 下有 ' + total + ' 个产品，但都没有把本工厂加入「可装工厂」；请在产品管理里为这些产品勾选本工厂（或新建产品时选择本工厂），本厂才能装它'
            : bn + ' 下暂无产品，请先在「产品管理」里为这个品牌添加产品';
        }
      } else {
        products = allProducts;
      }
      renderProductOptions();
      renderFactoryOptions();
      if (hint) setBigStatus(hint, 'big-select', 'cart');
      else if (!scanning) setBigStatus('已选好品牌与产品，填写箱规和批次号后确认', 'big-select', 'cart');
    }

    const selBrandEl = document.getElementById('selBrand');
    if (selBrandEl) selBrandEl.addEventListener('change', function () {
      selBrandId = Number(this.value) || 0;
      if (!selBrandId) { setBigStatus('请先选择品牌，再选择产品', 'big-select', 'cart'); }
      applyBrandFilter();
    });

    function renderProductOptions(selectedId) {
      const sel = document.getElementById('selProduct');
      if (!products.length) {
        sel.innerHTML = '<option value="">' + (selBrandId ? '该品牌下暂无产品' : '请先选择品牌') + '</option>';
        return;
      }
      sel.innerHTML = '<option value="">请选择产品</option>' + products.map(p =>
        `<option value="${Number(p.id)}">${escapeHtml(p.name)}${p.spec ? ' (' + escapeHtml(p.spec) + ')' : ''}${p.box_size ? ' · 默认箱规' + Number(p.box_size) : ''}</option>`
      ).join('');
      if (selectedId) sel.value = String(selectedId);
      renderFactoryOptions();
    }

    function setBigStatus(text, cls, iconName) {
      const el = document.getElementById('bigStatus');
      el.textContent = text;
      el.className = 'big-status ' + cls;
      document.getElementById('scanIcon').innerHTML = iconSvg(iconName);
    }

    // 连续扫码：摄像头常开，识别到码直接处理（箱码/子码自动区分），中途无需再点按钮
    let scanning = false;                    // 摄像头连续扫码是否进行中
    let resumeScanAfterProduct = false;      // 选完产品后是否自动恢复连续扫码

    function guidePackingSetup(message) {
      const panel = document.getElementById('productPanel');
      const product = document.getElementById('selProduct');
      panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => product.focus({ preventScroll: true }), 320);
      toast(message || '请先选择产品、箱规和批次号，然后确认启用扫码', 'error');
    }

    function cameraScan() {
      // 允许先开启摄像头扫箱码；空白箱码识别后再引导选择产品。
      scanning = true;
      const tip = currentBox
        ? `连续扫码：子码(S开头) ${boxSize > 0 ? '· ' + (parseInt(document.getElementById('boundCount').textContent) || 0) + '/' + boxSize : ''} · 扫满后加入待入库清单`
        : '连续扫码：请先扫箱码(B开头)';
      openScanner({
        title: tip,
        continuous: true,
        onScanned: code => processCode(code)
      });
    }

    // 输入框/扫码枪回车入口
    async function handleScan() {
      const code = extractCode(scanInput.value);
      scanInput.value = '';
      if (!code) return;
      await processCode(code);
      if (!scanning) scanInput.focus();
    }

    // 核心：自动识别 B开头=箱码 / S开头=子码
    async function processCode(code) {
      if (cancelStockMode) {
        await cancelStock(code);
        return;
      }
      if (noBoxMode) {
        // 无箱码入库模式：子码直接入库，箱码仍走正常装箱
        if (/^S/i.test(code)) {
          await scanNoBoxItem(code);
        } else if (/^B/i.test(code)) {
          await startPacking(code);
        } else {
          flashError('无法识别：' + code + '（无箱码入库请扫 S 开头子码）');
        }
        return;
      }
      if (/^B/i.test(code)) {
        await startPacking(code);
      } else if (/^S/i.test(code)) {
        if (!currentBox) return flashError('请先扫箱码（B开头），再扫子码');
        await scanItem(code);
      } else {
        flashError('无法识别：' + code + '（B开头是箱码，S开头是子码）');
      }
    }

    // 前置条件不足时仍允许点击；点击后会定位到缺失项，避免按钮看起来失效。
    function updateReadyState() {
      const input = document.getElementById('scanInput');
      const camBtn = document.getElementById('cameraScanBtn');
      const ready = packingReady || cancelStockMode || noBoxMode;
      input.removeAttribute('disabled');
      camBtn.removeAttribute('disabled');
      input.setAttribute('aria-disabled', 'false');
      camBtn.setAttribute('aria-disabled', 'false');
      camBtn.classList.toggle('needs-setup', !ready);
      if (packingReady) {
        input.placeholder = '扫箱码(B开头) / 扫子码(S开头)';
      } else if (cancelStockMode) {
        input.placeholder = '扫箱码/子码加入取消清单';
      } else if (noBoxMode) {
        input.placeholder = '无箱码入库：扫子码(S开头)';
      } else {
        input.placeholder = '可输入码值；首次使用请先完成下方产品设置';
      }
    }

    // 取消入库：扫码累积到待取消清单（不立即执行），点「确认取消入库」二次确认后批量执行
    const cancelStockStorageKey = 'reliacode:cancel-stock:<%= user.id %>';
    let cancelStockCodes = (() => {
      try { const saved = JSON.parse(sessionStorage.getItem(cancelStockStorageKey) || '[]'); return Array.isArray(saved) ? saved.filter(code => typeof code === 'string' && /^[BS][A-Z0-9]+$/.test(code)).slice(0, 200) : []; }
      catch (_error) { return []; }
    })(); // 断网或刷新后保留未核实的码
    function renderCancelStock() {
      try { sessionStorage.setItem(cancelStockStorageKey, JSON.stringify(cancelStockCodes)); } catch (_error) {}
      const list = document.getElementById('cancelStockList');
      document.getElementById('cancelStockCount').textContent = cancelStockCodes.length;
      if (cancelStockCodes.length === 0) {
        list.innerHTML = '<p class="empty-list-state">扫码后自动累积到清单（支持箱码/子码混扫）</p>';
      } else {
        list.innerHTML = cancelStockCodes.map((c, i) => `
          <div class="pending-ship-row">
            <span class="code-cell">${escapeHtml(c)}</span>
            <button type="button" class="btn btn-outline btn-sm remove-cancel-stock-btn" data-index="${i}">移除</button>
          </div>
        `).join('');
      }
    }
    renderCancelStock();
    const checkingCancelStock = new Set();
    async function cancelStock(code) {
      if (cancelStockCodes.includes(code)) {
        playBeep('dup');
        toast('该码已在待取消清单中', 'error');
        return;
      }
      if (checkingCancelStock.has(code)) return;
      checkingCancelStock.add(code);
      try {
        const response = await fetch(`/api/codes/reversal-state?kind=stock&code=${encodeURIComponent(code)}`);
        const state = await response.json();
        if (!response.ok || !state.success) throw new Error(state.msg || '无法核对码状态');
        if (state.settled) {
          playBeep('dup');
          toast('该码当前没有待取消的入库记录', 'error');
          return;
        }
      } catch (error) {
        playBeep('error');
        toast((error && error.message) || '状态核对失败，请联网后重试', 'error');
        return;
      } finally {
        checkingCancelStock.delete(code);
      }
      cancelStockCodes.push(code);
      renderCancelStock();
      playBeep(/^B/i.test(code) ? 'box' : 'item');
      toast('已添加待取消：' + code, 'success');
    }
    // 单个码真正执行取消入库
    async function doCancelStockOne(code) {
      return cancelCodeWithReconciliation(code, '/api/codes/cancel-stock', 'stock');
    }
    // 二次确认后批量执行取消入库
    async function confirmCancelStock() {
      if (!cancelStockCodes.length) return toast('请先扫码添加要取消入库的码', 'error');
      showCancelConfirm(
        '确认取消入库',
        `即将取消入库 <b>${cancelStockCodes.length}</b> 个码（箱码整箱子码解绑）：`,
        cancelStockCodes.slice(),
        async () => {
          const codes = cancelStockCodes.slice();
          const results = [];
          for (const code of codes) {
            const r = await doCancelStockOne(code);
            results.push(r);
            if (r.success) {
              // 实时刷新：若取消的是当前正在装箱的整箱，清空状态
              if (currentBox && /^B/i.test(code) && code === currentBox.box_code) {
                currentBox = null;
                boxSize = 0;
                document.getElementById('boxPanel').classList.add('is-hidden');
                document.getElementById('boundCount').textContent = '0';
                document.getElementById('itemList').innerHTML = '<p class="empty-list-state">暂无子码</p>';
                document.getElementById('progressText').textContent = '0 / ' + (boxSize || '?');
              } else if (currentBox && currentBox.box_code) {
                try { await startPacking(currentBox.box_code, true); } catch (_error) { /* 清单结果不依赖页面刷新。 */ }
              }
            }
          }
          const ok = results.filter(r => r.success).length;
          const fail = results.filter(r => !r.success).length;
          if (fail) {
            flashError(`取消完成：成功 ${ok} 个，失败 ${fail} 个：${results.filter(r=>!r.success).map(r=>r.code+'：'+r.msg).join('；')}`, 'err');
          } else {
            playBeep('dup');
            toast(`已取消入库 ${ok} 个`, 'success');
          }
          cancelStockCodes = results.filter(r => !r.success).map(r => r.code);
          renderCancelStock();
          setBigStatus(fail ? `待核对 ${fail} 个码` : '已取消入库', fail ? 'big-error' : 'big-idle', fail ? 'alert' : 'check');
          scanInput.focus();
        }
      );
    }

    // 取消入库模式切换按钮
    (function bindCancelStock() {
      const btn = document.getElementById('cancelStockBtn');
      const hint = document.getElementById('cancelStockHint');
      const input = document.getElementById('scanInput');
      const panel = document.getElementById('cancelStockPanel');
      const confirmBtn = document.getElementById('confirmCancelStockBtn');
      const clearBtn = document.getElementById('clearCancelStockBtn');
      confirmBtn.addEventListener('click', confirmCancelStock);
      clearBtn.addEventListener('click', () => { cancelStockCodes = []; renderCancelStock(); });
      document.getElementById('cancelStockList').addEventListener('click', e => {
        const b = e.target.closest('.remove-cancel-stock-btn');
        if (!b) return;
        cancelStockCodes.splice(parseInt(b.dataset.index), 1);
        renderCancelStock();
      });
      btn.addEventListener('click', () => {
        cancelStockMode = !cancelStockMode;
        if (cancelStockMode) {
          btn.textContent = '退出取消入库';
          btn.classList.add('active');
          panel.classList.remove('is-hidden');
          input.placeholder = '扫箱码/子码 加入取消清单…';
          hint.textContent = '已开启取消入库：扫码把码加入待取消清单，扫完点「确认取消入库」二次确认后执行';
          hint.classList.remove('is-hidden');
          toast('已开启取消入库模式，扫码累积清单', 'success');
        } else {
          btn.textContent = '取消入库';
          btn.classList.remove('active');
          panel.classList.add('is-hidden');
          input.placeholder = '扫箱码(B开头) / 扫子码(S开头)';
          hint.textContent = '';
          hint.classList.add('is-hidden');
        }
        updateReadyState();
        input.focus();
      });
    })();

    // 无箱码入库模式切换按钮
    (function bindNoBoxMode() {
      const btn = document.getElementById('noBoxModeBtn');
      const hint = document.getElementById('noBoxModeHint');
      const input = document.getElementById('scanInput');
      const stats = document.getElementById('noBoxStats');
      btn.addEventListener('click', () => {
        noBoxMode = !noBoxMode;
        if (noBoxMode) {
          btn.textContent = '退出无箱码入库';
          btn.classList.add('active');
          input.placeholder = '无箱码入库：扫子码(S开头)…';
          hint.textContent = '已开启无箱码入库：先选择产品和批次，扫子码加入待入库清单，核对后点“确认入库”';
          hint.classList.remove('is-hidden');
          stats.classList.remove('is-hidden');
          toast('已开启无箱码入库模式', 'success');
        } else {
          btn.textContent = '无箱码入库';
          btn.classList.remove('active');
          input.placeholder = '扫箱码(B开头) / 扫子码(S开头)';
          hint.textContent = '';
          hint.classList.add('is-hidden');
          stats.classList.add('is-hidden');
        }
        updateReadyState();
        renderPendingNoBox();
        input.focus();
      });
    })();

    function renderPendingNoBox() {
      const panel = document.getElementById('pendingNoBoxPanel');
      const list = document.getElementById('pendingNoBoxList');
      document.getElementById('pendingNoBoxCount').textContent = pendingNoBoxItems.length;
      document.getElementById('confirmPendingNoBoxBtn').disabled = pendingNoBoxItems.length === 0;
      panel.classList.toggle('is-hidden', !noBoxMode && pendingNoBoxItems.length === 0);
      if (!pendingNoBoxItems.length) {
        list.innerHTML = '<p class="empty-list-state">清单为空；扫描子码后会在这里显示，确认前不会入库。</p>';
        return;
      }
      list.innerHTML = pendingNoBoxItems.map((item, index) => `
        <div class="pending-stock-row">
          <div class="pending-stock-main">
            <strong>${escapeHtml(item.product_name || '未命名产品')}${item.product_spec ? ' · ' + escapeHtml(item.product_spec) : ''}</strong>
            <span>箱码：无箱码 · 子码 <code>${escapeHtml(item.item_code)}</code></span>
          </div>
          <div class="pending-stock-quantity">数量 <strong>1</strong></div>
          <button type="button" class="btn btn-outline btn-sm" data-remove-pending-nobox="${index}">移除</button>
        </div>`).join('');
      list.querySelectorAll('[data-remove-pending-nobox]').forEach(button => button.addEventListener('click', async () => {
        const item = pendingNoBoxItems[Number(button.dataset.removePendingNobox)];
        if (!item) return;
        button.disabled = true;
        try {
          const response = await fetch('/api/factory/pack/pending-nobox/' + encodeURIComponent(item.item_code), { method: 'DELETE' });
          const data = await response.json();
          if (!response.ok || !data.success) throw new Error(data.msg || '移除失败');
          noBoxConfirmRequest = null;
          await refreshPendingNoBox();
        } catch (error) {
          toast(error.message || '移除失败，清单未变更', 'error');
          button.disabled = false;
        }
      }));
    }
    async function refreshPendingNoBox() {
      try {
        const response = await fetch('/api/factory/pack/pending-nobox');
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.msg || '待入库清单读取失败');
        pendingNoBoxItems = Array.isArray(data.items) ? data.items : [];
        renderPendingNoBox();
      } catch (error) {
        document.getElementById('pendingNoBoxPanel').classList.remove('is-hidden');
        document.getElementById('pendingNoBoxList').innerHTML = `<p class="empty-list-state">${escapeHtml(error.message || '待入库清单读取失败，请重试')}</p>`;
        document.getElementById('confirmPendingNoBoxBtn').disabled = true;
      }
    }
    async function confirmPendingNoBox() {
      if (!pendingNoBoxItems.length) return toast('无箱码待入库清单为空', 'error');
      if (!window.confirm(`确认将清单中的 ${pendingNoBoxItems.length} 个无箱码子码入库？确认后才能发货。`)) return;
      const codes = pendingNoBoxItems.map(item => item.item_code);
      const signature = JSON.stringify(codes);
      if (!noBoxConfirmRequest || noBoxConfirmRequest.signature !== signature) {
        noBoxConfirmRequest = { signature, key: 'nobox-' + (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2)) };
      }
      const button = document.getElementById('confirmPendingNoBoxBtn');
      button.disabled = true;
      try {
        const response = await fetch('/api/factory/pack/confirm-nobox', {
          method: 'POST', headers: { 'Content-Type': 'application/json', 'Idempotency-Key': noBoxConfirmRequest.key },
          body: JSON.stringify({ item_codes: codes })
        });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.msg || '确认入库失败');
        const count = Number(data.confirmed_count) || 0;
        noBoxInCount += count;
        stat.items += count;
        document.getElementById('noBoxCount').textContent = noBoxInCount;
        document.getElementById('statItems').textContent = stat.items;
        toast(data.msg || `已确认入库 ${count} 个`, 'success');
        noBoxConfirmRequest = null;
        await refreshPendingNoBox();
        refreshPackSummary();
      } catch (error) {
        toast((error.message || '网络异常') + '；正在核对服务器清单，未确认的子码会保留', 'error');
        await refreshPendingNoBox();
      } finally {
        button.disabled = pendingNoBoxItems.length === 0;
      }
    }

    // 无箱码扫码只登记待确认清单，不立即改变库存。
    async function scanNoBoxItem(itemCode) {
      const productId = parseInt(document.getElementById('selProduct').value);
      const batch = document.getElementById('selBatch').value.trim();
      if (!productId) return flashError('请先在上方选择产品（无箱码入库需指定产品）', 'err');
      try {
        const res = await fetch('/api/factory/pack/pending-nobox', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ item_code: itemCode, product_id: productId, batch_no: batch,
            operation_factory_id: selectedFactoryId || undefined })
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          const isDup = /重复|已入库|已绑定|已装箱/.test(data.msg || '');
          return flashError(data.msg || '加入清单失败', isDup ? 'dup' : 'err');
        }
        playBeep('item');
        noBoxConfirmRequest = null;
        await refreshPendingNoBox();
        setBigStatus(`${data.product_name} · ${itemCode} 已加入待入库清单（共 ${pendingNoBoxItems.length} 个），尚未入库`, 'big-packing', 'check');
        toast(data.msg || '已加入待入库清单', 'success');
      } catch (error) {
        flashError('扫码提交或清单读取失败，请刷新待入库清单核对后再试', 'err');
      }
    }

    function flashError(msg, beepType) {
      stat.errors++;
      document.getElementById('statErrors').textContent = stat.errors;
      playBeep(beepType || 'err');
      // 大状态条闪红2秒后恢复
      setBigStatus(msg, 'big-error', 'alert');
      toast(msg, 'error');
      clearTimeout(errorTimer);
      errorTimer = setTimeout(() => {
        if (currentBox) {
          const bound = parseInt(document.getElementById('boundCount').textContent) || 0;
          if (boxSize > 0 && bound >= boxSize) {
            setBigStatus(`本箱已完成（${bound}/${boxSize}），扫下一个箱码开始新箱`, 'big-full', 'check');
          } else {
            setBigStatus(`正在装箱：${currentBox.box_code}（${bound}/${boxSize || '?'}）`, 'big-packing', 'box');
          }
        } else {
          setBigStatus('请扫描箱码开始装箱', 'big-idle', 'box');
        }
      }, 2000);
    }

    // ---- 选择产品面板 ----
    function showProductPanel(boxCode, prefillProduct) {
      const panel = document.getElementById('productPanel');
      document.getElementById('productPanelBox').textContent = boxCode ? '（箱码：' + boxCode + '）' : '';
      renderProductOptions(prefillProduct && prefillProduct.id);
      const sel = document.getElementById('selProduct');
      if (prefillProduct) {
        const p = products.find(x => x.id === prefillProduct.id) || prefillProduct;
        document.getElementById('selBoxSize').value = prefillProduct.box_size || p.box_size || '';
        document.getElementById('selBatch').value = prefillProduct.batch_no || '';
      } else {
        document.getElementById('selBoxSize').value = '';
        document.getElementById('selBatch').value = '';
      }
      panel.classList.remove('is-hidden');
      if (!prefillProduct) sel.focus();
    }
    function hideProductPanel() {
      // 产品面板常驻显示（打开页面即可预选），这里不再隐藏，仅恢复扫码/焦点
      // 若连续扫码因弹表单被暂停，自动恢复摄像头（确认产品/取消都走这里）
      if (resumeScanAfterProduct && !scanning) {
        resumeScanAfterProduct = false;
        cameraScan();
      } else if (!scanning) {
        scanInput.focus();
      }
    }

    // 选产品时自动带出该产品的默认箱规（避免工人手动填错）
    function bindProductBoxSize() {
      const sel = document.getElementById('selProduct');
      const sizeInput = document.getElementById('selBoxSize');
      if (!sel || !sizeInput) return;
      sel.addEventListener('change', () => {
        const pid = parseInt(sel.value);
        const p = products.find(x => x.id === pid);
        if (p && p.box_size > 0) {
          sizeInput.value = p.box_size;
        } else {
          sizeInput.value = '';
        }
      });
    }
    bindProductBoxSize();

    // 确认产品+箱规
    async function confirmProduct() {
      const productId = parseInt(document.getElementById('selProduct').value);
      const size = parseInt(document.getElementById('selBoxSize').value);
      const batch = document.getElementById('selBatch').value.trim();
      if (!productId) return toast('请选择产品', 'error');
      if (!size || size < 1) return toast('请输入有效箱规（每箱装几个）', 'error');
      if (!batch) return toast('请输入批次号', 'error');
      if (!factoryLocked && !selectedFactoryId) return toast('请选择该产品可用的生产工厂', 'error');

      const p = products.find(x => x.id === productId);

      // 尚未扫码（无当前箱）：仅记录“预选”产品+箱规，供后续扫码自动沿用
      if (!currentBox) {
        setLastPack({ id: productId, name: p ? p.name : '', box_size: size, batch_no: batch });
        packingReady = true;
        updateReadyState();
        playBeep('item');
        toast('已选好产品/箱规/批次号，可以扫码装箱了', 'success');
        document.getElementById('productPanelBox').textContent = '（' + (p ? p.name : '') + ' · 每箱 ' + size + ' · 批次 ' + batch + '）';
        setBigStatus('已就绪：' + (p ? p.name : '') + ' 每箱 ' + size + ' 个，请扫箱码开始装箱', 'big-idle', 'box');
        // 需求#3：若之前因「换产品」暂停了连续扫码，这里自动恢复摄像头
        hideProductPanel();
        return;
      }

      const res = await fetch('/api/factory/pack/set-product', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ box_code: currentBox.box_code, product_id: productId, box_size: size, batch_no: batch, operation_factory_id: selectedFactoryId || undefined })
      });
      const data = await res.json();
      if (!data.success) return flashError(data.msg || '设置产品失败');

      setLastPack({ id: productId, name: p ? p.name : '', box_size: size, batch_no: batch });
      // 重新拉取箱信息（此时已带产品）；hideProductPanel 会自动恢复连续扫码
      await startPacking(currentBox.box_code, true);
      hideProductPanel();
    }

    // 换产品
    // 需求#3：本箱未完成时，直接改当前箱的产品；
    //         本箱已完成（或还没扫箱码）时，不能改已装满的箱（服务端会以“混装”拒绝），
    //         改为结束当前箱、给下一箱重新选产品，选完扫新箱码继续装箱。
    function changeProduct() {
      const boundNow = parseInt(document.getElementById('boundCount').textContent) || 0;
      if (currentBox?.status === 'packing' && boxSize > 0 && boundNow >= boxSize) {
        showBoxFullModal(boundNow, boxSize);
        return;
      }
      // 弹表单前暂停摄像头，确认后自动恢复
      resumeScanAfterProduct = scanning;
      if (scanning) { stopScanner(); scanning = false; }

      const boxComplete = !!currentBox && boxSize > 0 && boundNow >= boxSize;

      if (!currentBox || boxComplete) {
        if (boxComplete) {
          toast('本箱已完成（' + boundNow + '/' + boxSize + '），请选择新产品后扫新箱码继续', 'success');
        }
        // 清掉已完成箱的界面状态，让 confirmProduct 走“预选产品”分支
        currentBox = null;
        boxSize = 0;
        document.getElementById('boxPanel').classList.add('is-hidden');
        updateItemList([]);
        updateProgress();
        showProductPanel('', getLastPack());
        setBigStatus('请选择新产品、箱规和批次号，确认后扫新箱码继续装箱', 'big-select', 'refresh');
        return;
      }

      // 本箱未完成：允许直接换产品（服务端校验箱内是否已有其它产品的子码）
      const cur = currentBox.product_id ? {
        id: currentBox.product_id,
        box_size: boxSize,
        batch_no: currentBox.batch_no || ''
      } : getLastPack();
      showProductPanel(currentBox.box_code, cur);
      setBigStatus('请选择新产品并确认箱规', 'big-select', 'refresh');
    }

    // ---- 扫箱码：开始/切换装箱 ----
    async function startPacking(boxCode, isRefresh) {
      const res = await fetch('/api/factory/pack/start', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ box_code: boxCode })
      });
      const data = await res.json();
      if (!data.success) return flashError(data.msg || '箱码不存在');

      currentBox = data.box;

      // 空白箱码：需要先选产品
      if (data.need_product) {
        // 优先用页面上已预选的产品+箱规（打开页面即可先选好）
        const preProductId = parseInt(document.getElementById('selProduct').value);
        const preSize = parseInt(document.getElementById('selBoxSize').value);
        const preBatch = document.getElementById('selBatch').value.trim();
        const last = getLastPack();
        const chosen = (preProductId && preSize && preSize > 0)
          ? { id: preProductId, box_size: preSize, batch_no: preBatch }
          : (last && last.id ? last : null);
        if (chosen && !isRefresh) {
          // 自动沿用已选/上次产品+箱规，直接进入扫码
          const r2 = await fetch('/api/factory/pack/set-product', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ box_code: boxCode, product_id: chosen.id, box_size: chosen.box_size, batch_no: chosen.batch_no || '', operation_factory_id: selectedFactoryId || undefined })
          });
          const d2 = await r2.json();
          if (d2.success) {
            return startPacking(boxCode, true);
          }
          // 沿用失败（如产品下架/权限变化），回落到手动选择
          toast(d2.msg || '沿用已选产品失败，请重新选择', 'error');
        }
        boxSize = 0;
        document.getElementById('boxPanel').classList.add('is-hidden');
        // 未预选产品时暂停连续扫码，让用户在常驻面板上选择；确认后自动恢复
        resumeScanAfterProduct = scanning;
        if (scanning) { stopScanner(); scanning = false; }
        showProductPanel(boxCode, chosen || last);
        setBigStatus('已识别箱码，请选择本箱产品并确认箱规', 'big-select', 'cart');
        return;
      }

      // 箱规自动带产品默认值（或沿用值）
      boxSize = data.box_size || boxSize || 0;
      packingReady = !!currentBox.product_id && boxSize > 0 && !!currentBox.batch_no;
      updateReadyState();
      document.getElementById('boxSizeInput').value = boxSize || '';

      hideProductPanel();
      // 箱码识别成功：绿色提示 + 轻微震动 + 箱码音
      toast('箱码已识别，请继续扫描产品子码', 'success');
      playBeep('box');
      document.getElementById('boxPanel').classList.remove('is-hidden');
      document.getElementById('curBoxCode').textContent = currentBox.box_code;
      document.getElementById('curProduct').textContent = (currentBox.product_name || '-') + (currentBox.product_spec ? ' (' + currentBox.product_spec + ')' : '');
      document.getElementById('curBatch').textContent = currentBox.batch_no || '-';

      updateItemList(data.items);
      updateProgress();

      if (data.bound_count > 0) {
        toast(`该箱已有 ${data.bound_count} 个子码，继续扫码即可`, 'success');
        if (boxSize > 0 && data.bound_count >= boxSize) {
          if (currentBox.status === 'packing') {
            setBigStatus(`本箱待确认入库（${data.bound_count}/${boxSize}）`, 'big-full', 'check');
            showBoxFullModal(data.bound_count, boxSize);
          } else setBigStatus(`该箱已入库（${data.bound_count}/${boxSize}），请扫下一箱`, 'big-full', 'check');
        } else {
          setBigStatus(`继续装箱：${currentBox.product_name}（${data.bound_count}/${boxSize || '?'}）`, 'big-packing', 'box');
        }
      } else {
        setBigStatus(boxSize > 0
          ? `开始装箱：${currentBox.product_name}，请扫 ${boxSize} 个子码`
          : `开始装箱：${currentBox.product_name}（未设箱规，请先在下方填写）`, 'big-packing', 'box');
      }
    }

    // ---- 扫子码：绑定到当前箱 ----
    async function scanItem(itemCode) {
      if (!currentBox) return flashError('请先扫箱码（B开头）再扫子码');
      if (!currentBox.product_id) return flashError('本箱还未选产品，请先在上方选择产品');

      const res = await fetch('/api/factory/pack/scan', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ box_code: currentBox.box_code, item_code: itemCode, box_size: boxSize })
      });
      const data = await res.json();

      if (!data.success) {
        if (data.bound_count !== undefined) {
          document.getElementById('boundCount').textContent = data.bound_count;
        }
        // 区分重复扫码与普通失败的不同提示音
        const isDup = /重复|已在本箱|已绑定/.test(data.msg || '');
        return flashError(data.msg || '绑定失败', isDup ? 'dup' : 'err');
      }

      currentBox.status = 'packing';
      playBeep('item');

      // 后端箱规兜底（首次未填箱规时从产品默认取）
      if (data.box_size && !boxSize) {
        boxSize = data.box_size;
        document.getElementById('boxSizeInput').value = boxSize;
      }

      stat.items++;
      document.getElementById('statItems').textContent = stat.items;
      updateItemList(data.items || []);
      updateProgress();

      if (data.full) {
        currentBox.status = 'packing';
        setBigStatus(`本箱待确认入库（${data.bound_count}/${data.box_size}）`, 'big-full', 'check');
        showBoxFullModal(data.bound_count, data.box_size);
      } else {
        setBigStatus(`正在装箱：${currentBox.product_name}（${data.bound_count}/${data.box_size || '?'}）`, 'big-packing', 'box');
        toast(`绑定成功 (${data.bound_count}/${data.box_size || '?'})`, 'success');
      }
    }

    // 手动修改箱规
    async function applyBoxSize() {
      const size = parseInt(document.getElementById('boxSizeInput').value);
      if (!size || size < 1) return toast('请输入有效箱规', 'error');
      const bound = parseInt(document.getElementById('boundCount').textContent) || 0;
      if (currentBox?.product_id) {
        try {
          const response = await fetch('/api/factory/pack/set-product', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ box_code: currentBox.box_code, product_id: currentBox.product_id,
              box_size: size, batch_no: currentBox.batch_no, operation_factory_id: selectedFactoryId || undefined })
          });
          const data = await response.json();
          if (!response.ok || !data.success) return toast(data.msg || '箱规保存失败', 'error');
          currentBox.box_size = size;
        } catch (_error) { return toast('网络异常，箱规未保存', 'error'); }
      }
      boxSize = size;
      const last = getLastPack();
      if (last) setLastPack({ ...last, box_size: size });  // 同步沿用箱规
      updateProgress();
      toast('箱规已改为 ' + size, 'success');
      if (bound >= size) {
        if (currentBox?.status === 'packing') showBoxFullModal(bound, size);
        else setBigStatus(`本箱已入库（${bound}/${size}），请扫下一箱`, 'big-full', 'check');
      } else {
        setBigStatus(`正在装箱：${currentBox.box_code}（${bound}/${size}）`, 'big-packing', 'box');
      }
      scanInput.focus();
    }

    function updateItemList(items) {
      const list = document.getElementById('itemList');
      document.getElementById('boundCount').textContent = items.length;
      list.innerHTML = items.length === 0
        ? '<p class="empty-list-state">暂无子码</p>'
        : items.map((it, i) => `
          <div class="packed-item-row">
            <span class="mono-text">${i+1}. ${escapeHtml(it.item_code)}</span>
            <span class="small-text muted-text">${escapeHtml(it.bound_at || it.created_at || '')}</span>
          </div>`).join('');
    }

    function updateProgress() {
      const bound = parseInt(document.getElementById('boundCount').textContent) || 0;
      document.getElementById('progressText').textContent = bound + ' / ' + (boxSize || '?');
      const progress = document.getElementById('progressBar');
      progress.max = boxSize > 0 ? boxSize : 1;
      progress.value = boxSize > 0 ? Math.min(bound, boxSize) : 0;
      progress.textContent = boxSize > 0 ? Math.round(Math.min(bound / boxSize, 1) * 100) + '%' : '0%';
    }

    // ---- 扫码记录查询（仅累计数字概览） ----
    async function loadPackRecords() {
      try {
        const res = await fetch('/api/factory/pack/records');
        const data = await res.json();
        if (!data.success) throw new Error(data.msg || '加载失败');
        const st = data.stats || {};
        document.getElementById('prScanCount').textContent = st.scan_count ?? 0;
        document.getElementById('prBoxCount').textContent = st.box_count ?? 0;
        document.getElementById('prErrorCount').textContent = st.error_count ?? 0;
      } catch (e) {
        document.getElementById('prScanCount').textContent = '-';
        document.getElementById('prBoxCount').textContent = '-';
        document.getElementById('prErrorCount').textContent = '-';
      }
    }
    document.getElementById('packRecordsBtn').addEventListener('click', loadPackRecords);
    loadPackRecords();

    // ---- 按日期维度筛选 + 以产品名称为主导汇总 ----
    const packSummaryDate = document.getElementById('packSummaryDate');
    const packSummaryList = document.getElementById('packSummaryList');
    const packSummaryTotal = document.getElementById('packSummaryTotal');

    async function loadPackSummary() {
      const date = packSummaryDate.value || '';
      try {
        const url = '/api/factory/pack/summary' + (date ? '?date=' + encodeURIComponent(date) : '');
        const res = await fetch(url);
        const data = await res.json();
        if (!data.success) throw new Error(data.msg || '加载失败');
        // 同步日期下拉（保留用户当前选择，新增的日期自动出现）
        if (data.dates && data.dates.length) {
          const existing = new Set(Array.from(packSummaryDate.options).map(o => o.value));
          data.dates.forEach(d => {
            if (!existing.has(d)) {
              const opt = document.createElement('option');
              opt.value = d; opt.textContent = d;
              packSummaryDate.appendChild(opt);
            }
          });
        }
        const total = data.total || {};
        packSummaryTotal.innerHTML = `
          <div class="stat-column"><div class="stat-value">${total.box_count ?? 0}</div><div class="muted-supporting-text">入库箱数</div></div>
          <div class="stat-column"><div class="stat-value">${total.item_count ?? 0}</div><div class="muted-supporting-text">产品总数</div></div>
          <div class="stat-column"><div class="stat-value">${total.product_count ?? 0}</div><div class="muted-supporting-text">产品款数</div></div>`;
        const summary = data.summary || [];
        if (summary.length === 0) {
          packSummaryList.innerHTML = '<p class="empty-list-state">' + (date ? '该日期暂无装箱记录' : '暂无装箱记录') + '</p>';
          return;
        }
        packSummaryList.innerHTML = summary.map((p, pi) => {
          const boxes = p.boxes || [];
          // 需求#4：无箱码入库的子码（没有箱码），单独列一节展示子码明细
          const loose = p.loose_items || [];
          const boxRowsHtml = boxes.map((bx, bi) => {
            const codes = (bx.item_codes || []).map(escapeHtml);
            const codesHtml = codes.length
              ? codes.map(c => `<span class="code-chip">${c}</span>`).join('')
              : '<span class="muted-text">（无子码）</span>';
            return `<div class="box-detail-row">
              <div class="box-detail-head"><span class="mono-text bold-text">${escapeHtml(bx.box_code)}</span><span class="small-text muted-text">${Number(bx.item_count) || 0} 个子码${bx.batch_no ? ' · 批次 ' + escapeHtml(bx.batch_no) : ''}${bx.box_size ? ' · 箱规' + Number(bx.box_size) : ''}</span></div>
              <div class="box-detail-codes">${codesHtml}</div>
            </div>`;
          }).join('');
          const looseRowsHtml = loose.length ? `<div class="box-detail-row">
              <div class="box-detail-head"><span class="mono-text bold-text">无箱码入库</span><span class="small-text muted-text">${loose.length} 个子码（未装箱）</span></div>
              <div class="box-detail-codes">${loose.map(l => `<span class="code-chip">${escapeHtml(l.item_code)}</span>`).join('')}</div>
            </div>` : '';
          const noBoxBadge = Number(p.no_box_count) > 0
            ? `<span class="badge-num">无箱码 ${Number(p.no_box_count)} 个</span>`
            : '';
          return `<div class="product-summary-card">
            <div class="product-summary-head" data-toggle="ps-${pi}">
              <div class="product-summary-title">
                <span class="chevron" id="chev-${pi}">▸</span>
                <span class="bold-text">${escapeHtml(p.product_name || '未命名')}</span>${p.spec ? '<span class="small-text muted-text">（' + escapeHtml(p.spec) + '）</span>' : ''}
              </div>
              <div class="product-summary-meta">
                <span class="badge-num">${Number(p.box_count)} 箱</span>
                ${noBoxBadge}
                <span class="badge-num">${Number(p.item_count)} 个产品</span>
              </div>
            </div>
            <div class="product-summary-body" id="ps-body-${pi}">${boxRowsHtml}${looseRowsHtml}</div>
          </div>`;
        }).join('');
        // 点击产品头展开/收起箱明细
        packSummaryList.querySelectorAll('.product-summary-head').forEach(head => {
          head.addEventListener('click', () => {
            const idx = head.getAttribute('data-toggle').replace('ps-', '');
            const body = document.getElementById('ps-body-' + idx);
            const chev = document.getElementById('chev-' + idx);
            if (!body) return;
            const open = body.classList.toggle('is-open');
            if (chev) chev.textContent = open ? '▾' : '▸';
          });
        });
      } catch (e) {
        packSummaryList.innerHTML = '<p class="empty-list-state">加载失败</p>';
      }
    }
    document.getElementById('packSummaryBtn').addEventListener('click', loadPackSummary);
    loadPackSummary();

    // 装箱/无箱码入库成功后，实时刷新当日汇总（跟随当前选中的日期）
    let _packSummaryTimer = null;
    function refreshPackSummary() {
      // 防抖：装箱连续扫码时只刷一次，避免频繁请求
      clearTimeout(_packSummaryTimer);
      _packSummaryTimer = setTimeout(() => loadPackSummary(), 300);
    }

    document.getElementById('cameraScanBtn').addEventListener('click', cameraScan);
    document.getElementById('confirmProductBtn').addEventListener('click', confirmProduct);
    document.getElementById('cancelProductBtn').addEventListener('click', hideProductPanel);
    document.getElementById('applyBoxSizeBtn').addEventListener('click', applyBoxSize);
    document.getElementById('changeProductBtn').addEventListener('click', changeProduct);
    document.getElementById('refreshPendingStockBtn').addEventListener('click', refreshPendingStock);
    document.getElementById('confirmPendingStockBtn').addEventListener('click', confirmPendingStock);
    refreshPendingStock();
    document.getElementById('refreshPendingNoBoxBtn').addEventListener('click', refreshPendingNoBox);
    document.getElementById('confirmPendingNoBoxBtn').addEventListener('click', confirmPendingNoBox);
    refreshPendingNoBox();
  </script>
</body>
</html>
