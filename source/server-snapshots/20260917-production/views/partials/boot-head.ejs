<style nonce="<%= cspNonce %>">
  html.page-booting { overflow: hidden; }
  html.page-booting body { overflow: hidden !important; }
  html.page-booting body > :not(#workspaceBootLoader) { visibility: hidden !important; }
  #workspaceBootLoader {
    position: fixed; inset: 0; z-index: 10000; display: grid; place-items: center;
    visibility: hidden; opacity: 0; pointer-events: none;
    background: #effbf6; color: #07513d;
    transition: opacity .18s ease, visibility .18s ease;
  }
  html.page-booting #workspaceBootLoader,
  #workspaceBootLoader.is-visible { visibility: visible; opacity: 1; pointer-events: auto; }
  #workspaceBootLoader.is-booting { background: #effbf6; }
  #workspaceBootLoader .workspace-loading-inner { display: grid; place-items: center; }
  #workspaceBootLoader .walking-elephant { display: block; width: 136px; height: 110px; }
  #workspaceBootLoader svg { display: block; width: 100%; height: 100%; overflow: visible; }
  #workspaceBootLoader .elephant-art { pointer-events: none; }
  #workspaceBootLoader .elephant-leg { transform-box: fill-box; will-change: transform; }
  #workspaceBootLoader .elephant-leg-front { transform-origin:45% 55%; animation:boot-elephant-leg-front .72s cubic-bezier(.45,0,.55,1) infinite; }
  #workspaceBootLoader .elephant-leg-rear { transform-origin:77% 67%; animation:boot-elephant-leg-rear .72s cubic-bezier(.45,0,.55,1) infinite; }
  #workspaceBootLoader .elephant-shadow { fill:rgba(7,81,61,.12); transform-origin:center; animation:boot-elephant-shadow .72s ease-in-out infinite; }
  #workspaceBootLoader .elephant-figure { transform-origin:50% 84%; animation:boot-elephant-body .72s ease-in-out infinite; }
  @keyframes boot-elephant-body { 0%,100%{transform:translateY(0) rotate(-.25deg)} 25%,75%{transform:translateY(-3px) rotate(0)} 50%{transform:translateY(0) rotate(.25deg)} }
  @keyframes boot-elephant-leg-front { 0%,50%,100%{transform:translate(0,0) rotate(0)} 25%{transform:translate(-7px,-5px) rotate(2deg)} 75%{transform:translate(6px,1px) rotate(-1.4deg)} }
  @keyframes boot-elephant-leg-rear { 0%,50%,100%{transform:translate(0,0) rotate(0)} 25%{transform:translate(6px,1px) rotate(-1.4deg)} 75%{transform:translate(-7px,-5px) rotate(2deg)} }
  @keyframes boot-elephant-shadow { 0%,100%{transform:scaleX(1);opacity:.72} 50%{transform:scaleX(.84);opacity:.42} }
  @media (prefers-reduced-motion: reduce) {
    #workspaceBootLoader .elephant-figure,
    #workspaceBootLoader .elephant-leg,
    #workspaceBootLoader .elephant-shadow { animation-duration: 1.25s !important; }
  }
  @media print {
    #workspaceBootLoader { display: none !important; }
    html.page-booting body > :not(#workspaceBootLoader) { visibility: visible !important; }
  }
</style>
<script nonce="<%= cspNonce %>">
  document.documentElement.classList.add('page-booting');
  window.__reliacodeBootFallback = window.setTimeout(function () {
    document.documentElement.classList.remove('page-booting');
    var loader = document.getElementById('workspaceBootLoader');
    if (loader) loader.classList.remove('is-visible', 'is-booting');
  }, 15000);
</script>
<script src="/js/page-boot.js?v=20260920-page-v1" defer></script>
