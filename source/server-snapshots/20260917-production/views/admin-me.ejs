<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 我的 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260901c">
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260917-hardening-v2">
</head>
<body>
  <%- include('partials/nav', { active: 'me' }) %>

  <div class="container">
    <div class="page-header">
      <h1>我的</h1>
      <p>账号管理与系统设置</p>
    </div>

    <% const roleText2 = { AUDIT_VIEWER: '只读体验账号', admin: '平台管理员', brand: '品牌管理员', brand_staff: '品牌工作账号', factory: '工厂', warehouse: '品牌方', distributor: '代理商' }; %>

    <!-- 用户卡片 -->
    <div class="me-card">
      <span class="me-avatar"><%= (user.display_name || user.username).slice(0,1).toUpperCase() %></span>
      <div>
        <div class="me-name"><%= user.display_name %></div>
        <div class="me-meta">@<%= user.username %> · <%= roleText2[user.role] || user.role %></div>
      </div>
    </div>

    <!-- 主功能 -->
    <div class="menu-list">
      <a href="/profile" class="menu-item">
        <span class="mi-icon cyan"><%- icon('lock') %></span>
        <span class="mi-body"><span class="mi-title"><%= user.role === 'AUDIT_VIEWER' ? '账号资料（只读）' : '修改密码' %></span></span>
        <%- icon('chevron-right', 'mi-chevron') %>
      </a>
      <% if (user.role === 'admin' || user.role === 'AUDIT_VIEWER' || user.role === 'brand') { %><a href="/users" class="menu-item">
        <span class="mi-icon blue"><%- icon('user') %></span>
        <span class="mi-body"><span class="mi-title">账号管理</span></span>
        <%- icon('chevron-right', 'mi-chevron') %>
      </a><% } %>
      <a href="/logs" class="menu-item">
        <span class="mi-icon green"><%- icon('clipboard') %></span>
        <span class="mi-body"><span class="mi-title">扫码日志</span></span>
        <%- icon('chevron-right', 'mi-chevron') %>
      </a>
      <a href="/alerts" class="menu-item">
        <span class="mi-icon red"><%- icon('bell') %></span>
        <span class="mi-body"><span class="mi-title">预警中心</span></span>
        <% if (alertsUnread > 0) { %><span class="tag tag-red me-alert-count"><%= alertsUnread %></span><% } %>
        <%- icon('chevron-right', 'mi-chevron') %>
      </a>
      <% if (user.role === 'admin' || user.role === 'AUDIT_VIEWER') { %>
      <a href="/settings" class="menu-item">
        <span class="mi-icon purple"><%- icon('settings') %></span>
        <span class="mi-body"><span class="mi-title">品牌营销</span></span>
        <%- icon('chevron-right', 'mi-chevron') %>
      </a>
      <% } %>
    </div>

    <form method="POST" action="/logout" class="menu-list logout-menu">
      <button type="submit" class="menu-item logout-menu-button">
        <span class="mi-title logout-menu-title">退出登录</span>
      </button>
    </form>
  </div>
</body>
</html>
