<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <%- include('partials/boot-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 个人设置 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260901c">
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260903a">
</head>
<body>
  <%- include('partials/boot-loader') %>
  <%- include('partials/nav', { active: 'profile' }) %>

  <main class="container profile-layout">
    <section class="profile-identity" aria-labelledby="profileTitle">
      <div class="profile-avatar"><%= (user.display_name || user.username).slice(0,1).toUpperCase() %></div>
      <div>
        <h1 id="profileTitle"><%= user.display_name %></h1>
        <dl class="profile-facts">
          <div><dt>登录账号</dt><dd><%= user.username %></dd></div>
          <div><dt>账号角色</dt><dd><%= roleNames[user.role] || user.role %></dd></div>
          <% if (user.role === 'factory') { %>
          <div><dt>所属工厂</dt><dd data-profile-factory-name><%= user.factory_name || '未配置' %></dd></div>
          <div><dt>负责品牌</dt><dd data-profile-brand-name><%= user.responsible_brand_name || '未配置' %></dd></div>
          <% } %>
        </dl>
      </div>
    </section>

    <section class="profile-password-panel" aria-labelledby="passwordTitle">
      <header class="profile-password-head">
        <h2 id="passwordTitle">修改密码</h2>
        <ol class="password-progress" aria-label="修改密码步骤">
          <li class="is-active" id="passwordProgressVerify"><span>1</span>验证原密码</li>
          <li id="passwordProgressNew"><span>2</span>设置新密码</li>
        </ol>
      </header>

      <div id="oldPasswordStage" class="password-stage">
        <div class="form-group">
          <label for="oldPwd">原密码</label>
          <input type="password" id="oldPwd" class="form-control" autocomplete="current-password" placeholder="输入当前登录密码">
        </div>
        <button class="btn btn-primary" id="verifyOldPwdBtn" type="button">验证并继续</button>
      </div>

      <div id="newPasswordStage" class="password-stage password-stage-new" hidden>
        <div class="password-verified"><span>✓</span> 原密码验证通过</div>
        <div class="profile-password-grid">
          <div class="form-group">
            <label for="newPwd">新密码</label>
            <input type="password" id="newPwd" class="form-control" autocomplete="new-password" placeholder="至少 12 位">
          </div>
          <div class="form-group">
            <label for="newPwd2">确认新密码</label>
            <input type="password" id="newPwd2" class="form-control" autocomplete="new-password" placeholder="再次输入新密码">
          </div>
        </div>
        <details class="password-rules"><summary>密码要求</summary><p>至少 12 位，并包含大小写字母、数字和符号。</p></details>
        <button class="btn btn-primary" id="changePwdBtn" type="button">保存新密码</button>
      </div>
    </section>
  </main>

  <script nonce="<%= cspNonce %>">
    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }
    let oldPasswordVerified = false;
    const oldPwdInput = document.getElementById('oldPwd');
    const newPasswordStage = document.getElementById('newPasswordStage');
    const verifyButton = document.getElementById('verifyOldPwdBtn');

    function resetPasswordStage() {
      oldPasswordVerified = false;
      newPasswordStage.hidden = true;
      document.getElementById('passwordProgressVerify').classList.add('is-active');
      document.getElementById('passwordProgressNew').classList.remove('is-active');
      verifyButton.disabled = false;
      verifyButton.textContent = '验证并继续';
    }

    async function verifyOldPassword() {
      const old_password = oldPwdInput.value;
      if (!old_password) { toast('请输入原密码', 'error'); return; }
      verifyButton.disabled = true;
      verifyButton.textContent = '正在验证';
      try {
        const res = await fetch('/api/profile/password/verify', {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ old_password })
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          resetPasswordStage();
          toast(data.msg || '原密码错误', 'error');
          oldPwdInput.focus();
          return;
        }
        oldPasswordVerified = true;
        newPasswordStage.hidden = false;
        document.getElementById('passwordProgressVerify').classList.remove('is-active');
        document.getElementById('passwordProgressNew').classList.add('is-active');
        verifyButton.textContent = '已验证';
        verifyButton.disabled = true;
        document.getElementById('newPwd').focus();
      } catch (_error) {
        resetPasswordStage();
        toast('验证失败，请稍后重试', 'error');
      }
    }

    async function changePwd() {
      const old_password = document.getElementById('oldPwd').value;
      const p1 = document.getElementById('newPwd').value;
      const p2 = document.getElementById('newPwd2').value;
      if (!oldPasswordVerified) { toast('请先验证原密码', 'error'); return; }
      if (!p1 || !p2) { toast('请填写新密码', 'error'); return; }
      if (!(p1.length >= 12 && /[a-z]/.test(p1) && /[A-Z]/.test(p1) && /[0-9]/.test(p1) && /[^A-Za-z0-9\s]/.test(p1))) { toast('密码至少12位，包含大小写字母、数字和符号', 'error'); return; }
      if (p1 !== p2) { toast('两次输入的新密码不一致', 'error'); return; }
      const res = await fetch('/api/profile/password', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ old_password, new_password: p1 })
      });
      const d = await res.json();
      if (d.success) {
        toast('密码已修改');
        document.getElementById('oldPwd').value = '';
        document.getElementById('newPwd').value = '';
        document.getElementById('newPwd2').value = '';
        resetPasswordStage();
      } else toast(d.msg || '修改失败', 'error');
    }
    oldPwdInput.addEventListener('input', () => {
      if (oldPasswordVerified) {
        document.getElementById('newPwd').value = '';
        document.getElementById('newPwd2').value = '';
        resetPasswordStage();
      }
    });
    document.getElementById('verifyOldPwdBtn').addEventListener('click', verifyOldPassword);
    oldPwdInput.addEventListener('keydown', event => {
      if (event.key === 'Enter') { event.preventDefault(); verifyOldPassword(); }
    });
    document.getElementById('changePwdBtn').addEventListener('click', changePwd);
  </script>
</body>
</html>
