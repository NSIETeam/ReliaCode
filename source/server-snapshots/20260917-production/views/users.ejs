<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ffffff">
  <title>ClawMaster / 账号管理 - <%= brand %></title>
  <link rel="stylesheet" href="/css/style.css?v=20260901c">
  <style nonce="<%= cspNonce %>">
    .modal-mask { display:none; position:fixed; inset:0; background:#fff; z-index:100;
      align-items:center; justify-content:center; }
    .modal-mask.show { display:flex; }
    .modal { background:#fff; border-radius:12px; padding:24px; width:400px; max-width:92vw; max-height:90vh; overflow:auto; }
    .modal h3 { margin-bottom:16px; font-size:16px; }
  </style>
  <link rel="stylesheet" href="/css/clawmaster.css?v=20260917-hardening-v2">
</head>
<body>
  <%- include('partials/nav', { active: 'users' }) %>

  <div class="container">
    <h1 class="sr-only">账号管理</h1>
    <div class="card">
      <div class="card-title split-title">
        <span>账号管理</span>
        <button id="openCreateBtn" class="btn btn-primary btn-sm" type="button"><%- icon('plus') %> 新建账号</button>
      </div>
      <p class="section-help">
        角色说明：平台管理员=全部功能（含品牌管理）；品牌管理员=本品牌的完整独立界面（产品/码/工厂/代理商/发货/预警）；工厂装箱=仅装箱作业（只管理本厂产品）；品牌方=仅发货作业；代理商=仅查看自己的库存与扫码数据。<br>
        合作方自助注册：在下方「邀请码管理」生成邀请码发给合作工厂/代理商，对方打开登录页点「注册账号」凭码自助注册。<br>
        <b>多品牌售卖流程：</b>先在「品牌管理」创建品牌 → 在上方「新建账号」选角色「品牌管理员」并绑定该品牌 → 把账号密码交给客户，客户登录后只能看到自己品牌的数据。
      </p>
      <table class="table">
        <thead>
          <tr>
            <th>账号</th><th>姓名</th><th>手机号</th><th>角色</th><th>归属品牌</th><th>绑定工厂</th><th>绑定代理商</th>
            <th>状态</th><th>最近登录</th><th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td class="mono-text"><%= u.username %></td>
            <td><%= u.display_name || '-' %></td>
            <td class="mono-text"><%= u.phone || '-' %></td>
            <td><span class="tag <%= u.role==='admin' ? 'tag-blue' : (u.role==='brand' ? 'tag-yellow' : 'tag-green') %>"><%= roleNames[u.role] || u.role %></span></td>
            <td><%= u.role === 'admin' ? '全部品牌' : (u.brand_name || '<未绑定>') %></td>
            <td><%= u.factory_name || '-' %></td>
            <td><%= u.distributor_name || '-' %></td>
            <td><%= u.enabled ? '<span class="tag tag-green">启用</span>' : '<span class="tag tag-red">停用</span>' %></td>
            <td class="small-text secondary-text"><%= u.last_login_at || '从未登录' %></td>
            <td class="no-wrap">
              <button class="btn btn-outline btn-sm edit-user-btn" type="button" data-user-id="<%= u.id %>">编辑</button>
              <button class="btn btn-outline btn-sm reset-user-password-btn" type="button" data-user-id="<%= u.id %>" data-username="<%= u.username %>">重置密码</button>
              <% if (u.username !== 'admin') { %>
                <button class="btn btn-outline btn-sm toggle-user-btn" type="button" data-user-id="<%= u.id %>" data-user-enabled="<%= u.enabled ? 0 : 1 %>"><%= u.enabled ? '停用' : '启用' %></button>
                <button class="btn btn-outline btn-sm delete-user-btn danger-action" type="button" data-user-id="<%= u.id %>" data-username="<%= u.username %>">删除</button>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (user.role === 'admin') { %>
    <!-- 品牌管理（平台管理员专用） -->
    <div class="card mt-16">
      <div class="card-title split-title">
        <span>品牌管理</span>
        <div class="modal-actions">
          <input type="text" id="brandName" class="form-control compact-150-control" placeholder="品牌名称">
          <input type="text" id="brandContact" class="form-control compact-150-control" placeholder="联系人（选填）">
          <button id="createBrandBtn" class="btn btn-primary btn-sm" type="button"><%- icon('plus') %> 新建品牌</button>
        </div>
      </div>
      <p class="section-help">
        每个品牌是一套独立的数据空间：产品、码、工厂、代理商、发货、预警互不可见。创建品牌后，在上方「新建账号」选角色「品牌管理员」并绑定该品牌，账号密码交给客户即可。
      </p>
      <table class="table">
        <thead>
          <tr><th>品牌</th><th>联系人</th><th>产品</th><th>工厂</th><th>代理商</th><th>账号</th><th>状态</th><th>创建时间</th><th>操作</th></tr>
        </thead>
        <tbody id="brandBody">
          <tr><td colspan="9" class="text-center muted-text">加载中…</td></tr>
        </tbody>
      </table>
    </div>
    <% } %>

    <!-- 工厂列表（admin/brand/brand_staff 可管理） -->
    <div class="card mt-16">
      <div class="card-title split-title">
        <span>工厂管理</span>
        <div class="flex-actions-wrap">
          <% if (user.role === 'admin') { %>
          <select id="factoryBrand" class="form-control compact-auto-control">
            <option value="">归属品牌（工厂必选）</option>
            <% brands.forEach(b => { %>
              <option value="<%= b.id %>"><%= b.name %></option>
            <% }); %>
          </select>
          <% } %>
          <button id="addFactoryBtn" class="btn btn-primary btn-sm" type="button"><%- icon('plus') %> 新建工厂</button>
        </div>
      </div>
      <p class="section-help">
        工厂用于组织装箱团队，归属于品牌。产品可授权给多家工厂，但每次实际入库会锁定生产工厂；其他工厂不能继续装箱或取消。存在历史记录的工厂会停用归档，不会物理删除。
      </p>
      <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>ID</th><th>工厂名</th><th>联系人</th><th>归属品牌</th><th>状态</th><th>账号数</th><th>创建时间</th><th class="action-column">操作</th></tr>
        </thead>
        <tbody id="factoryBody">
          <tr><td colspan="8" class="text-center muted-text">加载中…</td></tr>
        </tbody>
      </table>
      </div>
    </div>

    <!-- 邀请码管理 -->
    <div class="card mt-16">
      <div class="card-title split-title">
        <span>邀请码管理</span>
        <div class="flex-actions-wrap">
          <% if (user.role === 'admin') { %>
          <select id="invBrand" class="form-control compact-auto-control">
            <option value="">选择品牌（注册归属）</option>
            <% brands.forEach(b => { %>
              <option value="<%= b.id %>"><%= b.name %></option>
            <% }); %>
          </select>
          <% } %>
          <select id="invRole" class="form-control compact-auto-control">
            <option value="factory">工厂注册码</option>
            <option value="distributor">代理商注册码</option>
            <% if (user.role === 'admin') { %><option value="brand">品牌管理员注册码</option><% } %>
          </select>
          <select id="invFactory" class="form-control compact-auto-control is-hidden">
            <option value="">选择归属工厂（工厂注册码必选）</option>
            <% factories.forEach(f => { %>
              <option value="<%= f.id %>"><%= f.name %></option>
            <% }); %>
          </select>
          <input type="text" id="invNote" class="form-control compact-160-control" placeholder="备注（发给谁）">
          <button id="genInviteBtn" class="btn btn-primary btn-sm" type="button"><%- icon('plus') %> 生成邀请码</button>
        </div>
      </div>
      <p class="section-help">
        生成后把注册链接或邀请码发给合作方：对方打开 <b>/register</b> 页面凭码自助注册，注册即用，每个码只能用一次。<% if (user.role === 'admin') { %>平台管理员生成时请先选择归属品牌，否则该码注册的账号将不属于任何品牌。<% } %>
      </p>
      <table class="table">
        <thead>
          <tr><th>邀请码</th><th>类型</th><th>归属品牌</th><th>归属工厂</th><th>备注</th><th>状态</th><th>注册账号</th><th>注册人姓名</th><th>生成时间</th><th>操作</th></tr>
        </thead>
        <tbody id="invBody">
          <% if (!invitations.length) { %>
          <tr><td colspan="10" class="text-center muted-text">暂无邀请码，点击右上角生成</td></tr>
          <% } %>
          <% invitations.forEach(v => { %>
          <tr id="invRow-<%= v.id %>">
            <td class="mono-text font-semibold"><%= v.code %></td>
            <td><span class="tag <%= v.role==='factory' ? 'tag-green' : (v.role==='brand' ? 'tag-yellow' : 'tag-blue') %>"><%= v.role==='factory' ? '工厂' : (v.role==='brand' ? '品牌管理员' : '代理商') %></span></td>
            <td><%= v.brand_name || '<未指定>' %></td>
            <td><%= v.factory_name || '-' %></td>
            <td><%= v.note || '-' %></td>
            <td><% if (v.status === 0) { %><span class="tag tag-green">未使用</span><% } else if (v.status === 1) { %><span class="tag tag-used">已使用</span><% } else { %><span class="tag tag-red">已作废</span><% } %></td>
            <td class="mono-text"><%= v.used_by || '-' %></td>
            <td><%= v.user_name || '-' %></td>
            <td class="small-text secondary-text"><%= v.created_at %></td>
            <td class="no-wrap">
              <% if (v.status === 0) { %>
                <button class="btn btn-outline btn-sm copy-invite-btn" type="button" data-invite-code="<%= v.code %>">复制链接</button>
                <button class="btn btn-outline btn-sm revoke-invite-btn warning-action" type="button" data-invite-id="<%= v.id %>">作废</button>
              <% } %>
              <button class="btn btn-outline btn-sm delete-invite-btn danger-action" type="button" data-invite-id="<%= v.id %>" data-invite-code="<%= v.code %>" data-invite-status="<%= v.status %>">删除</button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 新建/编辑弹窗 -->
  <div class="modal-mask" id="mask">
    <div class="modal">
      <h3 id="modalTitle">新建账号</h3>
      <div class="form-group">
        <label>账号（3-20位字母/数字/下划线）</label>
        <input type="text" id="fUsername" class="form-control">
      </div>
      <div class="form-group">
        <label>姓名（用于操作留痕显示）</label>
        <input type="text" id="fDisplay" class="form-control">
      </div>
      <div class="form-group">
        <label>手机号（工厂装箱账号必填）</label>
        <input type="tel" id="fPhone" class="form-control" placeholder="11位手机号" maxlength="11">
      </div>
      <div class="form-group">
        <label>角色</label>
        <select id="fRole" class="form-control">
          <% if (user.role === 'admin') { %>
          <option value="admin">平台管理员</option>
          <option value="brand">品牌管理员</option>
          <% } %>
          <option value="brand_staff">品牌方工作账号</option>
          <option value="factory">工厂装箱</option>
          <option value="warehouse">品牌方</option>
          <option value="distributor">代理商</option>
        </select>
      </div>
      <div class="form-group is-hidden" id="brandGroup">
        <label>归属品牌（品牌方角色必选）</label>
        <select id="fBrand" class="form-control">
          <option value="">请选择品牌</option>
          <% brands.forEach(b => { %>
            <option value="<%= b.id %>"><%= b.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group is-hidden" id="facGroup">
        <label>绑定工厂</label>
        <div class="modal-actions">
          <select id="fFactory" class="form-control flex-1">
            <option value="">请选择工厂</option>
            <% factories.forEach(f => { %>
              <option value="<%= f.id %>"><%= f.name %></option>
            <% }); %>
          </select>
          <button id="newFactoryBtn" type="button" class="btn btn-outline btn-sm"><%- icon('plus') %> 新建</button>
        </div>
      </div>
      <div class="form-group is-hidden" id="distGroup">
        <label>绑定代理商</label>
        <select id="fDistributor" class="form-control">
          <option value="">请选择代理商</option>
          <% distributors.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.name %>（<%= d.region || '未设置区域' %>）</option>
          <% }); %>
        </select>
      </div>
      <div class="form-group" id="pwdGroup">
        <label for="fPassword">初始密码（至少12位，包含大小写字母、数字和符号）</label>
        <input type="password" id="fPassword" class="form-control" autocomplete="new-password" placeholder="至少12位，含大小写、数字和符号">
      </div>
      <div class="form-modal-actions">
        <button id="closeUserModalBtn" class="btn btn-outline" type="button">取消</button>
        <button id="saveUserBtn" class="btn btn-primary" type="button">保存</button>
      </div>
    </div>
  </div>

  <script nonce="<%= cspNonce %>">
    let editingId = null;
    const passwordIsValid = value => { const password = String(value || ''); return password.length >= 12 && /[a-z]/.test(password) && /[A-Z]/.test(password) && /[0-9]/.test(password) && /[^A-Za-z0-9\s]/.test(password); };
    function toast(msg, type) {
      const t = document.createElement('div');
      t.className = 'toast ' + (type || 'success');
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3000);
    }
    const usersData = <%- JSON.stringify(users) %>;
    const myRole = <%- JSON.stringify(user && user.role) %>;
    const ROLE_TEXT = { admin: '平台管理员', brand: '品牌管理员', brand_staff: '品牌方工作账号' };
    const BRAND_BOUND_ROLES = ['brand', 'brand_staff', 'warehouse'];
    const requiresBrand = role => BRAND_BOUND_ROLES.includes(role);

    function openCreate() {
      editingId = null;
      document.getElementById('modalTitle').textContent = '新建账号';
      document.getElementById('fUsername').value = '';
      document.getElementById('fUsername').disabled = false;
      document.getElementById('fDisplay').value = '';
      document.getElementById('fPhone').value = '';
      document.getElementById('fRole').disabled = false;
      document.getElementById('fRole').value = 'factory';
      document.getElementById('fPassword').value = '';
      document.getElementById('fPassword').parentElement.classList.remove('is-hidden');
      document.getElementById('distGroup').classList.add('is-hidden');
      document.getElementById('facGroup').classList.remove('is-hidden');
      document.getElementById('brandGroup').classList.add('is-hidden');
      document.getElementById('fBrand').value = '';
      document.getElementById('mask').classList.add('show');
    }
    function openEdit(id) {
      const u = usersData.find(x => x.id === id);
      if (!u) return;
      editingId = id;
      document.getElementById('modalTitle').textContent = '编辑账号：' + u.username;
      document.getElementById('fUsername').value = u.username;
      document.getElementById('fUsername').disabled = true;
      document.getElementById('fDisplay').value = u.display_name || '';
      document.getElementById('fPhone').value = u.phone || '';
      const fRole = document.getElementById('fRole');
      if (![...fRole.options].some(o => o.value === u.role) && ROLE_TEXT[u.role]) {
        const opt = document.createElement('option');
        opt.value = u.role; opt.textContent = ROLE_TEXT[u.role];
        fRole.appendChild(opt);
      }
      fRole.value = u.role;
      // 品牌管理员无权修改平台/品牌管理员的角色，锁定下拉
      fRole.disabled = myRole !== 'admin' && ['admin', 'brand'].includes(u.role);
      document.getElementById('fPassword').value = '';
      document.getElementById('fPassword').parentElement.classList.add('is-hidden');
      document.getElementById('distGroup').classList.toggle('is-hidden', u.role !== 'distributor');
      document.getElementById('facGroup').classList.toggle('is-hidden', u.role !== 'factory');
      document.getElementById('brandGroup').classList.toggle('is-hidden', !requiresBrand(u.role));
      document.getElementById('fDistributor').value = u.distributor_id || '';
      document.getElementById('fFactory').value = u.factory_id || '';
      document.getElementById('fBrand').value = u.brand_id || '';
      document.getElementById('mask').classList.add('show');
    }
    function closeModal() { document.getElementById('mask').classList.remove('show'); }

    document.getElementById('fRole').addEventListener('change', function () {
      document.getElementById('distGroup').classList.toggle('is-hidden', this.value !== 'distributor');
      document.getElementById('facGroup').classList.toggle('is-hidden', this.value !== 'factory');
      const bg = document.getElementById('brandGroup');
      if (bg) bg.classList.toggle('is-hidden', !requiresBrand(this.value));
    });

    async function saveUser() {
      const role = document.getElementById('fRole').value;
      const body = {
        username: document.getElementById('fUsername').value.trim(),
        display_name: document.getElementById('fDisplay').value.trim(),
        phone: document.getElementById('fPhone').value.trim(),
        role: role,
        distributor_id: document.getElementById('fDistributor').value || null,
        factory_id: document.getElementById('fFactory').value || null,
        brand_id: requiresBrand(role) ? (document.getElementById('fBrand').value || null) : null,
        password: document.getElementById('fPassword').value
      };
      if (!editingId && !passwordIsValid(body.password)) {
        toast('密码至少12位，包含大小写字母、数字和符号', 'error'); return;
      }
      if (requiresBrand(role) && !body.brand_id) { toast('该品牌方角色必须选择归属品牌', 'error'); return; }
      // 工厂装箱账号：人名 + 手机号 + 工厂 三项必填
      if (role === 'factory') {
        if (!body.display_name) { toast('工厂装箱账号必须填写人名', 'error'); return; }
        if (!/^1\d{10}$/.test(body.phone)) { toast('工厂装箱账号必须填写11位手机号', 'error'); return; }
        if (!body.factory_id) { toast('工厂装箱账号必须选择绑定工厂', 'error'); return; }
      }
      let res, d;
      if (editingId) {
        res = await fetch('/api/users/' + editingId, {
          method: 'PUT', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ display_name: body.display_name, phone: body.phone, role: body.role, distributor_id: body.distributor_id, factory_id: body.factory_id, brand_id: body.brand_id })
        });
      } else {
        res = await fetch('/api/users', {
          method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body)
        });
      }
      d = await res.json();
      if (d.success) { toast(d.msg || '已保存'); setTimeout(() => location.reload(), 600); }
      else toast(d.msg || '保存失败', 'error');
    }

    // ===== 邀请码管理 =====
    async function newFactory() {
      const name = prompt('新工厂名称：');
      if (!name || !name.trim()) return;
      const res = await fetch('/api/factories', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ name: name.trim() })
      });
      const d = await res.json();
      if (d.success) {
        const sel = document.getElementById('fFactory');
        const opt = document.createElement('option');
        opt.value = d.id; opt.textContent = name.trim();
        sel.appendChild(opt); sel.value = d.id;
        toast('工厂已创建，已自动选中');
      } else toast(d.msg || '创建失败', 'error');
    }
    async function genInvite() {
      const brandSel = document.getElementById('invBrand');
      const brandId = brandSel ? (brandSel.value || null) : null;
      if (brandSel && !brandId) { toast('请先为邀请码选择归属品牌', 'error'); return; }
      const role = document.getElementById('invRole').value;
      // 工厂注册码：必须选择归属工厂（固定项）
      const factorySel = document.getElementById('invFactory');
      const factoryId = (role === 'factory' && factorySel) ? (factorySel.value || null) : null;
      if (role === 'factory' && !factoryId) { toast('工厂注册码必须选择归属工厂（请先在工厂管理建档）', 'error'); return; }
      const res = await fetch('/api/invitations', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ role, note: document.getElementById('invNote').value.trim(), brand_id: brandId, factory_id: factoryId })
      });
      const d = await res.json();
      if (d.success) { toast('已生成：' + d.code); setTimeout(() => location.reload(), 500); }
      else toast(d.msg || '生成失败', 'error');
    }

    // ===== 品牌管理（平台管理员） =====
    async function loadBrands() {
      const body = document.getElementById('brandBody');
      if (!body) return;
      try {
        const res = await fetch('/api/brands');
        const d = await res.json();
        if (!d.success) { body.innerHTML = '<tr><td colspan="9" class="text-center muted-text">加载失败</td></tr>'; return; }
        if (!d.brands.length) { body.innerHTML = '<tr><td colspan="9" class="text-center muted-text">暂无品牌，点击右上角新建</td></tr>'; return; }
        body.innerHTML = d.brands.map(b => `
          <tr>
            <td class="font-semibold">${esc(b.name)}</td>
            <td>${esc(b.contact || '-')}</td>
            <td>${Number(b.product_count) || 0}</td>
            <td>${Number(b.factory_count) || 0}</td>
            <td>${Number(b.distributor_count) || 0}</td>
            <td>${Number(b.user_count) || 0}</td>
            <td>${b.enabled ? '<span class="tag tag-green">启用</span>' : '<span class="tag tag-red">停用</span>'}</td>
            <td class="small-text secondary-text">${esc(b.created_at || '-')}</td>
            <td class="no-wrap">
              <button class="btn btn-outline btn-sm rename-brand-btn" type="button" data-brand-id="${Number(b.id)}" data-brand-name="${esc(b.name || '')}">改名</button>
              <button class="btn btn-outline btn-sm toggle-brand-btn ${b.enabled ? 'warning-action' : ''}" type="button" data-brand-id="${Number(b.id)}" data-brand-enabled="${b.enabled ? 0 : 1}">${b.enabled ? '停用' : '启用'}</button>
              <button class="btn btn-outline btn-sm delete-brand-btn danger-action" type="button" data-brand-id="${Number(b.id)}" data-brand-name="${esc(b.name || '')}">删除</button>
            </td>
          </tr>`).join('');
        body.querySelectorAll('.rename-brand-btn').forEach(button => {
          button.addEventListener('click', () => renameBrand(Number(button.dataset.brandId), button.dataset.brandName));
        });
        body.querySelectorAll('.toggle-brand-btn').forEach(button => {
          button.addEventListener('click', () => toggleBrand(Number(button.dataset.brandId), Number(button.dataset.brandEnabled)));
        });
        body.querySelectorAll('.delete-brand-btn').forEach(button => {
          button.addEventListener('click', () => deleteBrand(Number(button.dataset.brandId), button.dataset.brandName));
        });
      } catch (e) {
        body.innerHTML = '<tr><td colspan="9" class="text-center muted-text">加载失败</td></tr>';
      }
    }
    async function createBrand() {
      const name = document.getElementById('brandName').value.trim();
      if (!name) { toast('请输入品牌名称', 'error'); return; }
      const res = await fetch('/api/brands', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ name, contact: document.getElementById('brandContact').value.trim() })
      });
      const d = await res.json();
      if (d.success) { toast('品牌已创建，刷新页面即可在账号/邀请码中绑定该品牌'); setTimeout(() => location.reload(), 800); }
      else toast(d.msg || '创建失败', 'error');
    }
    async function renameBrand(id, oldName) {
      const name = prompt('修改品牌名称：', oldName);
      if (!name || !name.trim() || name.trim() === oldName) return;
      const res = await fetch('/api/brands/' + id, {
        method: 'PUT', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ name: name.trim() })
      });
      const d = await res.json();
      if (d.success) { toast('已改名'); setTimeout(() => location.reload(), 500); }
      else toast(d.msg || '操作失败', 'error');
    }
    async function toggleBrand(id, enabled) {
      if (!confirm(enabled ? '停用后该品牌所有账号将无法登录（数据保留），确定停用？' : '确定重新启用该品牌？')) return;
      const res = await fetch('/api/brands/' + id, {
        method: 'PUT', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ enabled: !!enabled })
      });
      const d = await res.json();
      if (d.success) { toast('已' + (enabled ? '启用' : '停用')); setTimeout(() => location.reload(), 500); }
      else toast(d.msg || '操作失败', 'error');
    }
    async function deleteBrand(id, name) {
      if (!confirm('确定删除空品牌「' + name + '」吗？已有账号或业务历史的品牌不会被删除，只能停用。')) return;
      const res = await fetch('/api/brands/' + id, { method: 'DELETE' });
      const d = await res.json();
      if (d.success) { toast('品牌已删除'); setTimeout(() => location.reload(), 500); }
      else toast(d.msg || '删除失败', 'error');
    }
    loadBrands();
    loadFactories();

    // ===== 工厂列表 =====
    async function loadFactories() {
      const body = document.getElementById('factoryBody');
      if (!body) return;
      try {
        const res = await fetch('/api/factories');
        const d = await res.json();
        if (!d.success) { body.innerHTML = '<tr><td colspan="8" class="text-center muted-text">加载失败</td></tr>'; return; }
        if (!d.factories.length) { body.innerHTML = '<tr><td colspan="8" class="text-center muted-text">暂无工厂，点击右上角新建</td></tr>'; return; }
        body.innerHTML = d.factories.map(f => `
          <tr>
            <td>${Number(f.id)}</td>
            <td class="font-semibold">${esc(f.name)}</td>
            <td>${esc(f.contact || '-')}</td>
            <td>${esc(f.brand_name || '-')}</td>
            <td>${f.enabled ? '<span class="status-pill success">启用</span>' : '<span class="status-pill">已归档</span>'}</td>
            <td id="fc-${f.id}">…</td>
            <td class="small-text secondary-text">${esc(f.created_at || '-')}</td>
            <td class="no-wrap">
              <button class="btn btn-outline btn-sm delete-factory-btn danger-action" type="button" data-factory-id="${Number(f.id)}" data-factory-name="${esc(f.name)}" ${f.enabled ? '' : 'disabled aria-disabled="true"'}>${f.enabled ? '删除/归档' : '已归档'}</button>
            </td>
          </tr>`).join('');
        body.querySelectorAll('.delete-factory-btn').forEach(button => {
          button.addEventListener('click', () => deleteFactory(Number(button.dataset.factoryId), button.dataset.factoryName));
        });
        // 拉账号数
        d.factories.forEach(f => {
          fetch('/api/users').then(r => r.json()).then(ud => {
            if (!ud.success) return;
            const c = ud.users.filter(u => u.factory_id === f.id).length;
            const cell = document.getElementById('fc-' + f.id);
            if (cell) cell.textContent = c;
          });
        });
      } catch (e) {
        body.innerHTML = '<tr><td colspan="8" class="text-center muted-text">加载失败</td></tr>';
      }
    }
    function esc(s) { return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    async function addFactory() {
      const name = prompt('新工厂名称（必填）：');
      if (!name || !name.trim()) return;
      const contact = prompt('联系人（选填）：') || '';
      const brandSel = document.getElementById('factoryBrand');
      const brand_id = brandSel ? (brandSel.value || null) : null;
      if (brandSel && !brand_id) { toast('请先在「归属品牌」下拉框选择品牌', 'error'); return; }
      const res = await fetch('/api/factories', {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ name: name.trim(), contact: contact.trim(), brand_id: brand_id })
      });
      const d = await res.json();
      if (d.success) { toast('工厂已创建'); loadFactories(); }
      else toast(d.msg || '创建失败', 'error');
    }
    async function deleteFactory(id, name) {
      if (!confirm('确定处理工厂「' + name + '」吗？\n\n空工厂会删除；已有历史记录的工厂会停用归档并保留审计资料；存在在库实物时系统会阻止操作。')) return;
      const res = await fetch('/api/factories/' + id, { method: 'DELETE' });
      const d = await res.json();
      if (d.success) { toast(d.msg || '已删除'); loadFactories(); }
      else toast(d.msg || '删除失败', 'error');
    }
    function copyInvite(code) {
      const url = location.origin + '/register?code=' + code;
      if (navigator.clipboard) navigator.clipboard.writeText(url);
      prompt('注册链接（已尝试复制到剪贴板），发给合作方即可：', url);
    }
    async function revokeInvite(id) {
      if (!confirm('确定作废该邀请码？作废后无法再用于注册。')) return;
      const res = await fetch('/api/invitations/' + id, { method: 'DELETE' });
      const d = await res.json();
      if (d.success) location.reload();
      else toast(d.msg || '操作失败', 'error');
    }
    async function delInvite(id, code, status) {
      const msg = status === 1
        ? '该邀请码已被使用（已注册的账号不受影响），确定删除这条记录吗？'
        : '确定删除邀请码「' + code + '」的记录吗？删除后不可恢复。';
      if (!confirm(msg)) return;
      const res = await fetch('/api/invitations/' + id + '?hard=1', { method: 'DELETE' });
      const d = await res.json();
      if (d.success) location.reload();
      else toast(d.msg || '操作失败', 'error');
    }

    async function resetPwd(id, username) {
      const pwd = prompt('为账号「' + username + '」设置新密码（至少12位，包含大小写字母、数字和符号）：');
      if (pwd === null) return;
      if (!passwordIsValid(pwd)) { toast('密码至少12位，包含大小写字母、数字和符号', 'error'); return; }
      const res = await fetch('/api/users/' + id, {
        method: 'PUT', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ password: pwd })
      });
      const d = await res.json();
      toast(d.msg || (d.success ? '已重置' : '操作失败'), d.success ? 'success' : 'error');
    }

    async function toggleUser(id, enabled) {
      const res = await fetch('/api/users/' + id, {
        method: 'PUT', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ enabled: !!enabled })
      });
      const d = await res.json();
      if (d.success) location.reload();
      else toast(d.msg || '操作失败', 'error');
    }

    async function delUser(id, username) {
      if (!confirm('确定删除账号「' + username + '」？此操作不可恢复。')) return;
      const res = await fetch('/api/users/' + id, { method: 'DELETE' });
      const d = await res.json();
      if (d.success) location.reload();
      else toast(d.msg || '删除失败', 'error');
    }

    document.getElementById('openCreateBtn').addEventListener('click', openCreate);
    document.getElementById('newFactoryBtn').addEventListener('click', newFactory);
    document.getElementById('closeUserModalBtn').addEventListener('click', closeModal);
    document.getElementById('saveUserBtn').addEventListener('click', saveUser);
    document.getElementById('addFactoryBtn').addEventListener('click', addFactory);
    document.getElementById('genInviteBtn').addEventListener('click', genInvite);
    // 工厂下拉框仅在「工厂注册码」时显示并必选
    (function () {
      const roleSel = document.getElementById('invRole');
      const facSel = document.getElementById('invFactory');
      if (roleSel && facSel) {
        const sync = function () {
          facSel.classList.toggle('is-hidden', roleSel.value !== 'factory');
        };
        roleSel.addEventListener('change', sync);
        sync();
      }
    })();
    const createBrandButton = document.getElementById('createBrandBtn');
    if (createBrandButton) createBrandButton.addEventListener('click', createBrand);
    document.querySelectorAll('.edit-user-btn').forEach(button => {
      button.addEventListener('click', () => openEdit(Number(button.dataset.userId)));
    });
    document.querySelectorAll('.reset-user-password-btn').forEach(button => {
      button.addEventListener('click', () => resetPwd(Number(button.dataset.userId), button.dataset.username));
    });
    document.querySelectorAll('.toggle-user-btn').forEach(button => {
      button.addEventListener('click', () => toggleUser(Number(button.dataset.userId), Number(button.dataset.userEnabled)));
    });
    document.querySelectorAll('.delete-user-btn').forEach(button => {
      button.addEventListener('click', () => delUser(Number(button.dataset.userId), button.dataset.username));
    });
    document.querySelectorAll('.copy-invite-btn').forEach(button => {
      button.addEventListener('click', () => copyInvite(button.dataset.inviteCode));
    });
    document.querySelectorAll('.revoke-invite-btn').forEach(button => {
      button.addEventListener('click', () => revokeInvite(Number(button.dataset.inviteId)));
    });
    document.querySelectorAll('.delete-invite-btn').forEach(button => {
      button.addEventListener('click', () => delInvite(
        Number(button.dataset.inviteId), button.dataset.inviteCode, Number(button.dataset.inviteStatus)
      ));
    });
  </script>
</body>
</html>
