# ReliaCode same-origin Web/API edge template. Review before installing.
# This file is intentionally not an active server configuration.

server {
    listen 80;
    listen [::]:80;
    server_name reliacode.example.com;

    # Certbot/ACME HTTP-01 must remain reachable over HTTP.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }

    location / {
        return 308 https://reliacode.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name reliacode.example.com;

    ssl_certificate /etc/letsencrypt/live/reliacode.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reliacode.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;

    # Only enable HSTS on the HTTPS virtual host; never emit it during HTTP bootstrap.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    location / {
        # Web serves static assets and proxies /api plus /health/ready to API.
        proxy_pass http://127.0.0.1:4173;
        proxy_http_version 1.1;
        proxy_set_header Host reliacode.example.com;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace, rather than append, client-supplied forwarding chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
