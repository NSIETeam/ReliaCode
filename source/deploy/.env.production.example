# Copy to deploy/.env only on the target host. Never commit the real file.
RELIACODE_API_IMAGE=ghcr.io/nsieteam/reliacode-api:sha-0000000000000000000000000000000000000000
RELIACODE_WEB_IMAGE=ghcr.io/nsieteam/reliacode-web:sha-0000000000000000000000000000000000000000
WEB_PORT=4173
DEPLOYMENT_ENVIRONMENT=production
REQUIRE_DEVICE_AUTHORIZATION=true
SYSTEM_DATABASE_ROLE=reliacode_system
TENANT_DATABASE_ROLE=reliacode_tenant
PUBLIC_ORIGIN=https://reliacode.example
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_AUDIENCE=reliacode-api
OPEN_EPCIS_BASE_URL=https://epcis.example.com/
GS1_DIGITAL_LINK_BASE_URL=https://id.reliacode.example
WEBAUTHN_RP_ID=reliacode.example
# Metrics, Webhook encryption, and session fingerprint keys are mounted from
# deploy/secrets/*.txt and must never be stored in this environment file.
SESSION_ROTATION_MINUTES=15
PASSKEY_STEP_UP_MINUTES=10
EMAIL_FROM=ReliaCode <no-reply@reliacode.example>
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_REGION=cn-north-1
OBJECT_STORAGE_BUCKET=reliacode-production-exports
OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Required OpenTelemetry OTLP/HTTP trace exporter. Headers come from
# secrets/otel_exporter_headers.txt and the endpoint must use HTTPS.
OTEL_SERVICE_NAME=reliacode-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel.example.com/v1/traces
